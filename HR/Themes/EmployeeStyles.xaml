<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style x:Key="NeonIcon"
       TargetType="{x:Type materialDesign:PackIcon}">

        <Setter Property="Foreground"
            Value="#00E5D4"/>

        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                Color="#00E5D4"
                BlurRadius="18"
                ShadowDepth="0"
                Opacity="0.9"/>
            </Setter.Value>
        </Setter>

    </Style>
    <Style x:Key="NeonScrollBar"
       TargetType="{x:Type ScrollBar}">

        <!-- فضای ScrollBar -->
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type ScrollBar}">

                    <Grid>

                        <!-- Track نامرئی -->
                        <Track x:Name="PART_Track"
                           IsDirectionReversed="True">

                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                Command="ScrollBar.PageUpCommand"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"/>
                            </Track.DecreaseRepeatButton>

                            <Track.Thumb>

                                <Thumb x:Name="Thumb"
                                   Width="4"
                                   HorizontalAlignment="Center"
                                   Background="#00E5D4">

                                    <Thumb.Template>

                                        <ControlTemplate TargetType="{x:Type Thumb}">

                                            <Border x:Name="ThumbBorder"
                                                Width="4"
                                                HorizontalAlignment="Center"
                                                Background="#00E5D4"
                                                CornerRadius="2">

                                                <Border.Effect>
                                                    <DropShadowEffect
                                                    Color="#00E5D4"
                                                    BlurRadius="36"
                                                    ShadowDepth="0"
                                                    Opacity="0.9"/>
                                                </Border.Effect>

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <!-- Hover -->
                                                <Trigger Property="IsMouseOver"
                                                     Value="True">

                                                    <Setter TargetName="ThumbBorder"
                                                        Property="Background"
                                                        Value="#7FFFF5"/>

                                                    <Setter TargetName="ThumbBorder"
                                                        Property="Effect">

                                                        <Setter.Value>
                                                            <DropShadowEffect
                                                            Color="#00E5D4"
                                                            BlurRadius="56"
                                                            ShadowDepth="0"
                                                            Opacity="1"/>
                                                        </Setter.Value>

                                                    </Setter>

                                                </Trigger>

                                                <!-- Drag -->
                                                <Trigger Property="IsDragging"
                                                     Value="True">

                                                    <Setter TargetName="ThumbBorder"
                                                        Property="Background"
                                                        Value="#FFFFFF"/>

                                                    <Setter TargetName="ThumbBorder"
                                                        Property="Effect">

                                                        <Setter.Value>
                                                            <DropShadowEffect
                                                            Color="#00E5D4"
                                                            BlurRadius="64"
                                                            ShadowDepth="0"
                                                            Opacity="1"/>
                                                        </Setter.Value>

                                                    </Setter>

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Thumb.Template>

                                </Thumb>

                            </Track.Thumb>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                Command="ScrollBar.PageDownCommand"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"/>
                            </Track.IncreaseRepeatButton>

                        </Track>

                    </Grid>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>
    <Style x:Key="DarkOutlinedTextBox"
		TargetType="TextBox"
		BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">

	<Setter Property="Height" Value="45"/>
	<Setter Property="Margin" Value="10"/>
	<Setter Property="Padding" Value="10,2"/>
	<Setter Property="FontSize" Value="18"/>
	<Setter Property="Foreground" Value="White"/>
	<Setter Property="CaretBrush" Value="White"/>
	<Setter Property="BorderBrush" Value="#475569"/>

	<Setter Property="materialDesign:HintAssist.Foreground" Value="#FF00E5D4"/>
	<Setter Property="materialDesign:HintAssist.Background" Value="#0F172A"/>
	<Setter Property="materialDesign:HintAssist.FloatingScale" Value="1.0"/>
	<Setter Property="materialDesign:HintAssist.ApplyHintPaddingBrush" Value="False"/>
	<Setter Property="materialDesign:TextFieldAssist.HasFilledTextField" Value="False"/>
	<Setter Property="materialDesign:TextFieldAssist.HasOutlinedTextField" Value="False"/>

	<Style.Resources>
		<Style TargetType="{x:Type materialDesign:SmartHint}">
			<Setter Property="Foreground" Value="#FF00E5D4"/>
			<Setter Property="Background" Value="#0F172A"/>
			<Setter Property="Padding" Value="1,0"/>
			<Setter Property="Margin" Value="0"/>
		</Style>
	</Style.Resources>
</Style>
<Style x:Key="DarkOutlinedComboBox"
	TargetType="ComboBox"
	BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">

	<Setter Property="Height" Value="45"/>
	<Setter Property="Margin" Value="10"/>
	<Setter Property="Padding" Value="10,2"/>
	<Setter Property="FontSize" Value="16"/>
	<Setter Property="Foreground" Value="White"/>
	<Setter Property="BorderBrush" Value="#475569"/>
	<Setter Property="Background" Value="#0F172A"/>

	<Setter Property="materialDesign:HintAssist.Foreground" Value="#94A3B8"/>
	<Setter Property="materialDesign:HintAssist.Background" Value="#0F172A"/>
	<Setter Property="materialDesign:HintAssist.FloatingScale" Value="1.0"/>
	<Setter Property="materialDesign:HintAssist.ApplyHintPaddingBrush" Value="False"/>
	<Setter Property="materialDesign:TextFieldAssist.HasFilledTextField" Value="False"/>
	<Setter Property="materialDesign:TextFieldAssist.HasOutlinedTextField" Value="False"/>

	<Style.Resources>
		<Style TargetType="{x:Type materialDesign:SmartHint}">
			<Setter Property="Foreground" Value="#94A3B8"/>
			<Setter Property="Background" Value="#0F172A"/>
			<Setter Property="Padding" Value="1,0"/>
			<Setter Property="Margin" Value="0"/>
		</Style>
	</Style.Resources>
</Style>
<Style x:Key="DarkSegmentedListBoxItem"
	TargetType="ListBoxItem"
	BasedOn="{StaticResource MaterialDesignListBoxItem}">
	<Setter Property="Foreground" Value="White"/>
	<Setter Property="FontSize" Value="18"/>
	<Setter Property="Padding" Value="16,8"/>
	<Setter Property="HorizontalContentAlignment" Value="Center"/>
	<Setter Property="Background" Value="Transparent"/>
	<Setter Property="BorderBrush" Value="Transparent"/>
	<Setter Property="BorderThickness" Value="2"/>
	<Setter Property="Margin" Value="2"/>

	<!-- هاله هاور قرمز -->
	<Setter Property="materialDesign:ListBoxItemAssist.HoverBackground" Value="#33FF0000"/>

	<Style.Triggers>
		<!-- آیتم انتخاب‌شده: هاله زرد -->
		<Trigger Property="IsSelected" Value="True">
			<Setter Property="Background" Value="#33FBBF24"/>
			<Setter Property="BorderBrush" Value="#FBBF24"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="Foreground" Value="#FDE68A"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Trigger>

		<!-- هاور وقتی انتخاب نشده -->
		<MultiTrigger>
			<MultiTrigger.Conditions>
				<Condition Property="IsMouseOver" Value="True"/>
				<Condition Property="IsSelected" Value="False"/>
			</MultiTrigger.Conditions>
			<Setter Property="Background" Value="#33EF4444"/>
			<Setter Property="BorderBrush" Value="#EF4444"/>
			<Setter Property="BorderThickness" Value="2"/>
		</MultiTrigger>
	</Style.Triggers>
</Style>
<!-- استایل‌های کمکی تقویم -->
<Style x:Key="DarkCalendarDayButton"
	TargetType="CalendarDayButton"
	BasedOn="{StaticResource MaterialDesignCalendarDayButton}">
	<Setter Property="materialDesign:CalendarAssist.SelectionColor" Value="#3B82F6"/>
	<Setter Property="materialDesign:CalendarAssist.SelectionForegroundColor" Value="White"/>
</Style>
<Style x:Key="DarkCalendarButton"
	TargetType="CalendarButton"
	BasedOn="{StaticResource MaterialDesignCalendarButton}">
	<Setter Property="materialDesign:CalendarAssist.SelectionColor" Value="#3B82F6"/>
	<Setter Property="materialDesign:CalendarAssist.SelectionForegroundColor" Value="White"/>
</Style>
<Style x:Key="DarkCalendar"
	TargetType="Calendar"
	BasedOn="{StaticResource MaterialDesignDatePickerCalendarPortrait}">
	<Setter Property="Background" Value="#0F172A"/>
	<Setter Property="Foreground" Value="White"/>
	<Setter Property="CalendarButtonStyle" Value="{StaticResource DarkCalendarButton}"/>
	<Setter Property="CalendarDayButtonStyle" Value="{StaticResource DarkCalendarDayButton}"/>
	<Setter Property="materialDesign:CalendarAssist.HeaderBackground" Value="#1E293B"/>
	<Setter Property="materialDesign:CalendarAssist.HeaderForeground" Value="White"/>
</Style>
<!-- استایل اصلی DatePicker -->
<Style x:Key="DarkOutlinedDatePicker"
	TargetType="DatePicker"
	BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">

	<Setter Property="Height" Value="45"/>
	<Setter Property="Margin" Value="10"/>
	<Setter Property="Padding" Value="8,0"/>
	<Setter Property="FontSize" Value="18"/>
	<Setter Property="Foreground" Value="White"/>
	<Setter Property="BorderBrush" Value="#475569"/>
	<Setter Property="Background" Value="#0F172A"/>
	<Setter Property="FlowDirection" Value="RightToLeft"/>
	<Setter Property="Language" Value="fa-IR"/>
	<Setter Property="CalendarStyle" Value="{StaticResource DarkCalendar}"/>

	<Setter Property="materialDesign:HintAssist.Foreground" Value="#94A3B8"/>
	<Setter Property="materialDesign:HintAssist.Background" Value="#0F172A"/>
	<Setter Property="materialDesign:HintAssist.FloatingScale" Value="1.0"/>
	<Setter Property="materialDesign:HintAssist.ApplyHintPaddingBrush" Value="False"/>
	<Setter Property="materialDesign:TextFieldAssist.HasFilledTextField" Value="False"/>
	<Setter Property="materialDesign:TextFieldAssist.HasOutlinedTextField" Value="False"/>

	<Style.Resources>
		<Style TargetType="{x:Type materialDesign:SmartHint}">
			<Setter Property="Foreground" Value="#94A3B8"/>
			<Setter Property="Background" Value="#0F172A"/>
			<Setter Property="Padding" Value="1,0"/>
			<Setter Property="Margin" Value="0"/>
		</Style>
	</Style.Resources>
</Style>
<!-- ========== ListView تیره ========== -->
<Style x:Key="DarkListView" TargetType="ListView">
	<Setter Property="Background" Value="#111827"/>
	<Setter Property="BorderBrush" Value="#00a693"/>
	<Setter Property="BorderThickness" Value="0"/>
	<Setter Property="Foreground" Value="White"/>
	<Setter Property="FontSize" Value="13"/>
	<Setter Property="Padding" Value="0"/>
	<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
	<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
	<Setter Property="AlternationCount" Value="0"/>
	<Setter Property="SnapsToDevicePixels" Value="True"/>
	<Setter Property="ItemContainerStyle">
		<Setter.Value>
			<Style TargetType="ListViewItem">
				<Setter Property="Foreground" Value="White"/>
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
				<Setter Property="Padding" Value="8,6"/>
				<Setter Property="Margin" Value="0"/>
				<Setter Property="SnapsToDevicePixels" Value="True"/>
				<Style.Triggers>
					<!-- ردیف زوج -->
					<Trigger Property="ItemsControl.AlternationIndex" Value="1">
						<Setter Property="Background" Value="#161F2E"/>
					</Trigger>
					<!-- هاور -->
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Background" Value="#1E293B"/>
					</Trigger>
					<!-- انتخاب‌شده -->
					<Trigger Property="IsSelected" Value="True">
						<Setter Property="Background" Value="#1E3A5F"/>
						<Setter Property="Foreground" Value="White"/>
					</Trigger>
				</Style.Triggers>
			</Style>
		</Setter.Value>
	</Setter>
</Style>

<!-- هدر ستون‌ها -->
<Style x:Key="DarkGridViewColumnHeader" TargetType="GridViewColumnHeader">
	<Setter Property="Background" Value="#061525"/>
	<Setter Property="Foreground" Value="White"/>
	<Setter Property="FontWeight" Value="SemiBold"/>
	<Setter Property="FontSize" Value="12"/>
	<Setter Property="Padding" Value="10,10"/>
	<Setter Property="BorderBrush" Value="#1E293B"/>
	<Setter Property="BorderThickness" Value="0,0,1,1"/>
	<Setter Property="HorizontalContentAlignment" Value="Center"/>
	<Setter Property="Template">
		<Setter.Value>
			<ControlTemplate TargetType="GridViewColumnHeader">
				<Border  Background="{TemplateBinding Background}"
				BorderBrush="#38BDF8"
				BorderThickness="0,1,0,1"
				Padding="{TemplateBinding Padding}">
					<ContentPresenter HorizontalAlignment="Center"
							  VerticalAlignment="Center"/>
				</Border>
			</ControlTemplate>
		</Setter.Value>
	</Setter>
	<Style.Triggers>
		<Trigger Property="IsMouseOver" Value="True">
			<Setter Property="Background" Value="#1E293B"/>
			<Setter Property="Foreground" Value="White"/>
		</Trigger>
	</Style.Triggers>
</Style>
</ResourceDictionary>