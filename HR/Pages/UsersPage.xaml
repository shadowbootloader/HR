<Page x:Class="HR.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0B1120"
      FlowDirection="RightToLeft"
      FontFamily="pack://application:,,,/Fonts/#B Nazanin"
      Foreground="White">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="کاربران" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
            <ListBox x:Name="UserList" DisplayMemberPath="Label" Background="#111827" Foreground="White"
                     BorderBrush="#334155" SelectionChanged="UserList_SelectionChanged"/>
        </DockPanel>

        <StackPanel Grid.Column="1" MaxWidth="460" HorizontalAlignment="Right">
            <TextBlock x:Name="FormTitle" Text="کاربر جدید" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
            <TextBlock Text="نام کاربری"/>
            <TextBox x:Name="UsernameBox" Height="36" Margin="0,4,0,10" Background="#1E293B" Foreground="White"/>
            <TextBlock Text="نام نمایشی"/>
            <TextBox x:Name="DisplayNameBox" Height="36" Margin="0,4,0,10" Background="#1E293B" Foreground="White"/>
            <TextBlock Text="رمز عبور"/>
            <PasswordBox x:Name="PasswordBox" Height="36" Margin="0,4,0,10" Background="#1E293B" Foreground="White"/>
            <TextBlock Text="نقش"/>
            <ComboBox x:Name="RoleBox" Height="36" Margin="0,4,0,10" SelectedIndex="2">
                <ComboBoxItem Content="مدیر" Tag="Admin"/>
                <ComboBoxItem Content="منابع انسانی" Tag="HR"/>
                <ComboBoxItem Content="بیننده" Tag="Viewer"/>
            </ComboBox>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="ایجاد" Height="36" Padding="16,0" Margin="0,0,8,0" Click="Create_Click" Background="#3B82F6" Foreground="White" BorderThickness="0"/>
                <Button Content="ذخیره نقش" Height="36" Padding="16,0" Margin="0,0,8,0" Click="SaveRole_Click" Background="#1E293B" Foreground="White" BorderThickness="0"/>
                <Button Content="بازنشانی رمز" Height="36" Padding="16,0" Margin="0,0,8,0" Click="Reset_Click" Background="#1E293B" Foreground="White" BorderThickness="0"/>
                <Button x:Name="ActiveButton" Content="غیرفعال‌سازی" Height="36" Padding="16,0" Click="ToggleActive_Click" Background="#7F1D1D" Foreground="White" BorderThickness="0"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#93C5FD"/>
        </StackPanel>
    </Grid>
</Page>
