<Page x:Class="HR.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#0B1120"
      FlowDirection="RightToLeft"
      FontFamily="pack://application:,,,/Fonts/#B Nazanin"
      Foreground="White">
    <Page.Resources>
        <!-- هدر ستون‌ها -->
        <Style x:Key="UserColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0B1428"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#00E5D4"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ردیف‌ها: فشرده، با هاور و انتخاب نئونی -->
        <Style x:Key="UserRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#1E293B"
                                BorderThickness="0,0,0,1">
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#12203A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#0E2A3A"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#00E5D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UserCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- دکمه‌های کوچک عملیات داخل ردیف -->
        <Style x:Key="RowActionButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#16233A"/>
            <Setter Property="Foreground" Value="#00E5D4"/>
            <Setter Property="BorderBrush" Value="#00E5D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#1D3350"/>
                                <Setter TargetName="Box" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00E5D4" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowDeleteButton" TargetType="Button" BasedOn="{StaticResource RowActionButton}">
            <Setter Property="Foreground" Value="#FF3C91"/>
            <Setter Property="BorderBrush" Value="#FF3C91"/>
        </Style>

        <!-- دکمه‌های اصلی فرم -->
        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#00E5D4"/>
            <Setter Property="Background" Value="#0F1F33"/>
            <Setter Property="BorderBrush" Value="#00E5D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00E5D4" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonPrimaryButton" TargetType="Button" BasedOn="{StaticResource NeonButton}">
            <Setter Property="Background" Value="#00E5D4"/>
            <Setter Property="Foreground" Value="#06121F"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="NeonDangerButton" TargetType="Button" BasedOn="{StaticResource NeonButton}">
            <Setter Property="Foreground" Value="#FF3C91"/>
            <Setter Property="BorderBrush" Value="#FF3C91"/>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ========== جدول کاربران ========== -->
        <Border Grid.Column="0" Background="#0F172A" CornerRadius="14" BorderBrush="#1E293B" BorderThickness="1" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ستون اول در حالت راست‌به‌چپ سمت راست است: عنوان و تعداد راست، جستجو چپ -->
                <Grid Grid.Row="0" Margin="16,14,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountMultiple" Width="26" Height="26"
                                                 Style="{StaticResource NeonIcon}" VerticalAlignment="Center" Margin="0,0,0,0"/>
                        <TextBlock Text="کاربران سامانه" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <Border Margin="16,0,0,0" Padding="12,3" CornerRadius="10"
                                Background="#0C2A33" BorderBrush="#00E5D4" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock x:Name="CountText" Text="۰" Foreground="#00E5D4" FontSize="13"/>
                        </Border>
                    </StackPanel>
                    <TextBox x:Name="SearchBox" Grid.Column="2" Width="260" Height="36"
                             VerticalContentAlignment="Center" Padding="10,0" FontSize="14"
                             Background="#0B1428" Foreground="White" CaretBrush="#00E5D4"
                             BorderBrush="#334155" BorderThickness="1"
                             ToolTip="جستجو در کاربران"
                             TextChanged="SearchBox_TextChanged"/>
                </Grid>

                <DataGrid x:Name="UserGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" Foreground="White" BorderThickness="0"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          RowStyle="{StaticResource UserRowStyle}"
                          CellStyle="{StaticResource UserCellStyle}"
                          ColumnHeaderStyle="{StaticResource UserColumnHeader}"
                          CanUserAddRows="False" CanUserResizeRows="False" SelectionMode="Single"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          SelectionChanged="UserGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="کاربر" Width="*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="15" Background="#0C2A33"
                                                BorderBrush="#00E5D4" BorderThickness="1" Margin="0,0,0,0">
                                            <TextBlock Text="{Binding Initial}" Foreground="#00E5D4" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="{Binding Username}" FontSize="11" Foreground="#64748B" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="نقش" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding RoleBackground}" BorderBrush="{Binding RoleColor}" BorderThickness="1"
                                            CornerRadius="10" Padding="10,2" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding RoleLabel}" Foreground="{Binding RoleColor}" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="کارمند مرتبط" Binding="{Binding EmployeeName}" Width="160" MinWidth="130"/>

                        <DataGridTemplateColumn Header="وضعیت" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StateBackground}" BorderBrush="{Binding StateColor}" BorderThickness="1"
                                            CornerRadius="10" Padding="10,2" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding State}" Foreground="{Binding StateColor}" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="آخرین ورود" Binding="{Binding LastLogin}" Width="140"/>

                        <DataGridTemplateColumn Header="عملیات" Width="100" MinWidth="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource RowActionButton}" ToolTip="ویرایش" Click="EditRow_Click">
                                            <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource RowDeleteButton}" ToolTip="حذف" Click="DeleteRow_Click">
                                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ========== فرم کاربر ========== -->
        <Border Grid.Column="1" Background="#0F172A" CornerRadius="14" BorderBrush="#1E293B" BorderThickness="1" Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="FormTitle" Text="کاربر جدید" FontSize="18" FontWeight="Bold" Foreground="#00E5D4" Margin="0,0,0,14"/>

                <TextBlock Text="نام کاربری" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="UsernameBox" Height="36" Margin="0,0,0,10" Padding="8,0" VerticalContentAlignment="Center"
                         Background="#0B1428" Foreground="White" CaretBrush="#00E5D4" BorderBrush="#334155" FlowDirection="LeftToRight"/>

                <TextBlock Text="نام نمایشی" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="DisplayNameBox" Height="36" Margin="0,0,0,10" Padding="8,0" VerticalContentAlignment="Center"
                         Background="#0B1428" Foreground="White" CaretBrush="#00E5D4" BorderBrush="#334155"/>

                <TextBlock x:Name="PasswordLabel" Text="رمز عبور" Style="{StaticResource FormLabel}"/>
                <PasswordBox x:Name="PasswordBox" Height="36" Margin="0,0,0,10" Padding="8,0" VerticalContentAlignment="Center"
                             Background="#0B1428" Foreground="White" CaretBrush="#00E5D4" BorderBrush="#334155" FlowDirection="LeftToRight"/>

                <TextBlock Text="نقش" Style="{StaticResource FormLabel}"/>
                <ComboBox x:Name="RoleBox" Height="36" Margin="0,0,0,16" SelectedIndex="2" FlowDirection="RightToLeft"
                          Background="#0B1428" Foreground="White" BorderBrush="#334155">
                    <ComboBoxItem Content="مدیر" Tag="Admin"/>
                    <ComboBoxItem Content="منابع انسانی" Tag="HR"/>
                    <ComboBoxItem Content="بیننده" Tag="Viewer"/>
                </ComboBox>

                <Button x:Name="CreateButton" Content="ایجاد کاربر" Style="{StaticResource NeonPrimaryButton}" Click="Create_Click"/>
                <Button x:Name="SaveButton" Content="ذخیره تغییرات" Style="{StaticResource NeonButton}" Click="SaveChanges_Click"/>
                <Button x:Name="ResetButton" Content="بازنشانی رمز" Style="{StaticResource NeonButton}" Click="Reset_Click"/>
                <Button x:Name="ActiveButton" Content="غیرفعال‌سازی" Style="{StaticResource NeonDangerButton}" Click="ToggleActive_Click"/>
                <Button x:Name="NewButton" Content="کاربر جدید" Style="{StaticResource NeonButton}" Click="New_Click"/>

                <TextBlock x:Name="StatusText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#93C5FD" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
