<Window x:Class="HR.Pages.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ورود به سامانه"
        Height="520" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#0B1120"
        FontFamily="pack://application:,,,/Fonts/#B Nazanin"
        Foreground="White">
    <Grid Margin="28">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="سامانه منابع انسانی" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="SubtitleText" Text="ورود" FontSize="16" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,22"/>

            <TextBlock Text="نام کاربری" Margin="0,0,0,6"/>
            <TextBox x:Name="UsernameBox" Height="40" Padding="10,6" Background="#1E293B" Foreground="White" BorderBrush="#334155"/>

            <TextBlock x:Name="DisplayNameLabel" Text="نام نمایشی" Margin="0,14,0,6" Visibility="Collapsed"/>
            <TextBox x:Name="DisplayNameBox" Height="40" Padding="10,6" Background="#1E293B" Foreground="White" BorderBrush="#334155" Visibility="Collapsed"/>

            <TextBlock Text="رمز عبور" Margin="0,14,0,6"/>
            <PasswordBox x:Name="PasswordBox" Height="40" Padding="10,6" Background="#1E293B" Foreground="White" BorderBrush="#334155"/>

            <TextBlock x:Name="ConfirmLabel" Text="تکرار رمز عبور" Margin="0,14,0,6" Visibility="Collapsed"/>
            <PasswordBox x:Name="ConfirmBox" Height="40" Padding="10,6" Background="#1E293B" Foreground="White" BorderBrush="#334155" Visibility="Collapsed"/>

            <TextBlock x:Name="ErrorText" Foreground="#FB7185" TextWrapping="Wrap" Margin="0,12,0,0"/>

            <Button x:Name="SubmitButton" Content="ورود" Height="42" Margin="0,18,0,0"
                    Background="#3B82F6" Foreground="White" BorderThickness="0" FontSize="18" FontWeight="Bold"
                    Click="SubmitButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
