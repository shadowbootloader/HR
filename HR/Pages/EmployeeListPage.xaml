<Page x:Class="HR.Pages.EmployeeListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:gif="http://wpfanimatedgif.codeplex.com" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      FontFamily="pack://application:,,,/Fonts/#B Nazanin"       
      xmlns:uc="clr-namespace:HR.Controls">
    <Page.Resources>
        <Storyboard x:Key="PeopleStoryboard">

            <!-- Person 1 -->
            <DoubleAnimationUsingKeyFrames
        Storyboard.TargetName="Person1Scale"
        Storyboard.TargetProperty="ScaleX">
                <SplineDoubleKeyFrame
            KeyTime="0:0:0"
            Value="0"/>
                <SplineDoubleKeyFrame
            KeyTime="0:0:0.3"
            Value="1"
            KeySpline="0.74,1 0.26,0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames
        Storyboard.TargetName="Person1Scale"
        Storyboard.TargetProperty="ScaleY">
                <SplineDoubleKeyFrame
            KeyTime="0:0:0"
            Value="0"/>
                <SplineDoubleKeyFrame
            KeyTime="0:0:0.3"
            Value="1"
            KeySpline="0.74,1 0.26,0"/>
            </DoubleAnimationUsingKeyFrames>


            <!-- Person 2 -->
            <DoubleAnimationUsingKeyFrames
        Storyboard.TargetName="Person2Scale"
        Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.15" Value="0"/>
                <SplineDoubleKeyFrame
            KeyTime="0:0:0.45"
            Value="1"
            KeySpline="0.74,1 0.26,0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames
        Storyboard.TargetName="Person2Scale"
        Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.15" Value="0"/>
                <SplineDoubleKeyFrame
            KeyTime="0:0:0.45"
            Value="1"
            KeySpline="0.74,1 0.26,0"/>
            </DoubleAnimationUsingKeyFrames>


            <!-- Person 3 -->
            <DoubleAnimationUsingKeyFrames
        Storyboard.TargetName="Person3Scale"
        Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.3" Value="0"/>
                <SplineDoubleKeyFrame
            KeyTime="0:0:0.6"
            Value="1"
            KeySpline="0.74,1 0.26,0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames
        Storyboard.TargetName="Person3Scale"
        Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.3" Value="0"/>
                <SplineDoubleKeyFrame
            KeyTime="0:0:0.6"
            Value="1"
            KeySpline="0.74,1 0.26,0"/>
            </DoubleAnimationUsingKeyFrames>


            <!-- Person 4 -->
            <DoubleAnimationUsingKeyFrames
        Storyboard.TargetName="Person4Scale"
        Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.15" Value="0"/>
                <SplineDoubleKeyFrame
            KeyTime="0:0:0.45"
            Value="1"
            KeySpline="0.74,1 0.26,0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames
        Storyboard.TargetName="Person4Scale"
        Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.15" Value="0"/>
                <SplineDoubleKeyFrame
            KeyTime="0:0:0.45"
            Value="1"
            KeySpline="0.74,1 0.26,0"/>
            </DoubleAnimationUsingKeyFrames>


            <!-- Person 5 -->
            <DoubleAnimationUsingKeyFrames
        Storyboard.TargetName="Person5Scale"
        Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.3" Value="0"/>
                <SplineDoubleKeyFrame
            KeyTime="0:0:0.6"
            Value="1"
            KeySpline="0.74,1 0.26,0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames
        Storyboard.TargetName="Person5Scale"
        Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.3" Value="0"/>
                <SplineDoubleKeyFrame
            KeyTime="0:0:0.6"
            Value="1"
            KeySpline="0.74,1 0.26,0"/>
            </DoubleAnimationUsingKeyFrames>


            <!-- Small top object -->
            <DoubleAnimationUsingKeyFrames
        Storyboard.TargetName="Person6Scale"
        Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.45" Value="0"/>
                <SplineDoubleKeyFrame
            KeyTime="0:0:0.6"
            Value="1"
            KeySpline="0.74,1 0.26,0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames
        Storyboard.TargetName="Person6Scale"
        Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.45" Value="0"/>
                <SplineDoubleKeyFrame
            KeyTime="0:0:0.6"
            Value="1"
            KeySpline="0.74,1 0.26,0"/>
            </DoubleAnimationUsingKeyFrames>

        </Storyboard>
        <Storyboard x:Key="ShiningStarsStoryboard" RepeatBehavior="Forever">

            <!-- ستاره 1 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VectorScale" Storyboard.TargetProperty="ScaleX">
                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.53" Value="1.1" KeySpline="0.67,0 0.33,1"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VectorScale" Storyboard.TargetProperty="ScaleY">
                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.53" Value="1.3" KeySpline="0.67,0 0.33,1"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- ستاره 2 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Vector2Scale" Storyboard.TargetProperty="ScaleX">
                <SplineDoubleKeyFrame KeyTime="0:0:0.16" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.38" Value="1.15" KeySpline="0.67,0 0.33,1"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Vector2Scale" Storyboard.TargetProperty="ScaleY">
                <SplineDoubleKeyFrame KeyTime="0:0:0.16" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.38" Value="1.15" KeySpline="0.67,0 0.33,1"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="1"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- ستاره 3 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Vector3Scale" Storyboard.TargetProperty="ScaleX">
                <SplineDoubleKeyFrame KeyTime="0:0:0.31" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.56" Value="1.1" KeySpline="0.67,0 0.33,1"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.73" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Vector3Scale" Storyboard.TargetProperty="ScaleY">
                <SplineDoubleKeyFrame KeyTime="0:0:0.31" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.56" Value="1.1" KeySpline="0.67,0 0.33,1"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.73" Value="1"/>
            </DoubleAnimationUsingKeyFrames>

        </Storyboard>
    </Page.Resources>

    <Grid Background="#0B1120" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="270"/>
        </Grid.ColumnDefinitions>

        <!-- جدول کارمندان -->
        <Border Grid.Column="0" FlowDirection="RightToLeft" Background="#0F172A" CornerRadius="14" Margin="0,0,16,0">
            <DockPanel LastChildFill="True">
                <!-- ========== نوار جستجو ========== -->
                <Border DockPanel.Dock="Top"
                Padding="12,10"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <!-- جستجو -->
                        <Border Background="#111827"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="4,0">
                            <DockPanel>
                                <materialDesign:PackIcon DockPanel.Dock="Right"
                                                 Kind="Magnify"
                                                 Width="20" Height="20"
                                                 Foreground="#64748B"
                                                 VerticalAlignment="Center"
                                                 Margin="8,0,4,0"/>
                                <TextBox x:Name="SearchBox"
                                 Height="36"
                                 FontSize="14"
                                 Foreground="White"
                                 CaretBrush="White"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0"
                                 materialDesign:HintAssist.Hint="جستجو بر اساس نام، سمت یا دپارتمان..."
                                 materialDesign:HintAssist.Foreground="#64748B"
                                 TextChanged="SearchBox_TextChanged"/>
                            </DockPanel>
                        </Border>

                        <!-- فیلتر وضعیت (اختیاری) -->
                        <ComboBox Grid.Column="2"
                          x:Name="StatusFilterCombo"
                          Height="36"
                          FontSize="14"
                          Foreground="White"
                          materialDesign:HintAssist.Hint="وضعیت"
                          Style="{StaticResource DarkOutlinedComboBox}"
                          SelectionChanged="StatusFilterCombo_SelectionChanged">
                            <ComboBoxItem Content="همه" IsSelected="True"/>
                            <ComboBoxItem Content="فعال"/>
                            <ComboBoxItem Content="مرخصی"/>
                            <ComboBoxItem Content="غیرفعال"/>
                        </ComboBox>
                    </Grid>
                </Border>
                <!-- هدر ستون‌ها -->
                <Border DockPanel.Dock="Top" Padding="12,14" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="16" Grid.Column="0" Text="تصویر" Foreground="White" />
                        <TextBlock FontSize="16" Grid.Column="1"  Text="نام" Foreground="White"  Margin="10,0,0,0"/>
                        <TextBlock FontSize="16" Grid.Column="2" Margin="10,0,0,0" Text="جایگاه شغلی" Foreground="White" />
                        <TextBlock FontSize="16" Grid.Column="3" Margin="10,0,0,0" Text="دپارتمان" Foreground="White" />
                        <TextBlock FontSize="16" Grid.Column="4" HorizontalAlignment="Center" Margin="0,0,0,0" Text="وضعیت" Foreground="White" />
                        <TextBlock FontSize="16" Grid.Column="5" HorizontalAlignment="Center" Margin="0,0,0,0" Text="بهره‌وری" Foreground="White" />
                        <TextBlock FontSize="16" Grid.Column="6" Margin="10,0,0,0" Text="عملیات" Foreground="White"  HorizontalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border DockPanel.Dock="Bottom" Padding="5" BorderBrush="#1E293B" VerticalAlignment="Bottom" BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock Text="{Binding PaginationText}" 
           Foreground="White" 
           FontSize="16" 
           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        <StackPanel VerticalAlignment="Top" Orientation="Horizontal" HorizontalAlignment="Left">
                            <StackPanel x:Name="PaginationPanel"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">

                                <!-- دکمه قبلی -->
                                <Button x:Name="BtnPrevious" Padding="0"
            Content="‹"
            Width="34" Height="34"
            Margin="0,0,4,0"
            FontSize="18"
            Foreground="White"
            Background="#22FFFFFF"
            BorderThickness="0"
            Cursor="Hand"
            Click="BtnPrevious_Click"/>

                                <!-- صفحه فعلی -->
                                <Button x:Name="BtnCurrent" Padding="0"
            Content="1"
            Width="34" Height="34"
            Margin="0,0,4,0"
            FontWeight="SemiBold"
            Foreground="White"
            Background="#3F8CFF"
            BorderThickness="0"
            Cursor="Hand"
            Click="PageButton_Click"/>

                                <!-- صفحه بعدی ۱ -->
                                <Button x:Name="BtnPage2" Padding="0"
            Content="2"
            Width="34" Height="34"
            Margin="0,0,4,0"
            Foreground="White"
            Background="#22FFFFFF"
            BorderThickness="0"
            Cursor="Hand"
            Click="PageButton_Click"/>

                                <!-- صفحه بعدی ۲ -->
                                <Button x:Name="BtnPage3" Padding="0"
            Content="3"
            Width="34" Height="34"
            Margin="0,0,4,0"
            Foreground="White"
            Background="#22FFFFFF"
            BorderThickness="0"
            Cursor="Hand"
            Click="PageButton_Click"/>

                                <!-- نقطه‌چین -->
                                <TextBlock x:Name="TxtDots" Padding="0"
               Text="…"
               FontSize="18"
               Foreground="#AAFFFFFF"
               VerticalAlignment="Center"
               Margin="2,0,6,2"/>

                                <!-- آخرین صفحه -->
                                <Button x:Name="BtnLast" Padding="0"
            Content="10"
            Width="34" Height="34"
            Margin="0,0,4,0"
            Foreground="White"
            Background="#22FFFFFF"
            BorderThickness="0"
            Cursor="Hand"
            Click="PageButton_Click"/>

                                <!-- دکمه بعدی -->
                                <Button x:Name="BtnNext" Padding="0"
            Content="›"
            Width="34" Height="34"
            FontSize="18"
            Foreground="White"
            Background="#22FFFFFF"
            BorderThickness="0"
            Cursor="Hand"
            Click="BtnNext_Click"/>

                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- لیست ردیف‌ها -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" FlowDirection="RightToLeft" materialDesign:ScrollViewerAssist.IsAutoHideEnabled="True"  MinHeight="200" DockPanel.Dock="Top" Margin="0,0,0,5">
                    <ScrollViewer.Resources>

                        <Style TargetType="ScrollBar"
       BasedOn="{StaticResource NeonScrollBar}"/>

                    </ScrollViewer.Resources>
                    <ItemsControl x:Name="EmployeeItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <uc:EmployeeRowControl/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- صفحه‌بندی -->
            </DockPanel>
        </Border>

        <!-- کارت‌های خلاصه سمت راست -->
        <StackPanel Grid.Column="1">
            <Button x:Name="BtnAddEmployee" 
        materialDesign:ButtonAssist.CornerRadius="10"
        Background="#3B82F6"
        BorderThickness="0"
        Foreground="White"
        Height="42"
        Click="BtnAddEmployee_Click"
        Margin="10,0,10,5"
        Padding="18,0"
        Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="AddEmployeeBtn"
                    Background="{TemplateBinding Background}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AddEmployeeBtn" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="AddEmployeeBtn" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="کارمند جدید" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <uc:SummaryCardControl  Title="تعداد کل"  FontFamily="pack://application:,,,/Fonts/#B Nazanin" SubTextColor="White" Value="{Binding TotalCount}" SubText="85.5% از نیرو ها"  IconBackground="CornflowerBlue"  Margin="0,0,0,14" Loaded="SummaryCardControl_Loaded"  >
                <uc:SummaryCardControl.IconContent>
                    <Image gif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/people.gif"

       Stretch="Uniform"/>
                </uc:SummaryCardControl.IconContent>
            </uc:SummaryCardControl>
            <uc:SummaryCardControl Title="فعال"  FontFamily="pack://application:,,,/Fonts/#B Nazanin" SubTextColor="White" SubText="85.5% از نیرو ها"  IconBackground="DarkGreen"  Margin="0,0,0,14">
                <uc:SummaryCardControl.IconContent>
                    <Grid Width="70" Height="50" ClipToBounds="True" Background="Transparent">
                        <Path 
          Stroke="#6FFFCB"
          StrokeThickness="4"
          Stretch="Fill"
          StrokeStartLineCap="Round"
          StrokeEndLineCap="Round"
          StrokeLineJoin="Round"
          Data="M0,30 L20,30 L28,10 L40,50 L52,20 L60,30 L100,30"
          StrokeDashArray="120 120"
          StrokeDashOffset="120">

                            <Path.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                            Storyboard.TargetProperty="StrokeDashOffset"
                            From="120"
                            To="0"
                            Duration="0:0:3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                    </Grid>

                </uc:SummaryCardControl.IconContent>

            </uc:SummaryCardControl>
            <uc:SummaryCardControl Title="افراد جدید" FontFamily="pack://application:,,,/Fonts/#B Nazanin" SubTextColor="White" SubText="افزایش 20%"  IconBackground="Purple"  Margin="0,0,0,5" >
                <uc:SummaryCardControl.IconContent>
                    <uc:ShiningStarsControl/>
                </uc:SummaryCardControl.IconContent>
            </uc:SummaryCardControl>
        </StackPanel>
    </Grid>
</Page>