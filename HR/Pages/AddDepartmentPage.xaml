<Page x:Class="HR.Pages.AddDepartmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#0B1120"
      FlowDirection="RightToLeft"
      FontFamily="pack://application:,,,/Fonts/#B Nazanin">
    <Page.Resources>
        <Style x:Key="BlueNeonIcon"
   TargetType="{x:Type materialDesign:PackIcon}">

            <Setter Property="Foreground"
        Value="#7DD3FC"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
            Color="#7DD3FC"
            BlurRadius="18"
            ShadowDepth="0"
            Opacity="0.9"/>
                </Setter.Value>
            </Setter>

        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel  HorizontalAlignment="Stretch">

            <!-- عنوان -->
            

            <!-- کارت اصلی -->
            <Border Background="#0F172A" CornerRadius="16" Padding="22"
                    BorderBrush="#1E293B" BorderThickness="1">
                <StackPanel>

                    <!-- اطلاعات پایه + لوگو -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0">
                            <TextBox x:Name="DepartmentnameTB" Style="{StaticResource DarkOutlinedTextBox}" Width="220"
                                     materialDesign:HintAssist.Hint="نام دپارتمان"
                                      >
                                <TextBox.Text>
                                    <Binding
                                        Path="Name"
                                        UpdateSourceTrigger="PropertyChanged"
                                        ValidatesOnDataErrors="True"
                                        ValidatesOnExceptions="True"
                                        NotifyOnValidationError="True"/>
                                </TextBox.Text>
                            </TextBox>
                            <TextBox x:Name="DepartMentID"  IsEnabled="False" Style="{StaticResource DarkOutlinedTextBox}" Width="140"
                                     materialDesign:HintAssist.Hint="کد دپارتمان"/>
                            <ComboBox x:Name="DepartmentStatusCB"  Style="{StaticResource DarkOutlinedComboBox}" Width="150"
                                      materialDesign:HintAssist.Hint="وضعیت">
                                <ComboBoxItem Content="فعال"/>
                                <ComboBoxItem Content="غیرفعال"/>
                            </ComboBox>
                            <ComboBox x:Name="DepartmentHFStatusCB"  Style="{StaticResource DarkOutlinedComboBox}" Width="150"
                                      materialDesign:HintAssist.Hint="رده حفاظتی">
                                <ComboBoxItem Content="فعال"/>
                                <ComboBoxItem Content="غیرفعال"/>
                            </ComboBox>
                            <ComboBox x:Name="ParentDepartmentCB"  Style="{StaticResource DarkOutlinedComboBox}" Width="200"
                                      materialDesign:HintAssist.Hint="دپارتمان والد"/>
                            <DatePicker x:Name="StartDateDP"  Style="{StaticResource DarkOutlinedDatePicker}" Width="160"
                                        materialDesign:HintAssist.Hint="تاریخ تأسیس"/>
                            <TextBox x:Name="MaxPersonalCountTB"  Style="{StaticResource DarkOutlinedTextBox}" Width="120"
                                     materialDesign:HintAssist.Hint="ظرفیت مصوب"/>
                        </WrapPanel>

                        <!-- لوگو -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Border Width="96" Height="96" CornerRadius="16" Background="#1E293B"
                                    BorderBrush="#334155" BorderThickness="1">
                                <Grid>
                                    <materialDesign:PackIcon Kind="ImageOutline" Width="36" Height="36"
                                                             Foreground="#475569"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="LogoImage" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <Button Content="انتخاب لوگو" Margin="0,10,0,0" Height="34"
                                    Background="#3B82F6" Foreground="White" BorderThickness="0"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    Click="Button_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- خط جدا -->
                    <Rectangle Height="1" Margin="20,22" HorizontalAlignment="Stretch">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#00E5D4" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- افراد کلیدی -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="AccountTie" Width="22" Height="22" Style="{StaticResource BlueNeonIcon}"
                                                 Foreground="#7DD3FC" VerticalAlignment="Center"/>
                        <TextBlock Text="افراد کلیدی" FontSize="16" FontWeight="SemiBold"
                                   Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <WrapPanel>
                        <ComboBox x:Name="DepertmentManagerCB"  Style="{StaticResource DarkOutlinedComboBox}" Width="220"
                                  materialDesign:HintAssist.Hint="مدیر دپارتمان *"/>
                        <ComboBox x:Name="DepartmentDeputyCB"  Style="{StaticResource DarkOutlinedComboBox}" Width="220"
                                  materialDesign:HintAssist.Hint="جانشین مدیر"/>
                        <ComboBox x:Name="DepartmentCashCustodian" Style="{StaticResource DarkOutlinedComboBox}" Width="220"
                                  materialDesign:HintAssist.Hint="تنخواه‌دار"/>
                    </WrapPanel>

                    <!-- خط جدا -->
                    <Rectangle Height="1" Margin="20,22" HorizontalAlignment="Stretch">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#00E5D4" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- مالی و تماس -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="Cash" Width="22" Height="22" Style="{StaticResource BlueNeonIcon}"
                                                 Foreground="#7DD3FC" VerticalAlignment="Center"/>
                        <TextBlock Text="مالی و تماس" FontSize="16" FontWeight="SemiBold"
                                   Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <WrapPanel>
                        <TextBox x:Name="AccountingCode"  Style="{StaticResource DarkOutlinedTextBox}" Width="180"
                                 materialDesign:HintAssist.Hint="مرکز هزینه"/>
                        <TextBox x:Name="AnnualBudget" materialDesign:TextFieldAssist.SuffixText="ریال" materialDesign:TextFieldAssist.SuffixTextVisibility="Always"   Style="{StaticResource DarkOutlinedTextBox}" Width="220"
                                 materialDesign:HintAssist.Hint="بودجه سالانه" TextChanged="MoneyTextBox_TextChanged"/>
                        <TextBox x:Name="PettyCashLimit" materialDesign:TextFieldAssist.SuffixText="ریال" materialDesign:TextFieldAssist.SuffixTextVisibility="Always" Style="{StaticResource DarkOutlinedTextBox}" Width="220"
                                 materialDesign:HintAssist.Hint="سقف تنخواه" TextChanged="MoneyTextBox_TextChanged"/>
                        
                    </WrapPanel>

                    <!-- خط جدا -->
                    <Rectangle Height="1" Margin="20,22" HorizontalAlignment="Stretch">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#00E5D4" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- دفاتر -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="MapMarkerRadius" Width="22" Height="22" Style="{StaticResource BlueNeonIcon}"
                                                 Foreground="#7DD3FC" VerticalAlignment="Center"/>
                        <TextBlock Text="دفاتر و مکان‌ها" FontSize="16" FontWeight="SemiBold"
                                   Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <WrapPanel>
                        <TextBox x:Name="OfficeNameTB" Style="{StaticResource DarkOutlinedTextBox}" Width="200"
                                 materialDesign:HintAssist.Hint="نام دفتر"/>
                        <TextBox x:Name="OfficeCityTB" Style="{StaticResource DarkOutlinedTextBox}" Width="150"
                                 materialDesign:HintAssist.Hint="شهر"/>
                        <TextBox x:Name="OfficeAddressTB" Style="{StaticResource DarkOutlinedTextBox}" Width="280"
                                 materialDesign:HintAssist.Hint="آدرس"/>
                        <Button x:Name="AddOfficeBtn" Width="42" Height="42" Margin="8,0,0,0"
                                Style="{StaticResource MaterialDesignFloatingActionDarkButton}"
                                Click="AddOfficeBtn_Click">
                            <materialDesign:PackIcon Kind="Plus" Width="24" Height="24"/>
                        </Button>
                    </WrapPanel>

                    <!-- لیست دفاتر به صورت چیپ -->
                    <ItemsControl x:Name="OfficesList" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#083344" CornerRadius="14" Padding="12,6" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayText}" Foreground="#7DD3FC" FontSize="13"/>
                                        <Button x:Name="RemoveOfficeBtn" Content="×" Margin="8,0,0,0" Padding="4,0"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="White" Cursor="Hand"
                                                Click="RemoveOfficeBtn_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- توضیحات -->
                    <TextBox Style="{StaticResource DarkOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="توضیحات"
                             Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" Margin="10,16,10,0"/>

                </StackPanel>
            </Border>

            <!-- دکمه‌ها -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,20">
                <Button x:Name="CancelBtn" Height="42" Padding="18,0" Margin="0,0,10,0"
                        Background="Transparent" BorderBrush="#334155" BorderThickness="1"
                        Foreground="#E2E8F0" materialDesign:ButtonAssist.CornerRadius="10"
                        Click="CancelBtn_Click">
                    <TextBlock Text="انصراف"/>
                </Button>
                <Button x:Name="SaveDepartmentBtn" Height="42" Padding="18,0"
                        Background="#2563EB" BorderThickness="0" Foreground="White"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Click="SaveDepartmentBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="ذخیره دپارتمان" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>