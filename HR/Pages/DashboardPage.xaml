<Page x:Class="HR.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Background="#0B1120"
      FlowDirection="RightToLeft"
      FontFamily="pack://application:,,,/Fonts/#B Nazanin"
      Foreground="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock x:Name="HeadcountText" Text="در حال بارگذاری..." FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

            <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="استخدام در دوازده ماه اخیر" FontSize="16" Margin="0,0,0,8"/>
                    <Grid MinHeight="220">
                        <lvc:CartesianChart x:Name="HiresChart" Height="240"/>
                        <TextBlock x:Name="HiresEmpty" Text="داده‌ای برای نمایش نیست" Foreground="#94A3B8" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="تعداد نفرات هر دپارتمان" FontSize="16" Margin="0,0,0,8"/>
                    <Grid MinHeight="180">
                        <lvc:CartesianChart x:Name="DepartmentChart"/>
                        <TextBlock x:Name="DepartmentEmpty" Text="داده‌ای برای نمایش نیست" Foreground="#94A3B8" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <UniformGrid Columns="2">
                <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="وضعیت" FontSize="16" Margin="0,0,0,8"/>
                        <Grid Height="260">
                            <lvc:PieChart x:Name="StatusChart"/>
                            <TextBlock x:Name="StatusEmpty" Text="داده‌ای برای نمایش نیست" Foreground="#94A3B8" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="16" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="جنسیت" FontSize="16" Margin="0,0,0,8"/>
                        <Grid Height="260">
                            <lvc:PieChart x:Name="GenderChart"/>
                            <TextBlock x:Name="GenderEmpty" Text="داده‌ای برای نمایش نیست" Foreground="#94A3B8" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Page>
