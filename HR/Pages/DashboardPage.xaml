<Page x:Class="HR.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Background="#0B1120"
      FlowDirection="RightToLeft"
      FontFamily="pack://application:,,,/Fonts/#B Nazanin"
      Foreground="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock x:Name="HeadcountText" Text="در حال بارگذاری..." FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
            <TextBlock Text="استخدام در دوازده ماه اخیر" Margin="0,0,0,4"/>
            <lvc:CartesianChart x:Name="HiresChart" Height="220" Margin="0,0,0,16"/>
            <TextBlock Text="تعداد نفرات هر دپارتمان" Margin="0,0,0,4"/>
            <lvc:CartesianChart x:Name="DepartmentChart" Height="220" Margin="0,0,0,16"/>
            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="وضعیت" Margin="0,0,0,4"/>
                    <lvc:CartesianChart x:Name="StatusChart" Height="200"/>
                </StackPanel>
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="جنسیت" Margin="0,0,0,4"/>
                    <lvc:CartesianChart x:Name="GenderChart" Height="200"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Page>
