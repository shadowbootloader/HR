<Page x:Class="HR.Pages.AssessmentEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0B1120"
      FlowDirection="RightToLeft"
      FontFamily="pack://application:,,,/Fonts/#B Nazanin"
      Foreground="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="720" HorizontalAlignment="Right">
            <TextBlock Text="آزمون جدید" FontSize="26" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="سؤالی از پیش نوشته نشده است. عنوان و سؤال‌ها را خودتان وارد کنید." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <TextBlock Text="عنوان"/>
            <TextBox x:Name="TitleBox" Height="36" Margin="0,4,0,10" Background="#1E293B" Foreground="White"/>
            <TextBlock Text="دسته"/>
            <TextBox x:Name="CategoryBox" Height="36" Margin="0,4,0,10" Background="#1E293B" Foreground="White"/>
            <TextBlock Text="توضیح"/>
            <TextBox x:Name="DescriptionBox" Height="64" Margin="0,4,0,10" Background="#1E293B" Foreground="White" TextWrapping="Wrap" AcceptsReturn="True"/>
            <TextBlock Text="سؤال‌ها" FontSize="18" FontWeight="Bold" Margin="0,8,0,6"/>
            <ListBox x:Name="QuestionList" MinHeight="80" Background="#111827" Foreground="White" BorderBrush="#334155"/>
            <TextBlock Text="متن سؤال" Margin="0,12,0,4"/>
            <TextBox x:Name="QuestionBox" Height="36" Background="#1E293B" Foreground="White"/>
            <TextBlock Text="نوع" Margin="0,8,0,4"/>
            <ComboBox x:Name="TypeBox" Height="36" SelectedIndex="0">
                <ComboBoxItem Content="طیف موافق/مخالف" Tag="Likert"/>
                <ComboBoxItem Content="چندگزینه‌ای" Tag="SingleChoice"/>
                <ComboBoxItem Content="مقیاس عددی" Tag="Scale"/>
                <ComboBoxItem Content="متن بلند" Tag="TextLong"/>
            </ComboBox>
            <TextBlock Text="گزینه‌ها برای چندگزینه‌ای، هر خط: متن|نمره" Margin="0,8,0,4"/>
            <TextBox x:Name="OptionsBox" Height="80" Background="#1E293B" Foreground="White" AcceptsReturn="True" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="افزودن سؤال" Height="36" Padding="14,0" Margin="0,0,8,0" Click="AddQuestion_Click" Background="#1E293B" Foreground="White" BorderThickness="0"/>
                <Button Content="ذخیره آزمون" Height="36" Padding="14,0" Click="Save_Click" Background="#3B82F6" Foreground="White" BorderThickness="0"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#93C5FD"/>
        </StackPanel>
    </ScrollViewer>
</Page>
