<Window x:Class="HR.Pages.LeaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مرخصی"
        Height="420" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#0B1120"
        FontFamily="pack://application:,,,/Fonts/#B Nazanin"
        Foreground="White">
    <StackPanel Margin="20">
        <TextBlock x:Name="NameText" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock x:Name="CurrentText" TextWrapping="Wrap" Foreground="#93C5FD" Margin="0,0,0,12"/>
        <TextBlock Text="نوع"/>
        <ComboBox x:Name="TypeBox" Height="34" Margin="0,4,0,8"/>
        <TextBlock Text="شروع"/>
        <DatePicker x:Name="StartPicker" Height="34" Margin="0,4,0,8"/>
        <TextBlock Text="پایان"/>
        <DatePicker x:Name="EndPicker" Height="34" Margin="0,4,0,8"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="ثبت مرخصی" Height="36" Padding="14,0" Margin="0,0,8,0" Click="Register_Click" Background="#3B82F6" Foreground="White" BorderThickness="0"/>
            <Button x:Name="EndButton" Content="پایان مرخصی" Height="36" Padding="14,0" Click="End_Click" Background="#7F1D1D" Foreground="White" BorderThickness="0" Visibility="Collapsed"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#FB7185"/>
    </StackPanel>
</Window>
