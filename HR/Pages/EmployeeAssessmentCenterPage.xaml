<Page x:Class="HR.Pages.EmployeeAssessmentCenterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:uc="clr-namespace:HR.Controls.Assessment"
      Background="#0B1120"
      FlowDirection="RightToLeft"
      FontFamily="pack://application:,,,/Fonts/#B Nazanin">

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- هدر پروفایل + سطح + مدال بعدی -->
        <uc:ProfileHeroControl x:Name="Hero" Margin="0,0,5,10" VerticalAlignment="Top"
    EmployeeName="{Binding Name}"
    Role="{Binding Role}"
    Department="{Binding Department}"
    Level="{Binding Level}"
    Xp="{Binding Xp}"
    XpMax="{Binding XpMax}"
    NextMedalName="{Binding NextMedal}"
    NextMedalRemain="{Binding NextMedalRemain}"
    AvatarSource="{Binding Avatar}"
    Medals="{Binding EarnedMedals}"
    NextMedalClick="ProfileHeroControl_NextMedalClick"/>
        <!-- ستون راست: مدال‌ها (ردیف ۰) -->

        <!-- تب دسته‌ها + ابزار -->
        <DockPanel Grid.Column="0" Grid.Row="1"  LastChildFill="True">
            

            <Border BorderBrush="#FF005689" Margin="0,0,5,10" CornerRadius="8" BorderThickness="1" Padding="10,10,5,5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                        <GradientStop Color="#0B1A2E" Offset="0"/>
                        <GradientStop Color="#0E2240" Offset="0.45"/>
                        <GradientStop Color="#081420" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TabControl x:Name="CategoryTabs"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            
            SelectionChanged="CategoryTabs_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <StackPanel>
                                            <Border x:Name="Bg" CornerRadius="10" BorderThickness="1"
                        Background="Transparent"
                        BorderBrush="#FF005689"
                        Padding="{TemplateBinding Padding}">
                                                <ContentPresenter x:Name="HeaderContent"
                                      ContentSource="Header"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <Rectangle x:Name="Underline"
                           Height="2"
                           Margin="4,4,4,0"
                           RadiusX="1" RadiusY="1"
                           Fill="Transparent"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Underline" Property="Fill" Value="#22D3EE"/>
                                                <Setter Property="Foreground" Value="#22D3EE"/>
                                                <Setter TargetName="Bg" Property="Background" Value="#152033"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#152033"/>
                                                <Setter Property="Foreground" Value="#E2E8F0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <TabItem Header="همه"/>
                    <TabItem Header="روانشناسی"/>
                    <TabItem Header="شغلی"/>
                    <TabItem Header="مهارتی"/>
                    <TabItem Header="انضباطی"/>
                    <TabItem Header="موقعیتی"/>
                    <TabItem Header="تولیداتی"/>
                </TabControl>
            </Border>
        </DockPanel>
        <DockPanel Grid.Column="0" Grid.Row="2"  LastChildFill="True">
            <Border  CornerRadius="8" DockPanel.Dock="Top" BorderThickness="1"
                    BorderBrush="#FF005689" Padding="10,10,5,10"
                    Margin="0,0,5,10"

                    FlowDirection="RightToLeft">
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                        <GradientStop Color="#0B1A2E" Offset="0"/>
                        <GradientStop Color="#0E2240" Offset="0.45"/>
                        <GradientStop Color="#081420" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- جستجو -->
                    <Border Grid.Column="3" HorizontalAlignment="Right"
    Height="40"
    CornerRadius="20" Width="350"
    Background="#0A1628"
    BorderBrush="#1A3A5C"
    BorderThickness="1"
    Padding="12,0"
    Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify"
                         Width="18" Height="18"
                         Foreground="#5D7694" Grid.Column="1"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"/>
                            <TextBox 
         x:Name="TestSearchBox"
         Background="Transparent"
         BorderThickness="0"
         Foreground="#E8F4FF"
         CaretBrush="#22D3EE"
         FontSize="13"
         VerticalAlignment="Center"
         VerticalContentAlignment="Center"
         materialDesign:HintAssist.Hint="جستجوی تست..."
         materialDesign:HintAssist.Foreground="#5D7694"
         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
         TextChanged="TestSearchBox_TextChanged"/>
                        </Grid>
                    </Border>

                    <!-- وضعیت -->
                    <Border Grid.Column="2"
    Height="40"
    CornerRadius="20"
    Background="#0A1628"
    BorderBrush="#1A3A5C"
    BorderThickness="1"
    Padding="12,0"
    Margin="0,0,8,0"
    MinWidth="130">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="StatusFilter"
          Grid.Column="0"
          Background="Transparent"
          BorderThickness="0"
          Foreground="#E8F4FF"
          FontSize="13"
          VerticalAlignment="Center"
          VerticalContentAlignment="Center"
          Padding="0"
          SelectionChanged="StatusFilter_SelectionChanged">
                                <ComboBox.Resources>
                                    <!-- حذف فلش پیش‌فرض تا فقط PackIcon خودمان دیده شود -->
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBox">
                                                    <Grid>
                                                        <ToggleButton x:Name="ToggleButton"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Focusable="False"
                            ClickMode="Press"
                            Background="Transparent"
                            BorderThickness="0">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent"/>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter x:Name="ContentSite"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="0,0,20,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"/>
                                                        <Popup x:Name="Popup"
                     Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Slide">
                                                            <Border x:Name="DropDown"
                        MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="#0B1526"
                        BorderBrush="#1A3A5C"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,4,0,0">
                                                                <Border.Effect>
                                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="0"
                                      Color="#22D3EE" Opacity="0.2"/>
                                                                </Border.Effect>
                                                                <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                                                    <StackPanel IsItemsHost="True"
                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                                </ScrollViewer>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBoxItem Content="وضعیت: همه" IsSelected="True"/>
                                <ComboBoxItem Content="وضعیت: تکمیل شده"/>
                                <ComboBoxItem Content="وضعیت: در حال انجام"/>
                                <ComboBoxItem Content="وضعیت: داده پرت"/>
                                <ComboBoxItem Content="وضعیت: قفل شده"/>
                            </ComboBox>
                            <materialDesign:PackIcon Grid.Column="1"
                         Kind="ChevronDown"
                         Width="16" Height="16"
                         Foreground="#5D7694"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- مرتب‌سازی -->
                    <Border Grid.Column="1"
    Height="40"
    CornerRadius="20"
    Background="#0A1628"
    BorderBrush="#1A3A5C"
    BorderThickness="1"
    Padding="12,0"
    Margin="0,0,8,0"
    MinWidth="150">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SortFilter"
          Grid.Column="0"
          Background="Transparent"
          BorderThickness="0"
          Foreground="#E8F4FF"
          FontSize="13"
          VerticalAlignment="Center"
          VerticalContentAlignment="Center"
          Padding="0"
          SelectionChanged="SortFilter_SelectionChanged">
                                <ComboBoxItem Content="مرتب‌سازی: جدیدترین" IsSelected="True"/>
                                <ComboBoxItem Content="مرتب‌سازی: امتیاز"/>
                                <ComboBoxItem Content="مرتب‌سازی: پیشرفت"/>
                            </ComboBox>
                            <materialDesign:PackIcon Grid.Column="1"
                         Kind="ChevronDown"
                         Width="16" Height="16"
                         Foreground="#5D7694"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- دکمه آزمون جدید -->
                    <Button Grid.Column="0"
    x:Name="BtnNewTest"
    Height="40"
    MinWidth="120"
    Cursor="Hand"
    Click="BtnNewTest_Click" Margin="0,0,20,0"
    FontFamily="B Nazanin">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
          Background="#22D3EE"
          CornerRadius="20"
          Padding="16,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="0"
                        Color="#22D3EE" Opacity="0.45"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                                        <TextBlock Text="آزمون جدید"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Foreground="#04202A"
                 VerticalAlignment="Center"
                 Margin="0,0,8,0"/>
                                        <materialDesign:PackIcon Kind="ClipboardTextOutline"
                               Width="18" Height="18"
                               Foreground="#04202A"
                               VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#67E8F9"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#06B6D4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            <!-- هدر لیست آزمون‌ها -->
            <Border Height="42" DockPanel.Dock="Top"
                    CornerRadius="8"
                    
                    BorderBrush="#1A3A5C"
                    BorderThickness="1"
                    Padding="12,0"
                    Margin="0,0,5,8"
                    
                    FlowDirection="RightToLeft">
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                        <GradientStop Color="#0B1A2E" Offset="0"/>
                        <GradientStop Color="#0E2240" Offset="0.45"/>
                        <GradientStop Color="#081420" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- ترتیب منطقی RTL: از راست به چپ = وضعیت … نام -->
                        <ColumnDefinition Width="*" MaxWidth="250"/>
                        <!-- وضعیت -->
                        <ColumnDefinition Width="200"/>
                        <!-- آخرین اجرا -->
                        <ColumnDefinition Width="150"/>
                        <!-- امتیاز -->
                        <ColumnDefinition Width="200"/>
                        <!-- پیشرفت -->
                        <ColumnDefinition Width="150"/>
                        <!-- دسته‌بندی -->
                        <!-- نام آزمون -->
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="4"
               Text="وضعیت"
               FontSize="16"
               Foreground="White"
               HorizontalAlignment="Left" Margin="20,0,0,0"
               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="3"
               Text="آخرین اجرا"
               FontSize="16"
               Foreground="White"
               HorizontalAlignment="Left" Margin="50,0,0,0"
               VerticalAlignment="Center"/>

                    

                    <TextBlock Grid.Column="2"
               Text="پیشرفت"
               FontSize="16"
               Foreground="White" Margin="0,0,20,0"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
               Text="دسته‌بندی"
               FontSize="16"
               Foreground="White"
               HorizontalAlignment="Left" Margin="20,0,0,0"
               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="0"
               Text="نام آزمون"
               FontSize="16"
               Foreground="White" Margin="10,0,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- لیست آزمون‌ها -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,5,0" LastChildFill="True">

                <!-- نوار صفحه‌بندی پایین -->
                <Border DockPanel.Dock="Bottom"
                        Height="44" HorizontalAlignment="Stretch"
                        Margin="0,5,0,0"
                        CornerRadius="12"
                        Background="#0A1628"
                        BorderBrush="#1A3A5C"
                        BorderThickness="1"
                        Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtCount"
                 Grid.Column="0"
                 Text="۰ آزمون"
                 FontFamily="B Nazanin"
                 FontSize="16"
                 Foreground="#8EA6C2"
                 VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  VerticalAlignment="Center">

                            <!-- در RTL: بعدی سمت چپ منطقی -->
                            <Button x:Name="BtnNext" Click="BtnNext_Click"
                Width="36" Height="32" Margin="0,0,8,0" Cursor="Hand" Padding="0"
                Background="#12233A" BorderBrush="#1A3A5C" BorderThickness="1"
                ToolTip="صفحه بعد">
                                <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" Foreground="#22D3EE"/>
                            </Button>

                            <TextBlock x:Name="TxtPage"
                   Text="۱ / ۱"
                   FontFamily="B Nazanin"
                   FontSize="13"
                   FontWeight="SemiBold" FlowDirection="RightToLeft"
                   Foreground="#E8F4FF"
                   VerticalAlignment="Center"
                   Margin="4,0"/>

                            <Button x:Name="BtnPrev" Padding="0" Click="BtnPrev_Click"
                Width="36" Height="32" Margin="8,0,0,0" Cursor="Hand"
                Background="#12233A" BorderBrush="#1A3A5C" BorderThickness="1"
                ToolTip="صفحه قبل">
                                <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" Foreground="#22D3EE"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" DockPanel.Dock="Top">
                    <ScrollViewer.Resources>

                        <Style TargetType="ScrollBar"
       BasedOn="{StaticResource NeonScrollBar}"/>

                    </ScrollViewer.Resources>
                    <StackPanel x:Name="TestList"/>
                </ScrollViewer>
            </DockPanel>

        </DockPanel>
        <uc:AssessmentSidePanelControl Grid.RowSpan="4" x:Name="SidePanel" Grid.Column="1" ></uc:AssessmentSidePanelControl>
        <uc:AssessmentFooterStatsControl x:Name="FooterStats" Grid.Row="3"
    OverallPercent="38"
    TotalTests="28"
    PsychologyCount="8"
    JobCount="0"
    SkillCount="0"
    OutlierCount="3"
    LockedCount="4"
    Margin="0,5,5,1"/>
    </Grid>
</Page>