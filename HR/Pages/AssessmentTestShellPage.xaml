<Page x:Class="HR.Pages.AssessmentTestShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="B Nazanin"
      FlowDirection="RightToLeft"
      Background="#050A14"
      Title="آزمون">

    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Grid Margin="0,0,0,8">
                <TextBlock x:Name="TitleText"
                   Foreground="#E8F4FF"
                   FontSize="18"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Right"/>
                <TextBlock x:Name="RemainText"
                   Foreground="#8EA6C2"
                   FontSize="13"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>
            </Grid>
            <Grid Height="8">
                <Border CornerRadius="4" Background="#12233A"/>
                <Border x:Name="ProgressFill"
                CornerRadius="4"
                Background="#22D3EE"
                HorizontalAlignment="Right"
                Width="0"/>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SlideHost"/>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button x:Name="BtnPrev"
              Content="اسلاید قبل"
              HorizontalAlignment="Right"
              Width="140" Height="40"
              Click="BtnPrev_Click"
              Cursor="Hand"
              Background="#12233A"
              Foreground="#E8F4FF"
              BorderBrush="#1A3A5C"
              BorderThickness="1"/>
            <Button x:Name="BtnNext"
              Content="بعدی"
              HorizontalAlignment="Left"
              Width="140" Height="40"
              Click="BtnNext_Click"
              Cursor="Hand"
              Background="#0E3A4A"
              Foreground="#22D3EE"
              BorderBrush="#22D3EE"
              BorderThickness="1"/>
        </Grid>
    </Grid>
</Page>