<Page x:Class="HR.Pages.DepartmentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uc="clr-namespace:HR.Controls"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="Transparent"
      FlowDirection="RightToLeft" 
      FontFamily="pack://application:,,,/Fonts/#B Nazanin">

    <Grid Margin="20,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <!-- فیلتر -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="StatusFilterCombo" Width="160" Height="40" Padding="5"
                          materialDesign:HintAssist.Hint="وضعیت"
                          Style="{StaticResource DarkOutlinedComboBox}"
                          Foreground="White">
                    
                </ComboBox>

                <TextBox x:Name="SearchBox" Width="220" Height="40" Margin="8,0,0,0"
                         materialDesign:HintAssist.Hint="جستجوی دپارتمان" Padding="5"
                         Style="{StaticResource DarkOutlinedTextBox}"
                         Foreground="White"/>

                <Button Height="40" Padding="14,0" Margin="8,0,0,0"
                        Background="#3B82F6" Foreground="White" BorderThickness="0"
                        materialDesign:ButtonAssist.CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilterVariant" Width="18" Height="18" Margin="0,0,6,0"/>
                        <TextBlock Text="فیلتر" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnAddDepartment" 
materialDesign:ButtonAssist.CornerRadius="10"
Background="#3B82F6"
BorderThickness="0"
Foreground="White"
Height="40"
Click="BtnAddDepartment_Click"
Margin="8,0,0,0"
Padding="14,0"
Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="AddDepartmentBtn"
            Background="{TemplateBinding Background}"
            CornerRadius="10"
            Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="AddDepartmentBtn" Property="Background" Value="#2563EB"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="AddDepartmentBtn" Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="دپارتمان جدید" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            
        </Grid>

        <!-- محتوا -->
        <Grid Grid.Row="1" FlowDirection="RightToLeft">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="270"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" FlowDirection="LeftToRight" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>

                    <Style TargetType="ScrollBar"
                        BasedOn="{StaticResource NeonScrollBar}"/>

                </ScrollViewer.Resources>
                <ItemsControl x:Name="DepartmentItems" FlowDirection="RightToLeft">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel FlowDirection="RightToLeft"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <uc:DepartmentCardControl
                                Margin="0,0,14,14"
                                DepartmentName="{Binding Name}"
                                ManagerName="{Binding Manager}"
                                MembersCount="{Binding MembersCount}"
                                ProjectsCount="{Binding ProjectsCount}"
                                PerformanceValue="{Binding Performance}"
                                EvaluationProgress="{Binding EvaluationProgress}"
                                ProjectProgress="{Binding ProjectProgress}"
                                StatusText="{Binding Status}"
                                StatusBackground="{Binding StatusBackground}"
                                StatusForeground="{Binding StatusForeground}"
                                IconKind="{Binding IconKind}"
                                StatusCircle="{Binding StatusCircle}"
                                MouseLeftButtonUp="DepartmentCard_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- کارت‌های کناری -->
            <StackPanel Grid.Column="2" Margin="0,-50,0,0">
                <uc:SideStatCardControl x:Name="CardDepartmentsCount" Margin="0,0,0,14"
                    Title="تعداد دپارتمان" ValueText="0" Height="220" SubText="واحد سازمانی فعال"
                    AccentBrush="#FF3C91DC" IconBackground="#0C4A6E" IconKind="OfficeBuilding"/>

                <uc:SideStatCardControl x:Name="CardAveragePerformance" Height="220" Margin="0,0,0,14"
                    Title="میانگین عملکرد" ValueText="0%" SubText="در سطح سازمان"
                    AccentBrush="#FF3C91DC" IconBackground="#0C4A6E" IconKind="TrophyOutline"/>

                <uc:SideStatCardControl x:Name="CardTotalMembers" Height="220" Margin="0,0,0,14"
                    Title="کل اعضا" ValueText="0" SubText="در همه دپارتمان‌ها"
                    AccentBrush="#FF3C91DC" IconBackground="#0C4A6E" IconKind="AccountGroup"/>

                
            </StackPanel>
        </Grid>
    </Grid>
</Page>