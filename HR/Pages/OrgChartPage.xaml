<Page x:Class="HR.Pages.OrgChartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:HR.Controls"
      Background="#0B1120"
      FlowDirection="RightToLeft"
      FontFamily="pack://application:,,,/Fonts/#B Nazanin"
      Foreground="White">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,12,12,0">
            <TextBlock Text="چارت سازمانی" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="بزرگ‌نمایی" Margin="16,0,8,0" VerticalAlignment="Center" Foreground="#94A3B8"/>
            <Slider x:Name="Zoom" Width="140" Minimum="0.6" Maximum="1.8" Value="1" VerticalAlignment="Center" ValueChanged="Zoom_Changed"/>
            <Button Content="بازگشت به دپارتمان‌ها" Margin="16,0,0,0" Height="34" Padding="12,0"
                    Background="#1E293B" Foreground="White" BorderThickness="0" Click="Back_Click"/>
        </StackPanel>
        <controls:OrgChartBoard x:Name="Board" Margin="8"/>
    </DockPanel>
</Page>
