<!-- ProfileHeroControl.xaml -->
<UserControl x:Class="HR.Controls.Assessment.ProfileHeroControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root"
             FlowDirection="RightToLeft"
             Height="95"
             FontFamily="B Nazanin">

    <Border CornerRadius="14"
          Padding="12,3"
          BorderThickness="1"
          BorderBrush="#1A3A5C"
          SnapsToDevicePixels="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                <GradientStop Color="#0B1A2E" Offset="0"/>
                <GradientStop Color="#0E2240" Offset="0.45"/>
                <GradientStop Color="#081420" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#22D3EE" Opacity="0.15"/>
        </Border.Effect>

        <!-- RTL: ستون ۰ = راست صفحه -->
        <DockPanel LastChildFill="True">
            <!--<DockPanel.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                --><!-- آواتار + نام --><!--
                <ColumnDefinition Width="Auto"/>
                --><!-- سطح + XP --><!--
                <ColumnDefinition Width="*"/>
                --><!-- مدال‌های کوچک (پر کردن وسط) --><!--
                <ColumnDefinition Width="Auto"/>
                --><!-- مدال بعدی --><!--
            </DockPanel.ColumnDefinitions>-->

            <!-- ========== ۱) آواتار + نام ========== -->
            <StackPanel Grid.Column="0" DockPanel.Dock="Left"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Margin="0,0,12,0">
                <Border Width="55" Height="55"
                CornerRadius="30"
                BorderBrush="#22D3EE"
                BorderThickness="2"
                Margin="0,0,8,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#22D3EE" Opacity="0.55"/>
                    </Border.Effect>
                    <Ellipse Width="42" Height="42" Margin="1">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarSource, ElementName=Root}"
                          Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding EmployeeName, ElementName=Root}"
                     FontSize="18" FontWeight="Bold" Foreground="#E8F4FF"/>
                    <TextBlock Text="{Binding Role, ElementName=Root}"
                     FontSize="16" Foreground="#8EA6C2"/>
                    <TextBlock Text="{Binding Department, ElementName=Root}"
                     FontSize="14" Foreground="#5D7694"/>
                </StackPanel>
            </StackPanel>

            <!-- ========== ۲) سطح + نوار XP ========== -->
            <StackPanel Grid.Column="1" DockPanel.Dock="Left"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0">
                <Grid Width="50" Height="56" Margin="0,0,8,0">
                    <Path Data="M25,2 L45,15 L45,40 L25,53 L4,40 L4,15 Z"
                Stroke="#22D3EE" StrokeThickness="1.8" Fill="#0A1628">
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#22D3EE" Opacity="0.5"/>
                        </Path.Effect>
                    </Path>
                    <TextBlock Text="{Binding Level, ElementName=Root}"
                     FontSize="22" FontWeight="Bold" Foreground="#22D3EE"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel VerticalAlignment="Center" Width="120">
                    <TextBlock Text="سطح فعلی" FontSize="14" Foreground="#8EA6C2"
                     HorizontalAlignment="Left" Margin="0,0,0,3"/>
                    <Border x:Name="XpTrack"
                  Height="8" CornerRadius="5"
                  Background="#12233A" ClipToBounds="True">
                        <Border x:Name="XpFill"
                    Height="8" CornerRadius="5"
                    HorizontalAlignment="Left" Width="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                                    <GradientStop Color="#22D3EE" Offset="0"/>
                                    <GradientStop Color="#34D399" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                    <TextBlock FontSize="14" Foreground="White" FlowDirection="LeftToRight"
                     HorizontalAlignment="Right" Margin="0,3,0,0">
            <Run Text="{Binding XpMax, ElementName=Root, Mode=OneWay}"/>
            <Run Text=" / "/>
            <Run Text="{Binding Xp, ElementName=Root, Mode=OneWay}"/>
            <Run Text=" امتیاز"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            
            <!-- ========== ۴) مدال بعدی ========== -->
            <Button Grid.Column="3" DockPanel.Dock="Right"
              Background="Transparent"
              BorderThickness="0"
              Cursor="Hand"
              Padding="6,2"
              Margin="8,0,0,0"
              VerticalAlignment="Center" Height="50"
              Click="OnNextMedalButtonClick" >
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="36" Height="42" Margin="0,0,6,0">
                        <Path Data="M10,28 L5,40 L12,35 L19,40 L14,28 Z" Fill="#E8A317" Opacity="0.9"/>
                        <Path Data="M18,28 L13,40 L20,35 L27,40 L22,28 Z" Fill="#C4890F" Opacity="0.85"/>
                        <Ellipse Width="26" Height="26"
                     HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="0,2,0,0"
                     Fill="#F5C542" Stroke="#FFE08A" StrokeThickness="1">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#F5C542" Opacity="0.5"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <materialDesign:PackIcon Kind="Star" Width="12" Height="12"
                                     Foreground="#0B1526"
                                     HorizontalAlignment="Center" VerticalAlignment="Top"
                                     Margin="0,8,0,0"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,2,0">
                        <TextBlock Text="مدال بعدی" FontSize="10" Foreground="#5D7694"
                       HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding NextMedalName, ElementName=Root}"
                       FontSize="12" FontWeight="SemiBold" Foreground="#E8F4FF"
                       HorizontalAlignment="Right"/>
                        <TextBlock FontSize="10" Foreground="#F5C542" HorizontalAlignment="Right">
              <Run Text="{Binding NextMedalRemain, ElementName=Root, Mode=OneWay}"/>
              <Run Text=" امتیاز تا مدال"/>
                        </TextBlock>
                    </StackPanel>
                    <materialDesign:PackIcon Kind="ChevronLeft" Width="14" Height="14"
                                   Foreground="#8EA6C2" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!-- ========== ۳) مدال‌های کوچک — وسط را پر می‌کند ========== -->
            
            <!-- ========== ۳) مدال‌های کوچک با PackIcon ========== -->
            <ItemsControl DockPanel.Dock="Left"
              ItemsSource="{Binding Medals, ElementName=Root}"
              VerticalAlignment="Center"
              HorizontalAlignment="Stretch"
              Margin="4,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="30" Height="30"
              Margin="5,0"
              CornerRadius="10"
              Background="Transparent"
              BorderBrush="{Binding ToneBrush}"
              BorderThickness="0"
              Cursor="Hand"
              ToolTipService.InitialShowDelay="60"
              ToolTipService.BetweenShowDelay="30"
              ToolTipService.ShowDuration="30000">
                            
                            <!-- Tooltip بزرگ -->
                            <Border.ToolTip>
                                <ToolTip Placement="Top"
                   HasDropShadow="False"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0">
                                    <Border CornerRadius="12"
                    Padding="14,12"
                    BorderBrush="#2A4A6A"
                    BorderThickness="1"
                    Background="#0B1526"
                    MinWidth="150">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="22" ShadowDepth="0"
                                  Color="#22D3EE" Opacity="0.4"/>
                                        </Border.Effect>
                                        <StackPanel HorizontalAlignment="Center">
                                            <!-- آیکون بزرگ -->
                                            <Border Width="56" Height="56"
                        CornerRadius="14"
                        Background="#12233A"
                        BorderBrush="{Binding ToneBrush}"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,8">
                                                <materialDesign:PackIcon Kind="{Binding IconKind}"
                                           Width="28" Height="28"
                                           Foreground="{Binding ToneBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#E8F4FF"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
                                            <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0">
                  <Run Text="{Binding Points, Mode=OneWay}"
                       Foreground="#F5C542" FontSize="13" FontWeight="SemiBold"/>
                  <Run Text=" امتیاز" Foreground="#8EA6C2" FontSize="11"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}"
                           FontSize="11" Foreground="#5D7694"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="170"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ToolTip>
                            </Border.ToolTip>

                            <!-- آیکون کوچک روی نوار -->
                            <materialDesign:PackIcon Kind="{Binding IconKind}"
                                 Width="22" Height="22"
                                 Foreground="{Binding ToneBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>