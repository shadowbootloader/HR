<!-- AssessmentTestRowControl.xaml -->
<UserControl x:Class="HR.Controls.Assessment.AssessmentTestRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root"
             FontFamily="B Nazanin"
             Height="58"
             Cursor="Hand"
             FlowDirection="LeftToRight"
             MouseLeftButtonUp="OnRowClick">

    <Border x:Name="RowBd"
          CornerRadius="14"
          
          BorderBrush="#FF005689"
          BorderThickness="1"
          Padding="10,6"
          Margin="0,3">
        <Border.Background>
            <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                <GradientStop Color="#0B1A2E" Offset="0"/>
                <GradientStop Color="#0E2240" Offset="0.45"/>
                <GradientStop Color="#081420" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#000000" Opacity="0.25"/>
        </Border.Effect>

        <!-- امتیاز حذف شده: وضعیت | دسته | نام | پیشرفت | تاریخ | اکشن -->
        <Grid FlowDirection="RightToLeft">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="250"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>

            <!-- ۱) وضعیت -->
            <Border x:Name="StatusBd"
              Grid.Column="4"
              CornerRadius="14"
              Padding="10,6"
              VerticalAlignment="Center"
              HorizontalAlignment="Left"
              MinWidth="118"
              Background="#063B2F">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,0,0,0">
                    <materialDesign:PackIcon x:Name="StatusIco" Margin="0,0,5,0"
               Kind="CheckCircleOutline"
               Width="20" Height="20"
               Foreground="#34D399"
               VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusLbl"
                     Text="تکمیل شده"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#34D399"
                     VerticalAlignment="Center"
                     Margin="0,0,6,0"/>
                    
                </StackPanel>
            </Border>

            <!-- ۲) دسته‌بندی (آیکون بالا + متن پایین) -->
            <Border Grid.Column="1"
              VerticalAlignment="Center"
              HorizontalAlignment="Left"
              CornerRadius="16" Margin="5,0,15,0"
              Padding="6,5"
              Background="#0E1B30"
              BorderBrush="#1A334F"
              BorderThickness="1"
              Width="130">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="12,0,0,0">
                    <materialDesign:PackIcon Kind="{Binding CategoryIcon, ElementName=Root}"
                                   Width="25" Height="25"
                                   Foreground="{Binding CategoryBrush, ElementName=Root}"
                                   HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding CategoryText, ElementName=Root}"
                     FontSize="18" VerticalAlignment="Center"
                     Foreground="{Binding CategoryBrush, ElementName=Root}"
                     HorizontalAlignment="Right"
                     Margin="10,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- ۳) نام آزمون -->
            <TextBlock Text="{Binding Title, ElementName=Root}"
                    FontSize="14" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="White" Margin="10,0,6,0"
                    TextTrimming="CharacterEllipsis"
                    TextAlignment="Right"/>
            

            <!-- ۴) پیشرفت -->
            <Grid Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ProgTrack"
                Height="10"
                CornerRadius="5"
                Background="#FF2F3E53"
                ClipToBounds="True"
                VerticalAlignment="Center">
                    <Border x:Name="ProgFill"
                  Height="8"
                  CornerRadius="4"
                  HorizontalAlignment="Left"
                  Width="0"
                  Background="#34D399">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="0"
                                Color="#34D399" Opacity="0.45"/>
                        </Border.Effect>
                    </Border>
                </Border>

                <TextBlock Grid.Column="1"
                   FontSize="13"
                   Foreground="#8EA6C2"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"
                   MinWidth="34">
          <Run Text="{Binding Progress, ElementName=Root, Mode=OneWay}"/>
          <Run Text="%"/>
                </TextBlock>
            </Grid>

            <!-- ۵) تاریخ / راهنمای قفل (امتیاز نیست) -->
            <TextBlock Grid.Column="3"
                 Text="{Binding LastDate, ElementName=Root}"
                 FontSize="16"
                 Foreground="White"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 TextWrapping="Wrap"
                 MaxHeight="40"
                 Margin="4,0"
                 FlowDirection="RightToLeft"/>

            <!-- ۶) شِورون / قفل + بج پرت -->
            <Grid Grid.Column="5" VerticalAlignment="Center">
                <materialDesign:PackIcon x:Name="TrailIco"
                                 Kind="ChevronLeft"
                                 Width="18" Height="18"
                                 Foreground="#64748B"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                <Border x:Name="OutlierBadge"
                Width="18" Height="18"
                CornerRadius="9"
                Background="#E11D48"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,-6,-4,0"
                Visibility="Collapsed">
                    <TextBlock x:Name="OutlierTxt"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="White"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>