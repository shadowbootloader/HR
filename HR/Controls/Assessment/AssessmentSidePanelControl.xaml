<!-- AssessmentSidePanelControl.xaml -->
<UserControl x:Class="HR.Controls.Assessment.AssessmentSidePanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root"
             FontFamily="B Nazanin"
             FlowDirection="RightToLeft"
             MinWidth="300">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- ========== مدال‌ها و افتخارات ========== -->
            <Border CornerRadius="16" Background="#0A1628" BorderBrush="#1A3A5C"
              BorderThickness="1" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,5" FlowDirection="LeftToRight">
                        <TextBlock Text="مدال‌ها و افتخارات" FontSize="14" FontWeight="SemiBold"
                       Foreground="#E8F4FF" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                        <Button HorizontalAlignment="Left" Cursor="Hand" VerticalAlignment="Top" Click="OnViewAllMedals"
                    Background="Transparent" BorderThickness="0" Padding="0" Height="25">
                            <TextBlock Text="مشاهده همه" FontSize="12" Foreground="#22D3EE"/>
                        </Button>
                    </Grid>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="2" Margin="0,0,0,0" Cursor="Hand"
                                Click="OnAssignMedal" Height="70" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Vertical">
                                <Border Width="40" Height="40" CornerRadius="10"
                                        BorderBrush="#22D3EE" BorderThickness="1.2"
                                        Background="Transparent" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"
                                            Foreground="#22D3EE"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="مدال اختصاصی" HorizontalAlignment="Center" FontSize="11" Foreground="White"
                                        VerticalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                        </Button>

                        <ItemsControl DockPanel.Dock="Right" Margin="0,5,0,0" ItemsSource="{Binding Medals, ElementName=Root}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center" Margin="2">
                                        <Border Width="48" Height="48" CornerRadius="12"
                                                Background="#12233A" BorderBrush="{Binding ToneBrush}"
                                                BorderThickness="1.2" Margin="0,0,0,4">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                     Color="#F5C542" Opacity="0.25"/>
                                            </Border.Effect>
                                            <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                Width="22" Height="22"
                                                Foreground="{Binding ToneBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="White" Margin="0,3,0,0"
                                                TextAlignment="Center" TextWrapping="Wrap" MaxWidth="56"/>
                                        <!--<TextBlock FontSize="10" Foreground="#8EA6C2" TextAlignment="Center">
                                            <Run Text="{Binding Points, Mode=OneWay}"/>
                                            <Run Text=" امتیاز"/>
                                        </TextBlock>-->
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- دکمه مدال اختصاصی را جدا می‌گذاریم اگر تعداد مدال‌ها ۴ باشد -->
                    </DockPanel>
                    
                </StackPanel>
            </Border>

            <!-- ========== توصیه آزمون (جای مسیر پیشرفت) ========== -->
            <Border CornerRadius="16"
        Background="#0A1628"
        BorderBrush="#1A3A5C"
        BorderThickness="1"
        Padding="14"
        Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="توصیه آزمون"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Foreground="#E8F4FF"
                 HorizontalAlignment="Right"/>
                        <Border HorizontalAlignment="Left"
              CornerRadius="8"
              Padding="8,3"
              Background="#0E3A4A"
              BorderBrush="#22D3EE"
              BorderThickness="1">
                            <TextBlock x:Name="TxtRecBadge"
                   Text="اولویت"
                   FontSize="10"
                   Foreground="#22D3EE"/>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
              Width="44" Height="44"
              CornerRadius="12"
              Background="#12233A"
              BorderBrush="#22D3EE"
              BorderThickness="1.2"
              Margin="0,0,12,0">
                            <materialDesign:PackIcon x:Name="RecIcon"
                                 Kind="ClipboardPlayOutline"
                                 Width="22" Height="22"
                                 Foreground="#22D3EE"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtRecTitle"
                   Text="ادامه ارزیابی مدیر"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#E8F4FF"
                   TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtRecDesc"
                   Text="۶۰٪ پیشرفت دارد؛ تکمیل آن مسیر تست‌های بعدی را باز می‌کند."
                   FontSize="11"
                   Foreground="#8EA6C2"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Button Margin="0,12,0,0"
            HorizontalAlignment="Stretch"
            Cursor="Hand"
            Click="OnStartRecommendedTest"
            Height="34">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                  CornerRadius="12"
                  Background="#0E3A4A"
                  BorderBrush="#22D3EE"
                  BorderThickness="1"
                  Padding="12,0">
                                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Play"
                                       Width="14" Height="14"
                                       Foreground="#22D3EE"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                                        <TextBlock x:Name="BtnRecText"
                         Text="ادامه آزمون"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="#22D3EE"
                         VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#134E5E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
            <!-- ========== فعالیت‌های اخیر ========== -->
            <Border CornerRadius="16" Background="#0A1628" BorderBrush="#1A3A5C"
              BorderThickness="1" Padding="14" MinHeight="220">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" FlowDirection="LeftToRight" Margin="0,0,0,10">
                        <TextBlock Text="فعالیت‌های اخیر" FontSize="14" FontWeight="SemiBold"
                       Foreground="#E8F4FF" HorizontalAlignment="Right"/>
                        <Button HorizontalAlignment="Left" Cursor="Hand" Click="OnViewAllActivities"
                    Background="Transparent" BorderThickness="0" Padding="0" Height="25">
                            <TextBlock Text="مشاهده همه" FontSize="12" Foreground="#22D3EE"/>
                        </Button>
                    </Grid>

                    <!-- نقل‌قول پایین -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Mountain" Width="36" Height="28"
                                     Foreground="#1E4A6A" HorizontalAlignment="Center" Opacity="0.8"/>
                        <TextBlock Text="موفقیت، نتیجه‌ی تکرار رفتارهای صحیح است."
                       FontSize="11" Foreground="#5D7694" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="8,6,8,0"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Activities, ElementName=Root}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                          Background="#12233A" Margin="0,0,8,0">
                                        <materialDesign:PackIcon Kind="{Binding IconKind}" Width="14" Height="14"
                                             Foreground="{Binding IconBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#E8F4FF"
                               TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#34D399"
                               Visibility="{Binding DetailVisibility}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="11"
                             Foreground="#5D7694" VerticalAlignment="Top" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>