<UserControl x:Class="HR.Controls.AchievementItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             FlowDirection="RightToLeft"
             FontFamily="pack://application:,,,/Fonts/#B Nazanin"
             Margin="0,0,0,0">
    <UserControl.Resources>
        <Style x:Key="RedNeonIcon"
TargetType="{x:Type materialDesign:PackIcon}">

            <Setter Property="Foreground"
     Value="Gold"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
         Color="Gold"
         BlurRadius="18"
         ShadowDepth="0"
         Opacity="0.9"/>
                </Setter.Value>
            </Setter>

        </Style>
    </UserControl.Resources>

    <Border BorderThickness="0,0,0,2" >
        <Border.BorderBrush>
            <RadialGradientBrush RadiusX="1" RadiusY="0.52" SpreadMethod="Pad">
                <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                <!-- مرکز کاملاً سفید -->
                <GradientStop Color="#FF94A3B8" Offset="0.2"/>
                <!-- خاکستری روشن -->
                <GradientStop Color="#FF334155" Offset="0.5"/>
                <!-- آبی تیره -->
                <GradientStop Color="#FF0F172A" Offset="0.7"/>
                <GradientStop Color="#550F172A" Offset="0.9"/>
                <GradientStop Color="Transparent" Offset="1"/>
                <!-- سرمه‌ای تیره لبه‌ها -->
            </RadialGradientBrush>
        </Border.BorderBrush>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>

                <!-- خط نقطه‌چین -->
                <ColumnDefinition Width="*"/>
                <!-- محتوا -->
            </Grid.ColumnDefinitions>

            <!-- ستون ۱: آیکون + خط عمودی -->
            <Grid Width="36" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- آیکون (Image) -->
                <Border x:Name="IconBorder"
                Grid.Row="0"
                Width="36" Height="36"
                CornerRadius="18"
                Background="#241F12"
                HorizontalAlignment="Center"
                ClipToBounds="True"
                Panel.ZIndex="2">

                    <materialDesign:PackIcon x:Name="IconImage" Width="25" Height="25" Kind="TrophyOutline" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource RedNeonIcon}" />

                </Border>

                <!-- خط عمودی پایین آیکون -->
                <Rectangle x:Name="BottomLine"
                   Grid.Row="1"
                   Width="2"
                   HorizontalAlignment="Center">
                    <Rectangle.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="Gold"/>
                            <GradientStop Color="#FF332911" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <!-- ستون ۲: خط نقطه‌چین -->


            <!-- ستون ۳: محتوا -->
            <DockPanel Grid.Column="1" 
                VerticalAlignment="Top"
                Margin="0,0,0,0">
                <TextBlock x:Name="DateText" DockPanel.Dock="Left"
       Text="اردیبهشت ۲۰۲۴"
       FontSize="15" FontWeight="Bold"
       Width="90"
       Foreground="White"
       
       VerticalAlignment="Top" Margin="0,9,5,0"/>


                <StackPanel Orientation="Vertical" DockPanel.Dock="Left" Margin="10,0,0,5">


                    <TextBlock x:Name="TitleText"
                       Text="عنوان"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"/>
                    <TextBlock x:Name="DescriptionText"
       Text="توضیحات"
       FontSize="13"
       Foreground="#A0B0C8"
       TextWrapping="Wrap"
       Margin="0,4,0,0"/>
                </StackPanel>


            </DockPanel>
        </Grid>
    </Border>
</UserControl>