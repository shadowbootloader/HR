<UserControl x:Class="HR.Controls.ProfileHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="clr-namespace:HR.Controls"
             xmlns:local="clr-namespace:HR.Controls" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             FontFamily="pack://application:,,,/Fonts/#B Nazanin"
             MinWidth="320"
             Height="420"
             Background="#0B1120">

    <UserControl.Resources>

        <!-- Text -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AEB9C5"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8EDF3"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0C1A28"/>
            <Setter Property="BorderBrush" Value="#1A3145"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>

    </UserControl.Resources>

    <Grid>

        <!-- Main Background -->
        <Border Background="#0B1120"
                CornerRadius="8"
                BorderBrush="#152738"
                BorderThickness="0">

            <Grid >

                <!-- ================================================= -->
                <!-- PROFILE IMAGE -->
                <!-- ================================================= -->

                <Grid Width="115"
                      Height="115"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,10,0,0">

                    <!-- Outer blue glow -->
                    <Ellipse Width="112"
                             Height="112"
                             Stroke="#159BFF"
                             StrokeThickness="2"
                             Opacity="0.9"/>

                    <Ellipse Width="106"
                             Height="106"
                             Stroke="#075E9D"
                             StrokeThickness="1"
                             Opacity="0.8"/>

                    <!-- Profile -->
                    <Ellipse Width="100"
                             Height="100">

                        <Ellipse.Fill>
                            <ImageBrush x:Name="EmpImage" 
                                        Stretch="UniformToFill"/>
                        </Ellipse.Fill>

                    </Ellipse>

                    <!-- Online indicator -->
                    <Ellipse Width="16"
                             x:Name="EmpStatus"
                             Height="16"
                             Fill="#1ED58A"
                             Stroke="#07111C"
                             StrokeThickness="3"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="0,0,1,1"/>

                </Grid>


                <!-- ================================================= -->
                <!-- NAME / JOB -->
                <!-- ================================================= -->

                <StackPanel Margin="0,2,130,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top" Width="170">

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0" FlowDirection="RightToLeft">


                        <TextBlock Text="علی فاطمی" x:Name="EmpFullName"
                                   Foreground="#F3F6FA"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" FontFamily="pack://application:,,,/Fonts/#B Nazanin"/>

                        <!-- Verified -->
                        <Grid Width="15" Height="15" Margin="5,1,0,0">



                            <materialDesign:PackIcon Kind="CheckDecagram" Style="{StaticResource NeonIcon}"  />

                        </Grid>

                    </StackPanel>

                    <TextBlock FlowDirection="RightToLeft" Text="Senior HR Business Partner"
                               x:Name="EmpGroup"
                               Foreground="#B6C1CC"
                               FontSize="10"
                               Margin="0,5,0,0" FontFamily="pack://application:,,,/Fonts/#B Nazanin"/>

                    <TextBlock FlowDirection="RightToLeft" Text="People &amp; Culture Department"
                               x:Name="EmpFeild"
                               Foreground="#B6C1CC"
                               FontSize="10"
                               Margin="0,2,0,0" FontFamily="pack://application:,,,/Fonts/#B Nazanin"/>

                    <!-- Location -->


                </StackPanel>
                <StackPanel FlowDirection="RightToLeft" Orientation="Horizontal" Margin="0,135,0,0" VerticalAlignment="Top">
                    <Grid Width="20"
      Height="20">

                        <!-- Glow بزرگ -->
                        <materialDesign:PackIcon
        Kind="MapMarkerOutline"
        Width="24"
        Height="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="#00E5D4"
        Opacity="0.65">

                            <materialDesign:PackIcon.Effect>
                                <DropShadowEffect
                Color="#00E5D4"
                BlurRadius="25"
                ShadowDepth="0"
                Opacity="1"/>
                            </materialDesign:PackIcon.Effect>

                        </materialDesign:PackIcon>


                        <!-- خود آیکون -->
                        <materialDesign:PackIcon
        Kind="MapMarkerOutline"
        Width="24"
        Height="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="#7FFFF5">

                            <materialDesign:PackIcon.Effect>
                                <DropShadowEffect
                Color="#00E5D4"
                BlurRadius="8"
                ShadowDepth="0"
                Opacity="1"/>
                            </materialDesign:PackIcon.Effect>

                        </materialDesign:PackIcon>

                    </Grid>

                    <TextBlock x:Name="EmpLocation"   Foreground="#D4DCE4" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center" FontFamily="pack://application:,,,/Fonts/#B Nazanin"/>

                </StackPanel>

                <local:OveralPerformance MinWidth="180" Width="{Binding StepStartX , ElementName=IdentityBox}" Height="110" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,90,0,0">

                </local:OveralPerformance>

                <!-- ================================================= -->
                <!-- PERSONAL INFORMATION -->
                <!-- ================================================= -->


                <local:NotchedBorder Height="237" x:Name="IdentityBox"
                TopRatio="0.44"
                StepDepth="0.17"
                CornerRadius="18"
                HorizontalAlignment="Stretch"
                StepSide="Left"
                FontFamily="pack://application:,,,/Fonts/#B Nazanin"
                Background="#0F172A"
                VerticalAlignment="Bottom"
                BorderBrush="#152738" Margin="0,98,0,0"/>


            </Grid>

        </Border>

    </Grid>

</UserControl>