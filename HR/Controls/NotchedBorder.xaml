<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf" mc:Ignorable="d" x:Class="HR.Controls.NotchedBorder"
             x:Name="Root"
             FontFamily="pack://application:,,,/Fonts/#BNazanin"
             d:DesignHeight="200" d:DesignWidth="200" >
    <UserControl.Resources>
        <Style x:Key="RedNeonIcon"
       TargetType="{x:Type materialDesign:PackIcon}">

            <Setter Property="Foreground"
            Value="LawnGreen"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                Color="Yellow"
                BlurRadius="18"
                ShadowDepth="0"
                Opacity="0.9"/>
                </Setter.Value>
            </Setter>

        </Style>

    </UserControl.Resources>


    <Grid>
        <!-- شکل اصلی -->
        <Path x:Name="ShapePath"
              Stretch="Fill"
              StrokeThickness="1.5"
              Stroke="{Binding BorderBrush, ElementName=Root}"
              Fill="{Binding Background, ElementName=Root}"/>

        <!-- عنوان ثابت در قسمت برآمدگی (پله) -->
        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right"
VerticalAlignment="Top"
Margin="0,15,18,0">
            <materialDesign:PackIcon Kind="StarFourPoints" DockPanel.Dock="Left"   Foreground="#4FC3F7" VerticalAlignment="Center" Margin="0,3,8,0"/>

            <TextBlock x:Name="NotchTitle"
           FontWeight="Bold" 
           Text="اطلاعات هویتی"
           FontFamily="pack://application:,,,/Fonts/#B Nazanin"
           FontSize="18"
           Foreground="White"
           HorizontalAlignment="Right"
           VerticalAlignment="Top"
           />
        </StackPanel>
        

        <!-- محتوای اصلی که کاربر قرار می‌دهد -->
        <ContentPresenter Margin="{Binding Padding, ElementName=Root}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>
        <DockPanel Margin="0,50,20,0" LastChildFill="True">
            <StackPanel Orientation="Vertical" DockPanel.Dock="Right" Margin="15,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Top">
                <materialDesign:PackIcon Kind="BadgeAccountOutline" Width="20" Height="20" Margin="0,5,0,5" Style="{StaticResource RedNeonIcon}"/>
                <materialDesign:PackIcon Kind="CalendarHeartOutline" Width="20" Height="20" Margin="0,5,0,5" Style="{StaticResource RedNeonIcon}"/>
                <materialDesign:PackIcon Kind="Ring" Width="20" Height="20" Margin="0,5,0,5" Style="{StaticResource RedNeonIcon}"/>
                <materialDesign:PackIcon Kind="Phone" Width="20" Height="20" Margin="0,5,0,5" Style="{StaticResource RedNeonIcon}"/>
                <materialDesign:PackIcon Kind="AccountMultiplePlusOutline" Width="20" Height="20" Margin="0,5,0,5" Style="{StaticResource RedNeonIcon}"/>
                <materialDesign:PackIcon Kind="AccountTieOutline" Width="20" Height="20" Margin="0,5,0,5" Style="{StaticResource RedNeonIcon}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" DockPanel.Dock="Right" Margin="30,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Top">
                <TextBlock FontWeight="Bold" FlowDirection="RightToLeft" FontSize="14" Margin="0,5,0,5" Text="شماره پرسنلی" Foreground="White" FontFamily="pack://application:,,,/Fonts/#B Nazanin" />
                <TextBlock FontWeight="Bold" FlowDirection="RightToLeft" FontSize="14" Margin="0,5,0,5" Text="تاریخ تولد" Foreground="White" FontFamily="pack://application:,,,/Fonts/#B Nazanin"/>
                <TextBlock FontWeight="Bold" FlowDirection="RightToLeft" FontSize="14" Margin="0,5,0,5" Text="وضعیت تاهل" Foreground="White" FontFamily="pack://application:,,,/Fonts/#B Nazanin"/>
                <TextBlock FontWeight="Bold" FlowDirection="RightToLeft" FontSize="14" Margin="0,5,0,5" Text="شماره تماس" Foreground="White" FontFamily="pack://application:,,,/Fonts/#B Nazanin"/>
                <TextBlock FontWeight="Bold" FlowDirection="RightToLeft" FontSize="14" Margin="0,5,0,5" Text="تاریخ شروع به کار" Foreground="White" FontFamily="pack://application:,,,/Fonts/#B Nazanin"/>
                <TextBlock FontWeight="Bold" FlowDirection="RightToLeft" FontSize="14" Margin="0,5,0,5" Text="مدیر" Foreground="White" FontFamily="pack://application:,,,/Fonts/#B Nazanin"/>
            </StackPanel>
            
            <StackPanel Orientation="Vertical"   HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <TextBlock x:Name="EmployeeID" FontWeight="Bold" FlowDirection="RightToLeft" FontSize="14" Margin="0,5,0,5"  Text="{Binding Path=EmployeeIDStr}" Foreground="White" FontFamily="pack://application:,,,/Fonts/#B Nazanin"/>
                <TextBlock x:Name="BirthDate" FontWeight="Bold" FlowDirection="RightToLeft" FontSize="14" Margin="0,5,0,5"  Text="{Binding Path=BirthDateStr}" Foreground="White" FontFamily="pack://application:,,,/Fonts/#B Nazanin"/>
                <TextBlock x:Name="MarageStatus" FontWeight="Bold" FlowDirection="RightToLeft" FontSize="14" Margin="0,5,0,5"  Text="{Binding Path=MarageStatusStr}" Foreground="White" FontFamily="pack://application:,,,/Fonts/#B Nazanin"/>
                <TextBlock x:Name="PhoneNumber" FontWeight="Bold" FlowDirection="RightToLeft" FontSize="14" Margin="0,5,0,5"  Text="{Binding Path=PhoneNumberStr}" Foreground="White" FontFamily="pack://application:,,,/Fonts/#B Nazanin"/>
                <TextBlock x:Name="JoinDate" FontWeight="Bold" FlowDirection="RightToLeft" FontSize="14" Margin="0,5,0,5"  Text="{Binding Path=JoinDateStr}" Foreground="White" FontFamily="pack://application:,,,/Fonts/#B Nazanin"/>
                <TextBlock x:Name="Manager" FontWeight="Bold" FlowDirection="RightToLeft" FontSize="14" Margin="0,5,0,5"  Text="{Binding Path=ManagerStr}" Foreground="White" FontFamily="pack://application:,,,/Fonts/#B Nazanin"/>
            </StackPanel>
        </DockPanel>
        
        
    </Grid>
</UserControl>