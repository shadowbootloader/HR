<UserControl x:Class="HR.Controls.AddEmployees.SelfAssessment"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:DesignHeight="450" d:DesignWidth="900"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="NeonGoldDiscreteSlider" TargetType="{x:Type Slider}" BasedOn="{StaticResource MaterialDesign3.MaterialDesignDiscreteSlider}">
            <!-- رنگ اصلی Slider -->
            <Setter Property="Foreground" Value="LawnGreen"/>
            <!-- رنگ انتخاب -->
            <Setter Property="BorderBrush" Value="#FFB300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Height="36">
                            <!-- ========================= -->
                            <!-- Track -->
                            <!-- ========================= -->
                            <Border x:Name="TrackBackground" Height="4" VerticalAlignment="Center" Background="#263238" CornerRadius="2">
                                <Grid>
                                    <!-- Active Track -->
                                    <Border x:Name="ActiveTrack" Height="4" HorizontalAlignment="Left" Background="#FFB300" CornerRadius="2" Width="0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FF9800" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                                        </Border.Effect>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- ========================= -->
                            <!-- Tick Marks -->
                            <!-- ========================= -->
                            <TickBar x:Name="TopTick" Height="10" VerticalAlignment="Center" Placement="Top" Fill="#805E3700" IsDirectionReversed="False"/>
                            <!-- ========================= -->
                            <!-- Thumb -->
                            <!-- ========================= -->
                            <Thumb x:Name="Thumb" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#FFD54F" BorderBrush="#FFB300" BorderThickness="2">
                                <Thumb.Effect>
                                    <DropShadowEffect Color="#FF9800" BlurRadius="14" ShadowDepth="0" Opacity="0.9"/>
                                </Thumb.Effect>
                            </Thumb>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <!-- عنوان -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18" FlowDirection="RightToLeft">
            <materialDesign:PackIcon Kind="ChartBoxOutline" Width="35" Height="35"
                                     Style="{StaticResource NeonIcon}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0"/>
            <StackPanel Margin="10,0,0,0">
                <TextBlock Text="خودارزیابی" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="امتیاز هر مورد را از ۰ تا ۱۰۰ مشخص کنید" FontSize="14" Foreground="#64748B"/>
            </StackPanel>
        </StackPanel>

        <!-- ۲ ستون × ۵ ردیف -->
        <Grid FlowDirection="RightToLeft" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ستون راست -->
            <StackPanel Grid.Column="0">

                <!-- نظم -->
                <Border Background="#0F172A" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                        BorderBrush="#1E293B" BorderThickness="1">
                    <Grid FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="نظم" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                        <Slider x:Name="SliderDiscipline" Grid.Column="1" FlowDirection="LeftToRight" Minimum="0" Maximum="100" Value="50" Style="{StaticResource NeonGoldDiscreteSlider}" VerticalAlignment="Center" Margin="8,0" ValueChanged="AssessmentSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Value, ElementName=SliderDiscipline, StringFormat={}{0:0}}"
                                   Foreground="#7DD3FC" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- سرعت انجام امور -->
                <Border Background="#0F172A" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                        BorderBrush="#1E293B" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="سرعت انجام امور" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                        <Slider FlowDirection="LeftToRight" x:Name="SliderSpeed" Grid.Column="1"
                                Minimum="0" Maximum="100" Value="50"
                                Style="{StaticResource NeonGoldDiscreteSlider}"
                                VerticalAlignment="Center" Margin="8,0"
                                ValueChanged="AssessmentSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Value, ElementName=SliderSpeed, StringFormat={}{0:0}}"
                                   Foreground="#7DD3FC" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- تلاش و پشتکار -->
                <Border Background="#0F172A" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                        BorderBrush="#1E293B" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="تلاش و پشتکار" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                        <Slider FlowDirection="LeftToRight" x:Name="SliderEffort" Grid.Column="1"
                                Minimum="0" Maximum="100" Value="50"
                                Style="{StaticResource NeonGoldDiscreteSlider}"
                                VerticalAlignment="Center" Margin="8,0"
                                ValueChanged="AssessmentSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Value, ElementName=SliderEffort, StringFormat={}{0:0}}"
                                   Foreground="#7DD3FC" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- قدرت مذاکره -->
                <Border Background="#0F172A" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                        BorderBrush="#1E293B" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="قدرت مذاکره" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                        <Slider FlowDirection="LeftToRight" x:Name="SliderNegotiation" Grid.Column="1"
                                Minimum="0" Maximum="100" Value="50"
                                Style="{StaticResource NeonGoldDiscreteSlider}"
                                VerticalAlignment="Center" Margin="8,0"
                                ValueChanged="AssessmentSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Value, ElementName=SliderNegotiation, StringFormat={}{0:0}}"
                                   Foreground="#7DD3FC" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- صبر و شکیبایی -->
                <Border Background="#0F172A" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                        BorderBrush="#1E293B" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="صبر و شکیبایی" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                        <Slider FlowDirection="LeftToRight" x:Name="SliderPatience" Grid.Column="1"
                                Minimum="0" Maximum="100" Value="50"
                                Style="{StaticResource NeonGoldDiscreteSlider}"
                                VerticalAlignment="Center" Margin="8,0"
                                ValueChanged="AssessmentSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Value, ElementName=SliderPatience, StringFormat={}{0:0}}"
                                   Foreground="#7DD3FC" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </StackPanel>

            <!-- ستون چپ -->
            <StackPanel Grid.Column="2">

                <!-- خلاقیت -->
                <Border Background="#0F172A" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                        BorderBrush="#1E293B" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="خلاقیت" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                        <Slider FlowDirection="LeftToRight" x:Name="SliderCreativity" Grid.Column="1"
                                Minimum="0" Maximum="100" Value="50"
                                Style="{StaticResource NeonGoldDiscreteSlider}"
                                VerticalAlignment="Center" Margin="8,0"
                                ValueChanged="AssessmentSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Value, ElementName=SliderCreativity, StringFormat={}{0:0}}"
                                   Foreground="#7DD3FC" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- وقت‌شناسی -->
                <Border Background="#0F172A" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                        BorderBrush="#1E293B" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="وقت‌شناسی" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                        <Slider FlowDirection="LeftToRight" x:Name="SliderPunctuality" Grid.Column="1"
                                Minimum="0" Maximum="100" Value="50"
                                Style="{StaticResource NeonGoldDiscreteSlider}"
                                VerticalAlignment="Center" Margin="8,0"
                                ValueChanged="AssessmentSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Value, ElementName=SliderPunctuality, StringFormat={}{0:0}}"
                                   Foreground="#7DD3FC" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- کار گروهی -->
                <Border Background="#0F172A" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                        BorderBrush="#1E293B" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="کار گروهی" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                        <Slider FlowDirection="LeftToRight" x:Name="SliderTeamwork" Grid.Column="1"
                                Minimum="0" Maximum="100" Value="50"
                                Style="{StaticResource NeonGoldDiscreteSlider}"
                                VerticalAlignment="Center" Margin="8,0"
                                ValueChanged="AssessmentSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Value, ElementName=SliderTeamwork, StringFormat={}{0:0}}"
                                   Foreground="#7DD3FC" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- دقت و ریزبینی -->
                <Border Background="#0F172A" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                        BorderBrush="#1E293B" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="دقت و ریزبینی" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                        <Slider FlowDirection="LeftToRight" x:Name="SliderAccuracy" Grid.Column="1"
                                Minimum="0" Maximum="100" Value="50"
                                Style="{StaticResource NeonGoldDiscreteSlider}"
                                VerticalAlignment="Center" Margin="8,0"
                                ValueChanged="AssessmentSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Value, ElementName=SliderAccuracy, StringFormat={}{0:0}}"
                                   Foreground="#7DD3FC" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- برنامه‌ریزی -->
                <Border Background="#0F172A" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                        BorderBrush="#1E293B" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="برنامه‌ریزی" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                        <Slider FlowDirection="LeftToRight" x:Name="SliderPlanning" Grid.Column="1"
                                Minimum="0" Maximum="100" Value="50"
                                Style="{StaticResource NeonGoldDiscreteSlider}"
                                VerticalAlignment="Center" Margin="8,0"
                                ValueChanged="AssessmentSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Value, ElementName=SliderPlanning, StringFormat={}{0:0}}"
                                   Foreground="#7DD3FC" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </StackPanel>
        </Grid>

        <!-- میانگین -->
        <Border Background="#0F172A" CornerRadius="12" Padding="16,12" Margin="0,8,0,0"
                BorderBrush="#1E293B" BorderThickness="1" FlowDirection="RightToLeft">
            <DockPanel>
                <TextBlock Text="میانگین کل" Foreground="#94A3B8" FontSize="18" VerticalAlignment="Center"/>
                <TextBlock x:Name="AverageScoreText"
                           Text="50"
                           Margin="20,0"
                           DockPanel.Dock="Left"
                           Foreground="#00E5D4"
                           FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Line Margin="50,30"
Stretch="Fill"
X1="0" Y1="0"
X2="1" Y2="0"
StrokeThickness="1"
HorizontalAlignment="Stretch"
VerticalAlignment="Bottom">
            <Line.Stroke>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#55008F88" Offset="0.20"/>
                    <GradientStop Color="#9900CFC1" Offset="0.38"/>
                    <GradientStop Color="#FF00E5D4" Offset="0.50"/>
                    <GradientStop Color="#9900CFC1" Offset="0.62"/>
                    <GradientStop Color="#55008F88" Offset="0.80"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Line.Stroke>
        </Line>
    </StackPanel>
</UserControl>