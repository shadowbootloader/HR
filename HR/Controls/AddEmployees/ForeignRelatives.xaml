<UserControl x:Class="HR.Controls.AddEmployees.ForeignRelatives"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HR.Controls.AddEmployees" xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <StackPanel>

            <!-- عنوان -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14" FlowDirection="RightToLeft">
                <materialDesign:PackIcon Kind="AccountMultiple" Width="35" Height="35"
                   Style="{StaticResource NeonIcon}"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0"/>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="بستگان خارجی" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="بستگان مقیم خارج از کشور" FontSize="14" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>

            <!-- جدول -->
            <ListView x:Name="PersonalForeignFamilyList" FlowDirection="RightToLeft"
Style="{StaticResource DarkListView}"
MinHeight="80" MaxHeight="280"
Margin="0,15,0,12"
HorizontalAlignment="Center"
SelectionChanged="PersonalForeignFamilyList_SelectionChanged"
>
                <ListView.View>
                    <GridView AllowsColumnReorder="True"
                      ColumnHeaderContainerStyle="{StaticResource DarkGridViewColumnHeader}">
                        <GridViewColumn Header="ردیف" Width="50" DisplayMemberBinding="{Binding Row}"/>
                        <GridViewColumn Header="نام و نام خانوادگی" Width="170" DisplayMemberBinding="{Binding FullName}"/>
                        <GridViewColumn Header="کشور" Width="120" DisplayMemberBinding="{Binding Country}"/>
                        <GridViewColumn Header="تاریخ عزیمت" Width="120" DisplayMemberBinding="{Binding DepartureDate}"/>
                        <GridViewColumn Header="علت" Width="180" DisplayMemberBinding="{Binding Reason}"/>
                        <GridViewColumn Header="توضیحات" Width="220" DisplayMemberBinding="{Binding Note}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- حذف -->
            <Button x:Name="DeleteForeignFamilyDataBtn"
          Content="حذف اطلاعات"
          Height="36" Width="120"
          Margin="0,0,0,14"
          HorizontalAlignment="Right"
          Background="#EF4444" Foreground="White" BorderThickness="0"
          materialDesign:ButtonAssist.CornerRadius="8"
          IsEnabled="{Binding ElementName=PersonalForeignFamilyList, Path=SelectedItems.Count}"
          Click="DeleteForeignFamilyDataBtn_Click"/>

            <!-- فرم -->
            <WrapPanel FlowDirection="RightToLeft">

                <ComboBox x:Name="ForeignFamily_FamilyNameCombo"
    Style="{StaticResource DarkOutlinedComboBox}"
    Width="180"
    materialDesign:HintAssist.Hint="نام و نام خانوادگی"
    IsEditable="True"/>

                <ComboBox x:Name="ForeignFamily_CountryNameCombo"
    Style="{StaticResource DarkOutlinedComboBox}"
    Width="160"
    materialDesign:HintAssist.Hint="کشور"
    IsEditable="True">

                </ComboBox>

                <DatePicker x:Name="ForeignFamily_StartDateDP"
      Style="{StaticResource DarkOutlinedDatePicker}"
      Width="150"
      materialDesign:HintAssist.Hint="تاریخ عزیمت"/>

                <TextBox x:Name="ForeignFamily_ReasonTB"
   Style="{StaticResource DarkOutlinedTextBox}"
   Width="180"
   materialDesign:HintAssist.Hint="علت"/>

                <TextBox x:Name="ForeignFamily_NoteTB"
   Style="{StaticResource DarkOutlinedTextBox}"
   Width="280"
   materialDesign:HintAssist.Hint="توضیحات"/>

            </WrapPanel>

            <!-- ثبت -->
            <Button x:Name="AddForeignFamilyDataBtn"
          Content="ثبت داده"
          Height="38" Width="120"
          Margin="0,14,0,0"
          HorizontalAlignment="Right"
          Background="#22C55E" Foreground="White" BorderThickness="0"
          materialDesign:ButtonAssist.CornerRadius="8"
          Click="AddForeignFamilyDataBtn_Click"/>

        </StackPanel>
        <Line Margin="50,30"
          Stretch="Fill"
          X1="0" Y1="0"
          X2="1" Y2="0"
          StrokeThickness="1"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Bottom">
            <Line.Stroke>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#55008F88" Offset="0.20"/>
                    <GradientStop Color="#9900CFC1" Offset="0.38"/>
                    <GradientStop Color="#FF00E5D4" Offset="0.50"/>
                    <GradientStop Color="#9900CFC1" Offset="0.62"/>
                    <GradientStop Color="#55008F88" Offset="0.80"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Line.Stroke>
        </Line>
    </StackPanel>
</UserControl>
