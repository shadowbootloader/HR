<UserControl x:Class="HR.Controls.AddEmployees.Languages"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HR.Controls.AddEmployees" xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <StackPanel>

            <!-- عنوان -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14" FlowDirection="RightToLeft">
                <materialDesign:PackIcon Kind="Translate" Width="35" Height="35"
                 Style="{StaticResource NeonIcon}"
                 VerticalAlignment="Center"
                 Margin="0,0,10,0"/>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="زبان خارجی" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="سطح مهارت‌های زبانی فرد" FontSize="14" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>

            <!-- جدول -->
            <ListView x:Name="PersonalLangList" FlowDirection="RightToLeft" 
            Style="{StaticResource DarkListView}"
            MinHeight="80" MaxHeight="280"
            Margin="0,15,0,12"
            HorizontalAlignment="Center"
            >
                <ListView.View>
                    <GridView AllowsColumnReorder="True"
                ColumnHeaderContainerStyle="{StaticResource DarkGridViewColumnHeader}">
                        <GridViewColumn Header="ردیف" Width="60" DisplayMemberBinding="{Binding Row}"/>
                        <GridViewColumn Header="زبان" Width="170" DisplayMemberBinding="{Binding Post}"/>
                        <GridViewColumn Header="خواندن" Width="180" DisplayMemberBinding="{Binding WorkInstitutionName}"/>
                        <GridViewColumn Header="نوشتن" Width="180" DisplayMemberBinding="{Binding DateOfStartWork}"/>
                        <GridViewColumn Header="درک مطلب" Width="180" DisplayMemberBinding="{Binding DateOfndWork}"/>
                        <GridViewColumn Header="مکالمه" Width="250" DisplayMemberBinding="{Binding DateOfndWork}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- حذف -->
            <Button x:Name="DeleteLangDataBtn"
            Content="حذف اطلاعات"
            Height="36" Width="120"
            Margin="0,0,0,14"
            HorizontalAlignment="Right"
            Background="#EF4444" Foreground="White" BorderThickness="0"
            materialDesign:ButtonAssist.CornerRadius="8"
            IsEnabled="{Binding ElementName=PersonalLangList, Path=SelectedItems.Count}"
            Click="DeleteLangDataBtn_Click"/>


            <!-- فرم -->
            <WrapPanel FlowDirection="RightToLeft">

                <ComboBox x:Name="LangNameTB"
                Style="{StaticResource DarkOutlinedComboBox}"
                Width="160"
                materialDesign:HintAssist.Hint="زبان">

                </ComboBox>

                <ComboBox x:Name="ReadingCombo"
                Style="{StaticResource DarkOutlinedComboBox}"
                Width="140"
                materialDesign:HintAssist.Hint="خواندن"
                >

                </ComboBox>

                <ComboBox x:Name="WritingCombo"
                Style="{StaticResource DarkOutlinedComboBox}"
                Width="140"
                materialDesign:HintAssist.Hint="نوشتن"
                >

                </ComboBox>

                <ComboBox x:Name="DarkMatlabCombo"
  Style="{StaticResource DarkOutlinedComboBox}"
  Width="140"
  materialDesign:HintAssist.Hint="درک مطلب"
  >

                </ComboBox>

                <ComboBox x:Name="SpeakingCombo"
  Style="{StaticResource DarkOutlinedComboBox}"
  Width="140"
  materialDesign:HintAssist.Hint="مکالمه"
  >

                </ComboBox>

            </WrapPanel>

            <!-- ثبت -->
            <Button x:Name="AddLangDataBtn"
        Content="ثبت داده"
        Height="38" Width="120"
        Margin="0,14,0,0"
        HorizontalAlignment="Right"
        Background="#22C55E" Foreground="White" BorderThickness="0"
        materialDesign:ButtonAssist.CornerRadius="8"
        Click="AddLangDataBtn_Click"/>

        </StackPanel>
        <Line Margin="50,30"
        Stretch="Fill"
        X1="0" Y1="0"
        X2="1" Y2="0"
        StrokeThickness="1"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Bottom">
            <Line.Stroke>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#55008F88" Offset="0.20"/>
                    <GradientStop Color="#9900CFC1" Offset="0.38"/>
                    <GradientStop Color="#FF00E5D4" Offset="0.50"/>
                    <GradientStop Color="#9900CFC1" Offset="0.62"/>
                    <GradientStop Color="#55008F88" Offset="0.80"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Line.Stroke>
        </Line>
    </StackPanel>
</UserControl>
