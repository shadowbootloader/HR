<UserControl x:Class="HR.Controls.AddEmployees.OtherActivity"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HR.Controls.AddEmployees" xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <StackPanel>

            <!-- عنوان -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14" FlowDirection="RightToLeft">
                <materialDesign:PackIcon Kind="StarCircleOutline" Width="35" Height="35"
                 Style="{StaticResource NeonIcon}"
                 VerticalAlignment="Center"
                 Margin="0,0,10,0"/>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="سایر فعالیت‌ها" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="فعالیت‌های متفرقه و سایر سوابق" FontSize="14" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>

            <!-- جدول -->
            <ListView x:Name="PersonalOtherActivityList" FlowDirection="RightToLeft"
        Style="{StaticResource DarkListView}"
        MinHeight="80" MaxHeight="280"
        Margin="0,15,0,12"
        HorizontalAlignment="Center"
        SelectionChanged="PersonalOtherActivityList_SelectionChanged"
        >
                <ListView.View>
                    <GridView AllowsColumnReorder="True"
                ColumnHeaderContainerStyle="{StaticResource DarkGridViewColumnHeader}">
                        <GridViewColumn Header="ردیف" Width="60" DisplayMemberBinding="{Binding Row}"/>
                        <GridViewColumn Header="عنوان" Width="200" DisplayMemberBinding="{Binding WorkInstitutionName}"/>
                        <GridViewColumn Header="محل اجرا" Width="160" DisplayMemberBinding="{Binding DateOfStartWork}"/>
                        <GridViewColumn Header="توضیحات" Width="280" DisplayMemberBinding="{Binding DateOfStartWork}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- حذف -->
            <Button x:Name="DeleteOtherActivityDataBtn"
        Content="حذف اطلاعات"
        Height="36" Width="120"
        Margin="0,0,0,14"
        HorizontalAlignment="Right"
        Background="#EF4444" Foreground="White" BorderThickness="0"
        materialDesign:ButtonAssist.CornerRadius="8"
        IsEnabled="{Binding ElementName=PersonalOtherActivityList, Path=SelectedItems.Count}"
        Click="DeleteOtherActivityDataBtn_Click"/>

            <!-- فرم -->
            <WrapPanel FlowDirection="RightToLeft">

                <TextBox x:Name="OtherActivity_NameTB"
 Style="{StaticResource DarkOutlinedTextBox}"
 Width="200"
 materialDesign:HintAssist.Hint="عنوان"/>

                <TextBox x:Name="OtherActivity_OptationPlaceTB"
 Style="{StaticResource DarkOutlinedTextBox}"
 Width="200"
 materialDesign:HintAssist.Hint="محل اجرا"/>

                <TextBox x:Name="OtherActivity_NoteTB"
 Style="{StaticResource DarkOutlinedTextBox}"
 Width="320"
 materialDesign:HintAssist.Hint="توضیحات"/>

            </WrapPanel>

            <!-- ثبت -->
            <Button x:Name="AddOtherActivityDataBtn"
        Content="ثبت داده"
        Height="38" Width="120"
        Margin="0,14,0,0"
        HorizontalAlignment="Right"
        Background="#22C55E" Foreground="White" BorderThickness="0"
        materialDesign:ButtonAssist.CornerRadius="8"
        Click="AddOtherActivityDataBtn_Click"/>

        </StackPanel>
        <Line Margin="50,30"
    Stretch="Fill"
    X1="0" Y1="0"
    X2="1" Y2="0"
    StrokeThickness="1"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Bottom">
            <Line.Stroke>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#55008F88" Offset="0.20"/>
                    <GradientStop Color="#9900CFC1" Offset="0.38"/>
                    <GradientStop Color="#FF00E5D4" Offset="0.50"/>
                    <GradientStop Color="#9900CFC1" Offset="0.62"/>
                    <GradientStop Color="#55008F88" Offset="0.80"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Line.Stroke>
        </Line>
    </StackPanel>
</UserControl>
