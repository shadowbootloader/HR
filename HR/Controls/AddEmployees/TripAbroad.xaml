<UserControl x:Class="HR.Controls.AddEmployees.TripAbroad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HR.Controls.AddEmployees" xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <StackPanel>

            <!-- عنوان -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14" FlowDirection="RightToLeft">
                <materialDesign:PackIcon Kind="Airplane" Width="35" Height="35"
                 Style="{StaticResource NeonIcon}"
                 VerticalAlignment="Center"
                 Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="سفرهای خارجی" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="سوابق سفرهای خارج از کشور" FontSize="14" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>

            <!-- جدول -->
            <ListView x:Name="PersonalForenTravelList" FlowDirection="RightToLeft"
            Style="{StaticResource DarkListView}"
            MinHeight="80" MaxHeight="280"
            Margin="0,15,0,12"
            HorizontalAlignment="Center"
            >
                <ListView.View>
                    <GridView AllowsColumnReorder="True"
                ColumnHeaderContainerStyle="{StaticResource DarkGridViewColumnHeader}">
                        <GridViewColumn Header="ردیف" Width="50" DisplayMemberBinding="{Binding Row}"/>
                        <GridViewColumn Header="کشور مبدأ" Width="120" DisplayMemberBinding="{Binding OriginCountry}"/>
                        <GridViewColumn Header="کشور مقصد" Width="120" DisplayMemberBinding="{Binding DestinationCountry}"/>
                        <GridViewColumn Header="وسیله سفر" Width="100" DisplayMemberBinding="{Binding Transport}"/>
                        <GridViewColumn Header="علت" Width="150" DisplayMemberBinding="{Binding Reason}"/>
                        <GridViewColumn Header="تاریخ رفت" Width="110" DisplayMemberBinding="{Binding DepartDate}"/>
                        <GridViewColumn Header="تاریخ برگشت" Width="110" DisplayMemberBinding="{Binding ReturnDate}"/>
                        <GridViewColumn Header="همراهان" Width="180" DisplayMemberBinding="{Binding Companions}"/>
                        <GridViewColumn Header="توضیحات" Width="180" DisplayMemberBinding="{Binding Note}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- حذف -->
            <Button x:Name="DeleteForenTravelDataBtn"
        Content="حذف اطلاعات"
        Height="36" Width="120"
        Margin="0,0,0,14"
        HorizontalAlignment="Right"
        Background="#EF4444" Foreground="White" BorderThickness="0"
        materialDesign:ButtonAssist.CornerRadius="8"
        IsEnabled="{Binding ElementName=PersonalForenTravelList, Path=SelectedItems.Count}"
        Click="DeleteForenTravelDataBtn_Click"/>


            <!-- فرم -->
            <WrapPanel FlowDirection="RightToLeft">

                <!-- کشور مبدأ -->
                <ComboBox x:Name="OriginCountryCombo"
            Style="{StaticResource DarkOutlinedComboBox}"
            Width="160"
            materialDesign:HintAssist.Hint="کشور مبدأ"
            IsEditable="True">

                </ComboBox>

                <!-- کشور مقصد -->
                <ComboBox x:Name="DestinationCountryCombo"
            Style="{StaticResource DarkOutlinedComboBox}"
            Width="160"
            materialDesign:HintAssist.Hint="کشور مقصد"
            IsEditable="True">

                </ComboBox>

                <!-- وسیله سفر -->
                <ComboBox x:Name="TransportCombo"
            Style="{StaticResource DarkOutlinedComboBox}"
            Width="150"
            materialDesign:HintAssist.Hint="وسیله سفر">

                </ComboBox>

                <!-- علت -->
                <TextBox x:Name="ReasonNameTB"
 Style="{StaticResource DarkOutlinedTextBox}"
 Width="180"
 materialDesign:HintAssist.Hint="علت سفر"/>

                <!-- تاریخ رفت -->
                <DatePicker x:Name="TravelStartDateDP"
    Style="{StaticResource DarkOutlinedDatePicker}"
    Width="150"
    materialDesign:HintAssist.Hint="تاریخ رفت"/>

                <!-- تاریخ برگشت -->
                <DatePicker x:Name="TravelEndDateDP"
    Style="{StaticResource DarkOutlinedDatePicker}"
    Width="150"
    materialDesign:HintAssist.Hint="تاریخ برگشت"/>

                <!-- همراهان -->
                <TextBox x:Name="CompanionsTB"
 Style="{StaticResource DarkOutlinedTextBox}"
 Width="220"
 materialDesign:HintAssist.Hint="نام همراهان"/>

                <!-- توضیحات -->
                <TextBox x:Name="Travle_NoteTB"
 Style="{StaticResource DarkOutlinedTextBox}"
 Width="280"
 materialDesign:HintAssist.Hint="توضیحات"/>

            </WrapPanel>

            <!-- ثبت -->
            <Button x:Name="AddForenTravelDataBtn"
        Content="ثبت داده"
        Height="38" Width="120"
        Margin="0,14,0,0"
        HorizontalAlignment="Right"
        Background="#22C55E" Foreground="White" BorderThickness="0"
        materialDesign:ButtonAssist.CornerRadius="8"
        Click="AddForenTravelDataBtn_Click"/>

        </StackPanel>
        <Line Margin="50,30"
        Stretch="Fill"
        X1="0" Y1="0"
        X2="1" Y2="0"
        StrokeThickness="1"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Bottom">
            <Line.Stroke>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#55008F88" Offset="0.20"/>
                    <GradientStop Color="#9900CFC1" Offset="0.38"/>
                    <GradientStop Color="#FF00E5D4" Offset="0.50"/>
                    <GradientStop Color="#9900CFC1" Offset="0.62"/>
                    <GradientStop Color="#55008F88" Offset="0.80"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Line.Stroke>
        </Line>
    </StackPanel>
</UserControl>
