<UserControl x:Class="HR.Controls.AddEmployees.Skills"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HR.Controls.AddEmployees" xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <StackPanel>

            <!-- عنوان -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14" FlowDirection="RightToLeft">
                <materialDesign:PackIcon Kind="Laptop" Width="35" Height="35"
                 Style="{StaticResource NeonIcon}"
                 VerticalAlignment="Center"
                 Margin="0,0,10,0"/>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="نرم‌افزارها" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="مهارت‌های نرم‌افزاری فرد" FontSize="14" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>

            <!-- لیست چیپ‌ها -->
            <ItemsControl x:Name="PersonalSoftwareList"  MinHeight="50" Margin="0,0,0,12" FlowDirection="RightToLeft">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Chip FlowDirection="RightToLeft" Content="{Binding DisplayText}"
         Margin="0,0,8,8"
         IsDeletable="True"
         DeleteClick="DeleteSoftwareChip_Click"
         Background="{Binding SkillLevelBrush}"
         Foreground="White" 
         FontSize="14"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>



            <!-- فرم افزودن -->
            <WrapPanel FlowDirection="RightToLeft">

                <TextBox x:Name="SoftwareNameTB"
            Style="{StaticResource DarkOutlinedTextBox}"
            Width="150"
            materialDesign:HintAssist.Hint="نام نرم‌افزار"/>

                <ComboBox x:Name="SkillCombo"
            Style="{StaticResource DarkOutlinedComboBox}"
            Width="140"
            materialDesign:HintAssist.Hint="میزان مهارت" >
                    <ComboBoxItem Content="ضعیف"/>
                    <ComboBoxItem Content="متوسط"/>
                    <ComboBoxItem Content="عالی"/>
                </ComboBox>
                <Button x:Name="AddSoftwareDataBtn" Margin="20,0,0,0" Width="40" Height="40"
            Style="{StaticResource MaterialDesignFloatingActionDarkButton}" Click="AddSoftwareDataBtn_Click"
            >
                    <materialDesign:PackIcon
              Width="35"
              Height="35"
              Kind="Plus"  />
                </Button>

            </WrapPanel>

        </StackPanel>
        <Line Margin="50,30"
 Stretch="Fill"
 X1="0" Y1="0"
 X2="1" Y2="0"
 StrokeThickness="1"
 HorizontalAlignment="Stretch"
 VerticalAlignment="Bottom">
            <Line.Stroke>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#55008F88" Offset="0.20"/>
                    <GradientStop Color="#9900CFC1" Offset="0.38"/>
                    <GradientStop Color="#FF00E5D4" Offset="0.50"/>
                    <GradientStop Color="#9900CFC1" Offset="0.62"/>
                    <GradientStop Color="#55008F88" Offset="0.80"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Line.Stroke>
        </Line>
    </StackPanel>
</UserControl>
