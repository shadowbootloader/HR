<UserControl x:Class="HR.Controls.AddEmployees.Family"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HR.Controls.AddEmployees"
             xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14" FlowDirection="RightToLeft">
                <materialDesign:PackIcon Kind="Crowd" Width="35" Height="35"
                                         Style="{StaticResource NeonIcon}" VerticalAlignment="Center"/>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="بستگان درجه یک" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="لیست بستگان و اطلاعات تماس آن‌ها" FontSize="12" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>

            <ListView x:Name="PersonalFamilyList" FlowDirection="RightToLeft"
                      Style="{StaticResource DarkListView}" SelectionMode="Extended"
                      MinHeight="80" MaxHeight="280" Margin="0,15,0,12"
                      HorizontalAlignment="Center">
                <ListView.View>
                    <GridView AllowsColumnReorder="True"
                              ColumnHeaderContainerStyle="{StaticResource DarkGridViewColumnHeader}">
                        <GridViewColumn Header="ردیف" Width="60" DisplayMemberBinding="{Binding Row}"/>
                        <GridViewColumn Header="نام" Width="110" DisplayMemberBinding="{Binding FirstName}"/>
                        <GridViewColumn Header="نام خانوادگی" Width="130" DisplayMemberBinding="{Binding LastName}"/>
                        <GridViewColumn Header="نسبت" Width="100" DisplayMemberBinding="{Binding Relation}"/>
                        <GridViewColumn Header="نام پدر" Width="130" DisplayMemberBinding="{Binding FatherName}"/>
                        <GridViewColumn Header="کد ملی" Width="140" DisplayMemberBinding="{Binding NationalCode}"/>
                        <GridViewColumn Header="تلفن همراه" Width="150" DisplayMemberBinding="{Binding PhoneNumber}"/>
                        <GridViewColumn Header="توضیحات" Width="200" DisplayMemberBinding="{Binding Note}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <Button x:Name="DeleteFamilyDataBtn" Content="حذف اطلاعات" Height="36" Width="120"
                    Margin="0,0,0,14" HorizontalAlignment="Right" Background="#EF4444"
                    Foreground="White" BorderThickness="0"
                    materialDesign:ButtonAssist.CornerRadius="8"
                    IsEnabled="{Binding ElementName=PersonalFamilyList, Path=SelectedItems.Count}"
                    Click="DeleteFamilyDataBtn_Click"/>

            <WrapPanel FlowDirection="RightToLeft">
                <TextBox x:Name="FamilyNameTB" Style="{StaticResource DarkOutlinedTextBox}"
                         Width="150" materialDesign:HintAssist.Hint="نام"/>
                <TextBox x:Name="Family_FamilyNameTB" Style="{StaticResource DarkOutlinedTextBox}"
                         Width="160" materialDesign:HintAssist.Hint="نام خانوادگی"/>
                <ComboBox x:Name="FamilyRelationCombo" Style="{StaticResource DarkOutlinedComboBox}"
                          Width="140" materialDesign:HintAssist.Hint="نسبت">
                    <ComboBoxItem Content="پدر"/>
                    <ComboBoxItem Content="مادر"/>
                    <ComboBoxItem Content="همسر"/>
                    <ComboBoxItem Content="فرزند"/>
                    <ComboBoxItem Content="برادر"/>
                    <ComboBoxItem Content="خواهر"/>
                    <ComboBoxItem Content="سایر"/>
                </ComboBox>
                <TextBox x:Name="Family_FatherNameTB" Style="{StaticResource DarkOutlinedTextBox}"
                         Width="150" materialDesign:HintAssist.Hint="نام پدر"/>
                <TextBox x:Name="Family_NationalIDNumberTB" Style="{StaticResource DarkOutlinedTextBox}"
                         Width="150" MaxLength="10" materialDesign:HintAssist.Hint="کد ملی"/>
                <TextBox x:Name="Family_PhoneNumberTB" Style="{StaticResource DarkOutlinedTextBox}"
                         Width="150" MaxLength="11" materialDesign:HintAssist.Hint="تلفن همراه"/>
                <TextBox x:Name="Family_NoteTB" Style="{StaticResource DarkOutlinedTextBox}"
                         Width="220" materialDesign:HintAssist.Hint="توضیحات"/>
            </WrapPanel>

            <Button x:Name="AddFamilyDataBtn" Content="ثبت داده" Height="38" Width="120"
                    Margin="0,14,0,0" HorizontalAlignment="Right" Background="#22C55E"
                    Foreground="White" BorderThickness="0"
                    materialDesign:ButtonAssist.CornerRadius="8"
                    Click="AddFamilyDataBtn_Click"/>
        </StackPanel>

        <Line Margin="50,30" Stretch="Fill" X1="0" Y1="0" X2="1" Y2="0"
              StrokeThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
            <Line.Stroke>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#55008F88" Offset="0.20"/>
                    <GradientStop Color="#9900CFC1" Offset="0.38"/>
                    <GradientStop Color="#FF00E5D4" Offset="0.50"/>
                    <GradientStop Color="#9900CFC1" Offset="0.62"/>
                    <GradientStop Color="#55008F88" Offset="0.80"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Line.Stroke>
        </Line>
    </StackPanel>
</UserControl>