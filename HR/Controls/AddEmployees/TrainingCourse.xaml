<UserControl x:Class="HR.Controls.AddEmployees.TrainingCourse"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HR.Controls.AddEmployees" xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <StackPanel>

            <!-- عنوان -->
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Margin="0,0,0,14">
                <materialDesign:PackIcon Kind="Certificate" Width="35" Height="35"
                    Style="{StaticResource NeonIcon}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="دوره‌های آموزشی" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="لیست دوره‌ها و گواهینامه‌های فرد" FontSize="14" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>

            <!-- جدول -->
            <ListView x:Name="PersonalCourseList" FlowDirection="RightToLeft"
                                Style="{StaticResource DarkListView}"
                                MinHeight="80" MaxHeight="280"
                                Margin="0,15,0,12"
                                HorizontalAlignment="Center"
                                HorizontalContentAlignment="Stretch"
                                SelectionChanged="PersonalCourseList_SelectionChanged"
                                >
                <ListView.View>
                    <GridView AllowsColumnReorder="True"
          ColumnHeaderContainerStyle="{StaticResource DarkGridViewColumnHeader}">
                        <GridViewColumn Header="ردیف" Width="60" DisplayMemberBinding="{Binding Row}"/>
                        <GridViewColumn Header="عنوان" Width="260" DisplayMemberBinding="{Binding Title}"/>
                        <GridViewColumn Header="مرکز آموزشی" Width="200" DisplayMemberBinding="{Binding Institute}"/>
                        <GridViewColumn Header="مدت زمان" Width="110" DisplayMemberBinding="{Binding DurationText}"/>
                        <GridViewColumn Header="توضیحات" Width="300" DisplayMemberBinding="{Binding Note}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- حذف -->
            <Button x:Name="DeleteCourseDataBtn" FlowDirection="RightToLeft"
Content="حذف اطلاعات"
Height="36" Width="120"
Margin="0,0,0,14"
HorizontalAlignment="Right"
Background="#EF4444" Foreground="White" BorderThickness="0"
materialDesign:ButtonAssist.CornerRadius="8"
IsEnabled="{Binding ElementName=PersonalCourseList, Path=SelectedItems.Count}"
Click="DeleteCourseDataBtn_Click"/>



            <!-- فرم -->
            <WrapPanel FlowDirection="RightToLeft">

                <TextBox x:Name="EducationalInstitutionTitleTB"
     Style="{StaticResource DarkOutlinedTextBox}"
     Width="250"
     materialDesign:HintAssist.Hint="عنوان دوره"/>

                <TextBox x:Name="EducationalInstitutionNameTB"
     Style="{StaticResource DarkOutlinedTextBox}"
     Width="180"
     materialDesign:HintAssist.Hint="نام موسسه / مرکز آموزشی"/>

                <TextBox x:Name="EducationalInstitutionTimeTB"
     Style="{StaticResource DarkOutlinedTextBox}"
     Width="120"
     materialDesign:HintAssist.Hint="مدت زمان"/>

                <TextBox x:Name="EducationalInstitutionNoteTB"
     Style="{StaticResource DarkOutlinedTextBox}"
     Width="400"
     materialDesign:HintAssist.Hint="توضیحات"/>

            </WrapPanel>

            <!-- گواهینامه -->
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Margin="10,8,10,10">
                <TextBlock Text="گواهینامه :" FontSize="18" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="CourseCertificateImageBtn"
    Content="انتخاب فایل"
    Height="36" Padding="14,0"
    Background="#3B82F6" Foreground="White" BorderThickness="0"
    materialDesign:ButtonAssist.CornerRadius="8"
    Click="CourseCertificateImageBtn_Click"/>
                <Image x:Name="CourseCertificateImage"
   Width="56" Height="56"
   Margin="16,0,0,0"
   Stretch="UniformToFill"/>
            </StackPanel>

            <!-- ثبت -->
            <Button x:Name="AddCourseDataBtn"
Content="ثبت داده"
Height="38" Width="120"
Margin="0,14,0,0"
HorizontalAlignment="Right"
Background="#22C55E" Foreground="White" BorderThickness="0"
materialDesign:ButtonAssist.CornerRadius="8"
Click="AddCourseDataBtn_Click"/>

        </StackPanel>
        <Line Margin="50,30"
            Stretch="Fill"
            X1="0" Y1="0"
            X2="1" Y2="0"
            StrokeThickness="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom">
            <Line.Stroke>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#55008F88" Offset="0.20"/>
                    <GradientStop Color="#9900CFC1" Offset="0.38"/>
                    <GradientStop Color="#FF00E5D4" Offset="0.50"/>
                    <GradientStop Color="#9900CFC1" Offset="0.62"/>
                    <GradientStop Color="#55008F88" Offset="0.80"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Line.Stroke>
        </Line>
    </StackPanel>
</UserControl>
