<UserControl x:Class="HR.Controls.AddEmployees.JobHistory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HR.Controls.AddEmployees" xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <StackPanel FlowDirection="RightToLeft">

            <!-- عنوان -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <materialDesign:PackIcon Kind="BriefcaseOutline" Width="35" Height="35"
Style="{StaticResource NeonIcon}"
HorizontalAlignment="Center"
VerticalAlignment="Center"/>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="سوابق شغلی" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="لیست تمام سوابق شغلی فرد" FontSize="14" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>

            <!-- جدول -->
            <ListView x:Name="PersonaljobsList"
         Style="{StaticResource DarkListView}"
         MinHeight="80" MaxHeight="280"
         Margin="0,15,0,12"
         HorizontalAlignment="Center"
         SelectionChanged="PersonaljobsList_SelectionChanged"
         >
                <ListView.View>
                    <GridView AllowsColumnReorder="True"
                 ColumnHeaderContainerStyle="{StaticResource DarkGridViewColumnHeader}">
                        <GridViewColumn Header="ردیف" Width="60" DisplayMemberBinding="{Binding Row}"/>
                        <GridViewColumn Header="سمت" Width="120" DisplayMemberBinding="{Binding Post}"/>
                        <GridViewColumn Header="نام موسسه" Width="180" DisplayMemberBinding="{Binding WorkInstitutionName}"/>
                        <GridViewColumn Header="شروع همکاری" Width="120" DisplayMemberBinding="{Binding DateOfStartWork}"/>
                        <GridViewColumn Header="پایان همکاری" Width="120" DisplayMemberBinding="{Binding DateOfndWork}"/>
                        <GridViewColumn Header="شماره تماس" Width="180" DisplayMemberBinding="{Binding DateOfndWork}"/>
                        <GridViewColumn Header="علت قطع همکاری" Width="180" DisplayMemberBinding="{Binding ReasonOfEndWork}"/>
                        <GridViewColumn Header="توضیحات" Width="280" DisplayMemberBinding="{Binding ReasonOfEndWork}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- حذف -->
            <Button x:Name="DeletejobDataBtn"
       Content="حذف اطلاعات"
       Height="36" Width="120"
       Margin="0,0,0,14"
       HorizontalAlignment="Left"
       Background="#EF4444" Foreground="White" BorderThickness="0"
       materialDesign:ButtonAssist.CornerRadius="8"
       IsEnabled="{Binding ElementName=PersonaljobsList, Path=SelectedItems.Count}"
       Click="DeletejobDataBtn_Click"/>



            <!-- فرم -->
            <WrapPanel>

                <TextBox x:Name="CompanyNameTB"
            Style="{StaticResource DarkOutlinedTextBox}"
            Width="180"
            materialDesign:HintAssist.Hint="نام موسسه"/>

                <TextBox x:Name="PostNameTB"
            Style="{StaticResource DarkOutlinedTextBox}"
            Width="160"
            materialDesign:HintAssist.Hint="سمت"/>

                <TextBox x:Name="JobFoneNumberTB"
            Style="{StaticResource DarkOutlinedTextBox}"
            Width="150"
            MaxLength="11"
            materialDesign:HintAssist.Hint="تلفن موسسه"/>

                <DatePicker x:Name="JobStartDateDP"
               Style="{StaticResource DarkOutlinedDatePicker}"
               Width="150"
               materialDesign:HintAssist.Hint="تاریخ شروع فعالیت"/>

                <DatePicker x:Name="JobEndDateDP"
               Style="{StaticResource DarkOutlinedDatePicker}"
               Width="150"
               materialDesign:HintAssist.Hint="تاریخ پایان فعالیت"/>

                <TextBox x:Name="JobEndReasonTB"
            Style="{StaticResource DarkOutlinedTextBox}"
            Width="300"
            materialDesign:HintAssist.Hint="علت قطع همکاری"/>
                <TextBox x:Name="JobNoteTB"
                       Style="{StaticResource DarkOutlinedTextBox}"
                       Width="400"
                       materialDesign:HintAssist.Hint="توضیحات"/>
            </WrapPanel>

            <!-- ثبت -->
            <Button x:Name="AddJobDataBtn" FlowDirection="RightToLeft"
       Content="ثبت داده"
       Height="38" Width="120"
       Margin="0,14,0,0"
       HorizontalAlignment="Left"
       Background="#22C55E" Foreground="White" BorderThickness="0"
       materialDesign:ButtonAssist.CornerRadius="8"
       Click="AddJobDataBtn_Click"/>

        </StackPanel>
        <Line Margin="50,30"
               Stretch="Fill"
               X1="0" Y1="0"
               X2="1" Y2="0"
               StrokeThickness="1"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Bottom">
            <Line.Stroke>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#55008F88" Offset="0.20"/>
                    <GradientStop Color="#9900CFC1" Offset="0.38"/>
                    <GradientStop Color="#FF00E5D4" Offset="0.50"/>
                    <GradientStop Color="#9900CFC1" Offset="0.62"/>
                    <GradientStop Color="#55008F88" Offset="0.80"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Line.Stroke>
        </Line>
    </StackPanel>
</UserControl>
