<UserControl x:Class="HR.Controls.AddEmployees.PhoneInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HR.Controls.AddEmployees" xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,18,0,16" FlowDirection="RightToLeft">
            <materialDesign:PackIcon Kind="Phone" Width="35" Height="35"
                             Style="{StaticResource NeonIcon}" VerticalAlignment="Center"/>
            <StackPanel Margin="10,0,0,0">
                <TextBlock Text="اطلاعات تماس" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                <TextBlock Text="لیست تمام شماره‌های تماس فرد." FontSize="14" Foreground="#64748B"/>
            </StackPanel>
        </StackPanel>

        <!-- فیلدهای Job -->
        <DockPanel>
            <!-- جدول -->
            <ListView x:Name="PersonalPhoneList" DockPanel.Dock="Top" FlowDirection="RightToLeft"
        Style="{StaticResource DarkListView}" HorizontalAlignment="Center"
        HorizontalContentAlignment="Stretch"
        MinHeight="80" MaxHeight="400" Margin="10,15,10,10">

                <ListView.View>
                    <GridView AllowsColumnReorder="True" ColumnHeaderContainerStyle="{StaticResource DarkGridViewColumnHeader}">
                        <GridViewColumn Header="ردیف" Width="60" DisplayMemberBinding="{Binding Row}"/>
                        <GridViewColumn Header="شماره" Width="180" DisplayMemberBinding="{Binding Grade}"/>
                        <GridViewColumn Header="نام مالک" Width="200" DisplayMemberBinding="{Binding FieldOFStudy}"/>
                        <GridViewColumn Header="وضعیت" Width="100" DisplayMemberBinding="{Binding EducationalStatus}"/>
                        <GridViewColumn Header="شروع استفاده" Width="150" DisplayMemberBinding="{Binding NameOfInstitution}"/>
                        <GridViewColumn Header="پایان استفاده" Width="150" DisplayMemberBinding="{Binding DateOFEndStudy}"/>
                        <GridViewColumn Header="توضیحات" Width="320"  DisplayMemberBinding="{Binding DateOFEndStudy}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <!-- حذف -->
            <Button x:Name="DeletePhoneDataBtn" DockPanel.Dock="Top"
        Content="حذف اطلاعات"
        Height="36" Width="110"
        Margin="0,0,0,14"
        HorizontalAlignment="Right"
        Background="#F43F5E" Foreground="White" BorderThickness="0"
        materialDesign:ButtonAssist.CornerRadius="8" Click="DeletePhoneDataBtn_Click"
        IsEnabled="{Binding ElementName=PersonalPhoneList, Path=SelectedItems.Count}"
        />
            <WrapPanel DockPanel.Dock="Top" FlowDirection="RightToLeft">

                <TextBox x:Name="FieldPhoneNumberTB"
            Style="{StaticResource DarkOutlinedTextBox}"
            Width="160"
            materialDesign:HintAssist.Hint="شماره"/>

                <TextBox x:Name="OwnerPhoneTB"
            Style="{StaticResource DarkOutlinedTextBox}"
            Width="160"
            materialDesign:HintAssist.Hint="نام مالک"/>

                <ComboBox x:Name="PhoneStatusCombo"
            Style="{StaticResource DarkOutlinedComboBox}"
            Width="140"
            materialDesign:HintAssist.Hint="وضعیت"
            SelectedIndex="0">

                </ComboBox>

                <DatePicker x:Name="PhoneStartDateDP"
            Style="{StaticResource DarkOutlinedDatePicker}"
            Width="150"
            materialDesign:HintAssist.Hint="تاریخ شروع استفاده"/>

                <DatePicker x:Name="PhoneEndDateDP"
            Style="{StaticResource DarkOutlinedDatePicker}"
            Width="150"
            materialDesign:HintAssist.Hint="تاریخ پایان استفاده"/>

                <TextBox x:Name="PhoneNumberNoteTB"
            Style="{StaticResource DarkOutlinedTextBox}"
            Width="320"
            materialDesign:HintAssist.Hint="توضیحات"/>

            </WrapPanel >
            <!-- ثبت -->
            <Button x:Name="AddPhoneBtn" DockPanel.Dock="Top"
        Content="ثبت داده"
        Height="38" Width="110"
        Margin="0,12,0,0"
        HorizontalAlignment="Right" Click="AddPhoneBtn_Click"
        Background="#22C55E" Foreground="White" BorderThickness="0"
        materialDesign:ButtonAssist.CornerRadius="8"
        />
        </DockPanel>
        <Line Margin="50,30"
    Stretch="Fill"
    X1="0" Y1="0"
    X2="1" Y2="0"
    StrokeThickness="1"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Bottom">
            <Line.Stroke>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#55008F88" Offset="0.20"/>
                    <GradientStop Color="#9900CFC1" Offset="0.38"/>
                    <GradientStop Color="#FF00E5D4" Offset="0.50"/>
                    <GradientStop Color="#9900CFC1" Offset="0.62"/>
                    <GradientStop Color="#55008F88" Offset="0.80"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Line.Stroke>
        </Line>
    </StackPanel>
</UserControl>
