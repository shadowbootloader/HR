<UserControl x:Class="HR.Controls.AddEmployees.EducationInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HR.Controls.AddEmployees" xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="800">
    <StackPanel>
        <StackPanel>

            <!-- عنوان -->
            <StackPanel FlowDirection="RightToLeft" Orientation="Horizontal" Margin="0,0,0,14">
                <materialDesign:PackIcon Kind="SchoolOutline" Width="35" Height="35"
                      Style="{StaticResource NeonIcon}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="مشخصات تحصیلی" FontSize="18"  FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="لیست تمام سوابق تحصیلی فرد" FontSize="14" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>

            <!-- جدول -->
            <ListView x:Name="PersonalEducationsList" FlowDirection="RightToLeft"
                      Style="{StaticResource DarkListView}"
                      MinHeight="80" MaxHeight="280"
                      Margin="0,15,0,12"
                      HorizontalAlignment="Center"
                      SelectionChanged="PersonalEducationsList_SelectionChanged"
                      >
                <ListView.View>
                    <GridView AllowsColumnReorder="True"
                          ColumnHeaderContainerStyle="{StaticResource DarkGridViewColumnHeader}">
                        <GridViewColumn Header="ردیف" Width="60" DisplayMemberBinding="{Binding Row}"/>
                        <GridViewColumn Header="مقطع" Width="130" DisplayMemberBinding="{Binding Grade}"/>
                        <GridViewColumn Header="رشته" Width="130" DisplayMemberBinding="{Binding FieldOFStudy}"/>
                        <GridViewColumn Header="وضعیت" Width="100" DisplayMemberBinding="{Binding EducationalStatus}"/>
                        <GridViewColumn Header="نام موسسه" Width="130" DisplayMemberBinding="{Binding NameOfInstitution}"/>
                        <GridViewColumn Header="تاریخ شروع" Width="130" DisplayMemberBinding="{Binding DateOfStartStudy}"/>
                        <GridViewColumn Header="تاریخ پایان" Width="130" DisplayMemberBinding="{Binding DateOFEndStudy}"/>
                        <GridViewColumn Header="پروژه / رساله" Width="450" DisplayMemberBinding="{Binding DateOFEndStudy}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- حذف -->
            <Button x:Name="DeleteEducationDataBtn"
                  Content="حذف اطلاعات"
                  Height="36" Width="120"
                  Margin="0,0,0,14"
                  HorizontalAlignment="Right"
                  Background="#EF4444" Foreground="White" BorderThickness="0"
                  materialDesign:ButtonAssist.CornerRadius="8"
                  IsEnabled="{Binding ElementName=PersonalEducationsList, Path=SelectedItems.Count}"
                  Click="DeleteEducationDataBtn_Click"/>



            <!-- وضعیت تحصیلی -->


            <!-- فرم -->
            <WrapPanel FlowDirection="RightToLeft">
                <!-- وضعیت تحصیلی -->
                <ComboBox x:Name="EducationalStatusCombo"
Style="{StaticResource DarkOutlinedComboBox}"
Width="160"
materialDesign:HintAssist.Hint="وضعیت تحصیلی">

                </ComboBox>
                <ComboBox x:Name="GradeCombo"
            Style="{StaticResource DarkOutlinedComboBox}"
            Width="160"
            materialDesign:HintAssist.Hint="مقطع تحصیلی">

                </ComboBox>

                <TextBox x:Name="FieldNameTB"
           Style="{StaticResource DarkOutlinedTextBox}"
           Width="250"
           materialDesign:HintAssist.Hint="رشته تحصیلی"/>

                <TextBox x:Name="UniversityNameTB"
           Style="{StaticResource DarkOutlinedTextBox}"
           Width="180"
           materialDesign:HintAssist.Hint="نام موسسه"/>

                <ComboBox x:Name="EducationStateNameTB"
Style="{StaticResource DarkOutlinedComboBox}"
Width="160"
materialDesign:HintAssist.Hint="استان محل تحصیل">
                </ComboBox>

                <!-- شهر محل تحصیل -->
                <ComboBox x:Name="EducationalCityNameTB"
Style="{StaticResource DarkOutlinedComboBox}"
Width="160"
materialDesign:HintAssist.Hint="شهر محل تحصیل">
                </ComboBox>

                <TextBox x:Name="EducationalMarksAvgTB"
           Style="{StaticResource DarkOutlinedTextBox}"
           Width="100"
           MaxLength="5"
           materialDesign:HintAssist.Hint="معدل"/>

                <DatePicker x:Name="EducationStartDateDP"
              Style="{StaticResource DarkOutlinedDatePicker}"
              Width="150"
              materialDesign:HintAssist.Hint="تاریخ شروع تحصیل"/>

                <DatePicker x:Name="EducationEndDateDP"
              Style="{StaticResource DarkOutlinedDatePicker}"
              Width="150"
              materialDesign:HintAssist.Hint="تاریخ پایان تحصیل"/>

                <TextBox x:Name="ResaleTB"
           Style="{StaticResource DarkOutlinedTextBox}"
           Width="470"
           materialDesign:HintAssist.Hint="پایان‌نامه / رساله / پروژه"/>

            </WrapPanel>

            <!-- مدرک تحصیلی -->
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Margin="10,8,10,0">
                <TextBlock Text="مدرک تحصیلی :" Foreground="White" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="EducationalCertificateImageBtn"
          Content="انتخاب فایل"
          Height="36" Padding="14,0"
          Background="#3B82F6" Foreground="White" BorderThickness="0"
          materialDesign:ButtonAssist.CornerRadius="8"
          Click="EducationalCertificateImageBtn_Click"/>
                <Image x:Name="EducationalCertificateImage"
         Width="56" Height="56"
         Margin="16,0,0,0"
         Stretch="UniformToFill"/>
            </StackPanel>

            <!-- ثبت -->
            <Button x:Name="AddEducationDataBtn"
      Content="ثبت داده"
      Height="38" Width="120"
      Margin="0,14,0,0"
      HorizontalAlignment="Right"
      Background="#22C55E" Foreground="White" BorderThickness="0"
      materialDesign:ButtonAssist.CornerRadius="8"
      Click="AddEducationDataBtn_Click"/>

        </StackPanel>
        <Line Margin="50,30"
                  Stretch="Fill"
                  X1="0" Y1="0"
                  X2="1" Y2="0"
                  StrokeThickness="1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Bottom">
            <Line.Stroke>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#55008F88" Offset="0.20"/>
                    <GradientStop Color="#9900CFC1" Offset="0.38"/>
                    <GradientStop Color="#FF00E5D4" Offset="0.50"/>
                    <GradientStop Color="#9900CFC1" Offset="0.62"/>
                    <GradientStop Color="#55008F88" Offset="0.80"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Line.Stroke>
        </Line>
    </StackPanel>
</UserControl>
