<UserControl x:Class="HR.Controls.OveralPerformance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:HR.Controls"
             mc:Ignorable="d"
             d:DesignHeight="160" d:DesignWidth="280">
    <Border Background="#0F172A"
            CornerRadius="14"
            
            BorderBrush="#1E293B"
            BorderThickness="1">

        <StackPanel>

            <!-- عنوان -->
            <StackPanel Orientation="Horizontal" Margin="0,5,18,0" FlowDirection="RightToLeft">
                <TextBlock Text="عملکرد کلی"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
                
            </StackPanel>

            <!-- گیج + متن‌ها -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">

                <!-- دایره پیشرفت -->
                <Grid Width="65" Height="65" Margin="20,10,16,0">
                    <!-- حلقه پس‌زمینه -->
                    <local:CircularProgressBar Value="87"
       Maximum="100"
       StrokeThickness="7"
       TrackColor="#FF293A61"
                           
       Width="65"
       Height="65">
                        <local:CircularProgressBar.GradientStops>
                            <GradientStop Color="#FF2BDCBE" Offset="0.0"/>
                            <!-- سبز -->
                            <GradientStop Color="#FF13BCE3" Offset="0.7"/>
                            <!-- زرد -->
                            <GradientStop Color="#FF2669D2" Offset="0.9"/>
                            <!-- نارنجی -->
                            <GradientStop Color="#FF1F385E" Offset="1.0"/>
                            <!-- قرمز -->
                        </local:CircularProgressBar.GradientStops>
                    </local:CircularProgressBar>
                    <!-- درصد وسط -->
                    <TextBlock Text="87%"
                               x:Name="PerformsncePercentTB"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- متن‌های سمت راست گیج -->
                <StackPanel VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="عالی" HorizontalAlignment="Center"
                               x:Name="LevelTB"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,8,0,8"/>

                    <!-- بج Top 15% -->
                    <Border Background="Green"
                            CornerRadius="8"
                            Padding="10,4"
                            HorizontalAlignment="Left">
                        <TextBlock Text="برتر 15%"
                                   x:Name="StatusTB"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="LawnGreen"/>
                    </Border>
                </StackPanel>

            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>