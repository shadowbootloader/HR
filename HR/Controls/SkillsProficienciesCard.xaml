<UserControl x:Class="HR.Controls.SkillsProficienciesCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft"
             FontFamily="pack://application:,,,/Fonts/#B Nazanin"
             >

    <Border Background="#0F172A"
            CornerRadius="16"
            Padding="5"
            BorderBrush="#1E293B"
            BorderThickness="1">

        <StackPanel>

            <!-- عنوان -->
            <DockPanel  Margin="7,0,7,10">
                <materialDesign:PackIcon Kind="StarFourPoints" DockPanel.Dock="Left"   Foreground="#4FC3F7" VerticalAlignment="Center" Margin="0,3,8,0"/>
                <TextBlock DockPanel.Dock="Left" Text="مهارت ها و توانمندی ها"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="مشاهده همه مهارت‌ ها  ›"
Foreground="#4FC3F7"
FontFamily="pack://application:,,,/Fonts/#B Nazanin"
FontSize="14"
Margin="0,5,18,0"
Cursor="Hand"
HorizontalAlignment="Right" />
            </DockPanel>

            <!-- لیست مهارت‌ها -->
            <StackPanel x:Name="SkillsList" Margin="0,15,0,0"/>

            
        </StackPanel>
    </Border>
</UserControl>