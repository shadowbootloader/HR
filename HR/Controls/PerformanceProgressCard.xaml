<UserControl x:Class="HR.Controls.PerformanceProgressCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft"
             FontFamily="pack://application:,,,/Fonts/#B Nazanin"
             MinHeight="250">

    <Border Background="#0F172A"
            CornerRadius="16"
            Padding="10"
            BorderBrush="#2A3548"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- عنوان + ComboBox -->
            <Grid Margin="5,2,5,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="StarFourPoints" DockPanel.Dock="Left"   Foreground="#4FC3F7" VerticalAlignment="Center" Margin="0,3,8,0"/>

                    <TextBlock Text="پیشرفت عملکرد"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    
                </StackPanel>

                <!-- ComboBox در سمت بالا راست -->
                <ComboBox x:Name="TimeRangeCombo"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Width="130"
                          Height="30"
                          FontSize="12"
                          Background="#2A3548"
                          Foreground="#E2E8F0"
                          BorderBrush="#3A4A5E"
                          BorderThickness="1">
                    <ComboBoxItem Content="۱۲ ماه اخیر" IsSelected="True"/>
                    <ComboBoxItem Content="۶ ماه اخیر"/>
                    <ComboBoxItem Content="۳ ماه اخیر"/>
                    <ComboBoxItem Content="۱ ماه اخیر"/>
                </ComboBox>
            </Grid>

            <!-- چارت -->
            <lvc:CartesianChart FlowDirection="LeftToRight"  Foreground="White" Background="Transparent" x:Name="ProgressChart" Grid.Row="1"/>
        </Grid>
    </Border>
</UserControl>