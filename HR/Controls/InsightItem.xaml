<UserControl x:Class="HR.Controls.InsightItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="pack://application:,,,/Fonts/#B Nazanin"
             Margin="0,0,0,10">

    <Border Background="#222C3C"
            CornerRadius="12"
            Padding="5">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- آیکون دایره‌ای -->
            <Border x:Name="IconBorder"
                    Width="36" Height="36"
                    CornerRadius="18"
                    Background="#3B4A6B"
                    Margin="0,0,12,0">
                <TextBlock x:Name="IconText"
                           Text="👤"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- متن‌ها -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           Text="عنوان"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock x:Name="DescriptionText"
                           Text="توضیحات"
                           FontSize="12"
                           Foreground="#A0B0C8"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0"/>

                <TextBlock x:Name="ChangeTextTB"
                           Text=""
                           FontSize="13"
                           Foreground="#4ADE80"
                           Margin="0,4,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>