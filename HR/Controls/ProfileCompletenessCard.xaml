<UserControl x:Class="HR.Controls.ProfileCompletenessCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HR.Controls"
             FlowDirection="RightToLeft">
    <Border Background="#111827" BorderBrush="#6D28D9" BorderThickness="1" CornerRadius="10" Padding="12">
        <StackPanel>
            <TextBlock Text="تکمیل پروفایل" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Grid Width="72" Height="72" Margin="0,0,12,0">
                    <local:CircularProgressBar x:Name="Ring" Value="0" Maximum="100" StrokeThickness="8"
                                                TrackColor="#3B0764" Width="72" Height="72">
                        <local:CircularProgressBar.GradientStops>
                            <GradientStop Color="#F5D0FE" Offset="0"/>
                            <GradientStop Color="#C084FC" Offset="0.45"/>
                            <GradientStop Color="#7C3AED" Offset="1"/>
                        </local:CircularProgressBar.GradientStops>
                    </local:CircularProgressBar>
                    <TextBlock x:Name="PercentText" Text="—" Foreground="White" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ScoreText" Text="امتیاز —" Foreground="#E9D5FF" FontSize="14"/>
                    <TextBlock x:Name="RemainingText" Text="باقی‌مانده —" Foreground="#C4B5FD" Margin="0,4,0,0" FontSize="13"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="MissingText" Foreground="#FBBF24" Margin="0,8,0,0" TextWrapping="Wrap" Text="بخشی ثبت نشده است."/>
        </StackPanel>
    </Border>
</UserControl>
