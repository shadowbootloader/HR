<UserControl x:Class="HR.Controls.StrengthsAreasCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft"
             FontFamily="pack://application:,,,/Fonts/#B Nazanin"
             >

    <Border Background="#0F172A"
            CornerRadius="16"
            Padding="5"
            BorderBrush="#2A3548"
            BorderThickness="1">

        <StackPanel>
            <!-- عنوان -->
            <DockPanel  Margin="7,0,7,10">
                <materialDesign:PackIcon Kind="StarFourPoints" DockPanel.Dock="Left"   Foreground="#4FC3F7" VerticalAlignment="Center" Margin="0,3,8,0"/>
                <TextBlock DockPanel.Dock="Left" Text="نقاط قوت و نقاط قابل بهبود"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="مشاهده تحلیل جزئیات  ›"
Foreground="#4FC3F7"
FontFamily="pack://application:,,,/Fonts/#B Nazanin"
FontSize="14"
Margin="0,5,18,0"
Cursor="Hand"
HorizontalAlignment="Right" />
            </DockPanel>

            <!-- نقاط قوت -->
            <TextBlock Text="نقاط قوت"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#A0B0C8"
                       Margin="7,0,7,8"/>

            <WrapPanel x:Name="StrengthsPanel" Margin="7,0,7,16"/>

            <!-- نقاط قابل بهبود -->
            <TextBlock Text="نقاط قابل بهبود"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#A0B0C8"
                       Margin="7,0,7,8"/>

            <WrapPanel x:Name="AreasPanel" Margin="7,0,7,14"/>

            
        </StackPanel>
    </Border>
</UserControl>