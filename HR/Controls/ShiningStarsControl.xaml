<UserControl x:Class="HR.Controls.ShiningStarsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="70" Height="70"
             Background="Transparent"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Storyboard x:Key="ShiningStarsStoryboard" Duration="0:0:1.5" RepeatBehavior="Forever">

            <!-- ستاره ۱ (بزرگ‌ترین) -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star1"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="0:0:0"     Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.267" Value="1.15">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.450" Value="1.00"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star1"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="0:0:0"     Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.267" Value="1.25">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.450" Value="1.00"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- ستاره ۲ -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Star2"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
