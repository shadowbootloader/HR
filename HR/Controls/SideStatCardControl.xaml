<UserControl x:Class="HR.Controls.SideStatCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root"
             MinHeight="140" Width="270" HorizontalAlignment="Stretch" >

    <Border Background="#0F172A"
            CornerRadius="16"
            BorderBrush="#152738"
            BorderThickness="1"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- هدر -->
            <DockPanel Grid.Row="0" Margin="0,0,0,0">
                <Border DockPanel.Dock="Left" Width="55" Height="55" CornerRadius="12"
                        Background="{Binding IconBackground, ElementName=Root}" Margin="0,0,10,0">
                    <materialDesign:PackIcon Kind="{Binding IconKind, ElementName=Root}"
                                             Width="40" Height="40"
                                             Foreground="{Binding AccentBrush, ElementName=Root}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Title, ElementName=Root}" Margin="5,5,5,15"
                           Foreground="White" FontWeight="ExtraBold" FontSize="20" VerticalAlignment="Top"/>
            </DockPanel>

            <!-- مقدار -->
            <TextBlock Grid.Row="1"
                       Text="{Binding ValueText, ElementName=Root}"
                       FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="White"/>

            <!-- زیر‌متن -->
            <TextBlock Grid.Row="2"
                       Text="{Binding SubText, ElementName=Root}"
                       FontSize="16" FontWeight="ExtraBold" HorizontalAlignment="Center"
                       Foreground="{Binding AccentBrush, ElementName=Root}"
                       Margin="0,4,0,4"/>

            <!-- اسپارک‌لاین ساده -->
            <Canvas Grid.Row="3" Margin="0,-10,0,0" Height="50" FlowDirection="LeftToRight" HorizontalAlignment="Stretch" >
                <Polyline Points="{Binding SparkPoints, ElementName=Root}" FlowDirection="LeftToRight"
                          Stroke="{Binding AccentBrush, ElementName=Root}"
                          StrokeThickness="2"
                          Fill="Transparent"
                          StrokeLineJoin="Round"  >
                    <Polyline.Effect>
                        <DropShadowEffect
            Color="#00E5FF"
            BlurRadius="15"
            ShadowDepth="2"
            Direction="270"
            Opacity="0.7"/>
                    </Polyline.Effect>
                </Polyline>
            </Canvas>
        </Grid>
    </Border>
</UserControl>