<UserControl x:Class="HR.Controls.CertificatesCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             FlowDirection="RightToLeft"
             FontFamily="pack://application:,,,/Fonts/#B Nazanin"
             >
    <UserControl.Resources>
        <Style x:Key="RedNeonIcon"
TargetType="{x:Type materialDesign:PackIcon}">

            <Setter Property="Foreground"
     Value="Yellow"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
         Color="Yellow"
         BlurRadius="18"
         ShadowDepth="0"
         Opacity="0.9"/>
                </Setter.Value>
            </Setter>

        </Style>
    </UserControl.Resources>

    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#1E293B"  BorderThickness="1">

        <StackPanel>

            <!-- عنوان -->

            
            <DockPanel  Margin="7,5,7,10">
                <materialDesign:PackIcon Kind="StarFourPoints" DockPanel.Dock="Left"   Foreground="#4FC3F7" VerticalAlignment="Center" Margin="0,3,8,0"/>
                <TextBlock DockPanel.Dock="Left" Text="گواهینامه‌ها"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="مشاهده همه گواهینامه‌ها  ›"
Foreground="#4FC3F7"
FontFamily="pack://application:,,,/Fonts/#B Nazanin"
FontSize="14"
Margin="0,5,18,0"
Cursor="Hand"
HorizontalAlignment="Right" />
            </DockPanel>

            <!-- لیست گواهینامه‌ها -->
            <StackPanel x:Name="CertificatesList" Margin="7,0,7,6"/>

            
        </StackPanel>
    </Border>
</UserControl>