<UserControl x:Class="HR.Controls.PhotoUploadControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="120">

    <StackPanel HorizontalAlignment="Center">
        <Grid Width="88" Height="88">
            <Ellipse Fill="#1E293B" Stroke="#334155" StrokeThickness="2"/>
            <materialDesign:PackIcon Kind="Account" Width="40" Height="40"
                                     Foreground="#64748B"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                    Background="#3B82F6" BorderThickness="0"
                    materialDesign:ButtonAssist.CornerRadius="14">
                <materialDesign:PackIcon Kind="Camera" Width="14" Height="14" Foreground="White"/>
            </Button>
        </Grid>
        <TextBlock Text="آپلود عکس" Foreground="White" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,2"/>
        <TextBlock Text="JPG یا PNG، حداکثر ۵ مگابایت" Foreground="#64748B" FontSize="10" HorizontalAlignment="Center" TextAlignment="Center"/>
    </StackPanel>
</UserControl>