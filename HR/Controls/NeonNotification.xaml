<UserControl x:Class="HR.Controls.NeonNotification"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft"
             Width="390"
             Height="92">

    <UserControl.Resources>

        <!-- ========================= -->
        <!-- ورود Notification -->
        <!-- ========================= -->

        <Storyboard x:Key="ShowAnimation">

            <DoubleAnimation
                Storyboard.TargetName="NotificationTransform"
                Storyboard.TargetProperty="X"
                From="-430"
                To="0"
                Duration="0:0:0.45">

                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>

            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="NotificationBorder"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.3"/>

        </Storyboard>


        <!-- ========================= -->
        <!-- خروج Notification -->
        <!-- ========================= -->

        <Storyboard x:Key="HideAnimation">

            <DoubleAnimation
                Storyboard.TargetName="NotificationTransform"
                Storyboard.TargetProperty="X"
                From="0"
                To="430"
                Duration="0:0:0.35">

                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>

            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="NotificationBorder"
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0"
                Duration="0:0:0.25"/>

        </Storyboard>

    </UserControl.Resources>


    <Grid>

        <Border x:Name="NotificationBorder"
                Background="#0B2235"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="#19384A"
                Opacity="0">

            <Border.RenderTransform>
                <TranslateTransform x:Name="NotificationTransform"/>
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect
                    Color="#000000"
                    BlurRadius="24"
                    ShadowDepth="4"
                    Opacity="0.45"/>
            </Border.Effect>


            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>


                <!-- ================================= -->
                <!-- Neon Accent -->
                <!-- ================================= -->

                <Border x:Name="AccentBar"
                        Grid.Column="0"
                        Background="#00E5D4"
                        CornerRadius="12,0,0,12"/>


                <!-- ================================= -->
                <!-- Icon -->
                <!-- ================================= -->

                <Grid Grid.Column="1"
                      Width="40"
                      Height="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <Ellipse x:Name="IconGlow"
                             Fill="#1500E5D4">

                        <Ellipse.Effect>
                            <DropShadowEffect
                                Color="#00E5D4"
                                BlurRadius="14"
                                ShadowDepth="0"
                                Opacity="0.8"/>
                        </Ellipse.Effect>

                    </Ellipse>

                    <materialDesign:PackIcon
                        x:Name="NotificationIcon"
                        Width="22"
                        Height="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#00E5D4"
                        Kind="CheckCircleOutline"/>

                </Grid>


                <!-- ================================= -->
                <!-- Text -->
                <!-- ================================= -->

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Margin="4,0,8,0">

                    <TextBlock
                        x:Name="TitleText"
                        Text="عملیات موفق"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#E8FFFC"
                        TextTrimming="CharacterEllipsis"/>

                    <TextBlock
                        x:Name="MessageText"
                        Text="عملیات با موفقیت انجام شد."
                        Margin="0,5,0,0"
                        FontSize="13"
                        Foreground="#8BA8B5"
                        TextWrapping="Wrap"
                        MaxHeight="38"/>

                </StackPanel>


                <!-- ================================= -->
                <!-- Close -->
                <!-- ================================= -->

                <Button
                    x:Name="CloseButton"
                    Grid.Column="3"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Click="CloseButton_Click"
                    ToolTip="بستن">

                    <materialDesign:PackIcon
                        Width="18"
                        Height="18"
                        Foreground="#718C99"
                        Kind="Close"/>

                </Button>


                <!-- ================================= -->
                <!-- Progress -->
                <!-- ================================= -->

                <Border
                    x:Name="ProgressContainer"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Height="2"
                    VerticalAlignment="Bottom"
                    Margin="12,0,12,7"
                    Background="#19384A"
                    CornerRadius="1">

                    <Border
                        x:Name="ProgressBar"
                        HorizontalAlignment="Left"
                        Width="0"
                        Background="#00E5D4"
                        CornerRadius="1"/>

                </Border>

            </Grid>

        </Border>

    </Grid>

</UserControl>