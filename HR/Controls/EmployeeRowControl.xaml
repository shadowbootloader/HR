<UserControl x:Class="HR.Controls.EmployeeRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:uc="clr-namespace:HR.Controls">
    <UserControl.Resources>
        <Style x:Key="LawnGreenNeonIcon"
TargetType="{x:Type materialDesign:PackIcon}">

            <Setter Property="Foreground"
     Value="LawnGreen"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
         Color="Yellow"
         BlurRadius="18"
         ShadowDepth="0"
         Opacity="0.9"/>
                </Setter.Value>
            </Setter>

        </Style>
    </UserControl.Resources>

    <Border x:Name="RowSurface" Background="Transparent" Padding="12,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1" MouseLeftButtonUp="RowSurface_MouseLeftButtonUp">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <!-- Avatar -->
                <ColumnDefinition Width="200"/>
                <!-- Name -->
                <ColumnDefinition Width="160"/>
                <!-- Position -->
                <ColumnDefinition Width="160"/>
                <!-- Department -->
                <ColumnDefinition Width="100"/>
                <!-- Status -->
                <ColumnDefinition Width="150"/>
                <!-- Performance -->
                <ColumnDefinition Width="120"/>
                <!-- Completeness -->
                <ColumnDefinition Width="180"/>
                <!-- Actions -->
            </Grid.ColumnDefinitions>

            <!-- Avatar: ImageBrush روی بیضی، چون EllipseGeometry در FlowDirection راست‌به‌چپ نیم‌دایره می‌شود -->
            <Grid Grid.Column="0" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight">
                <Ellipse Width="40" Height="40" Stroke="#3B82F6" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
                    </Ellipse.Fill>
                </Ellipse>
                <materialDesign:PackIcon x:Name="AvatarIcon" Kind="Account" Style="{StaticResource LawnGreenNeonIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="24" Height="24" />
            </Grid>

            <!-- Name + Email -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                <TextBlock Text="{Binding Email}" Foreground="#64748B" FontSize="11"/>
            </StackPanel>

            <!-- Position -->
            <TextBlock Grid.Column="2" Text="{Binding Position}" TextWrapping="Wrap" Margin="5,0" Foreground="#E2E8F0" 
                       VerticalAlignment="Center" FontSize="13"/>

            <!-- Department -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                <Grid Width="26" Height="26" Margin="0,0,8,0" FlowDirection="LeftToRight">
                <Border x:Name="DeptLogoBorder" CornerRadius="13" BorderBrush="#00E5D4" BorderThickness="1" Visibility="Collapsed">
                    <Border.Background>
                        <ImageBrush x:Name="DeptLogoBrush" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
                    </Border.Background>
                </Border>
                <Border x:Name="DeptMark" CornerRadius="6" Background="#1E3A5F">
                    <TextBlock Text="{Binding DepartmentIcon}" FontSize="11" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                </Grid>
                <TextBlock Text="{Binding Department}" Foreground="#E2E8F0" VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>

            <!-- Status -->
            <uc:StatusBadgeControl Grid.Column="4" Status="{Binding Status}" VerticalAlignment="Center" Margin="5,0"/>

            <!-- Performance -->
            <uc:PerformanceMiniGauge x:Name="Performancegauge" FlowDirection="LeftToRight" Value="{Binding PerformanceValue}"  Label="{Binding PerformanceLabel}" Grid.Column="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
            <uc:PerformanceMiniGauge Grid.Column="6" FlowDirection="LeftToRight" Value="{Binding CompletenessPercent}" Label="{Binding CompletenessLabel}" FixedFill="#A78BFA" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>

            <!-- Actions -->
            <TextBlock x:Name="ChooseHint" Grid.Column="7" Text="انتخاب" Foreground="#93C5FD" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            <StackPanel x:Name="ActionsPanel" Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="ViewBtn" Click="ViewBtn_Click" materialDesign:ButtonAssist.CornerRadius="8" Content="👁" ToolTip="مشاهده" Width="35" Padding="0" Background="#222C3C" BorderBrush="#FF354256" BorderThickness="1.5" Foreground="White" Margin="0,0,5,0"/>
                <!--<Button x:Name="LeaveBtn" Click="LeaveBtn_Click" materialDesign:ButtonAssist.CornerRadius="8" Content="مرخصی" ToolTip="ثبت یا پایان مرخصی" Height="32" Padding="8,0" Background="#1E3A5F" BorderBrush="#1D4ED8" BorderThickness="1.5" Foreground="White" Margin="0,0,5,0"/>-->
                <Button x:Name="EditBtn" Click="EditBtn_Click" materialDesign:ButtonAssist.CornerRadius="8" Content="✎" ToolTip="ویرایش" Width="35" Padding="0" Background="#222C3C" BorderBrush="#FF354256" BorderThickness="1.5" Foreground="White" Margin="0,0,5,0"/>
                <Button x:Name="DeleteBtn" Click="DeleteBtn_Click" materialDesign:ButtonAssist.CornerRadius="8" Content="🗑" ToolTip="حذف" Width="35" Padding="0" Background="#3C2222" BorderBrush="#563535" BorderThickness="1.5" Foreground="White"/>
                <Button x:Name="RestoreBtn" Click="RestoreBtn_Click" Visibility="Collapsed" materialDesign:ButtonAssist.CornerRadius="8" Content="↩" ToolTip="بازگردانی" Width="35" Padding="0" Background="#14532D" BorderBrush="#166534" BorderThickness="1.5" Foreground="White" Margin="5,0,0,0"/>
                <Button x:Name="HardDeleteBtn" Click="HardDeleteBtn_Click" Visibility="Collapsed" materialDesign:ButtonAssist.CornerRadius="8" Content="✕" ToolTip="حذف دائمی" Width="35" Padding="0" Background="#7F1D1D" BorderBrush="#991B1B" BorderThickness="1.5" Foreground="White" Margin="5,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>