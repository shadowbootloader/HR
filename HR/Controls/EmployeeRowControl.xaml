<UserControl x:Class="HR.Controls.EmployeeRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:uc="clr-namespace:HR.Controls">
    <UserControl.Resources>
        <Style x:Key="LawnGreenNeonIcon"
TargetType="{x:Type materialDesign:PackIcon}">

            <Setter Property="Foreground"
     Value="LawnGreen"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
         Color="Yellow"
         BlurRadius="18"
         ShadowDepth="0"
         Opacity="0.9"/>
                </Setter.Value>
            </Setter>

        </Style>
    </UserControl.Resources>

    <Border Background="Transparent" Padding="12,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <!-- Avatar -->
                <ColumnDefinition Width="200"/>
                <!-- Name -->
                <ColumnDefinition Width="160"/>
                <!-- Position -->
                <ColumnDefinition Width="160"/>
                <!-- Department -->
                <ColumnDefinition Width="100"/>
                <!-- Status -->
                <ColumnDefinition Width="150"/>
                <!-- Performance -->
                <ColumnDefinition Width="250"/>
                <!-- Actions -->
            </Grid.ColumnDefinitions>

            <!-- Avatar -->
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" BorderBrush="#3B82F6" BorderThickness="2" ClipToBounds="True">
                <Grid>
                    <materialDesign:PackIcon x:Name="AvatarIcon" Kind="Account" Style="{StaticResource LawnGreenNeonIcon}" HorizontalAlignment="Center" Width="28" Height="28" />
                    <Image x:Name="AvatarImage" Width="40" Height="40" Stretch="UniformToFill" Visibility="Collapsed">
                        <Image.Clip>
                            <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                        </Image.Clip>
                    </Image>
                </Grid>
            </Border>

            <!-- Name + Email -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                <TextBlock Text="{Binding Email}" Foreground="#64748B" FontSize="11"/>
            </StackPanel>

            <!-- Position -->
            <TextBlock Grid.Column="2" Text="{Binding Position}" TextWrapping="Wrap" Margin="5,0" Foreground="#E2E8F0" 
                       VerticalAlignment="Center" FontSize="13"/>

            <!-- Department -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                <Border Width="24" Height="24" CornerRadius="6" Background="#1E3A5F" Margin="0,0,8,0">
                    <TextBlock Text="{Binding DepartmentIcon}" FontSize="11" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Department}" Foreground="#E2E8F0" VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>

            <!-- Status -->
            <uc:StatusBadgeControl Grid.Column="4" Status="{Binding Status}" VerticalAlignment="Center" Margin="5,0"/>

            <!-- Performance -->
            <uc:PerformanceMiniGauge x:Name="Performancegauge" FlowDirection="LeftToRight" Value="{Binding PerformanceValue}"  Label="{Binding PerformanceLabel}" Grid.Column="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>

            <!-- Actions -->
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="ViewBtn" Click="ViewBtn_Click" materialDesign:ButtonAssist.CornerRadius="8" Content="👁" ToolTip="مشاهده" Width="35" Padding="0" Background="#222C3C" BorderBrush="#FF354256" BorderThickness="1.5" Foreground="White" Margin="0,0,5,0"/>
                <!--<Button x:Name="LeaveBtn" Click="LeaveBtn_Click" materialDesign:ButtonAssist.CornerRadius="8" Content="مرخصی" ToolTip="ثبت یا پایان مرخصی" Height="32" Padding="8,0" Background="#1E3A5F" BorderBrush="#1D4ED8" BorderThickness="1.5" Foreground="White" Margin="0,0,5,0"/>-->
                <Button x:Name="EditBtn" Click="EditBtn_Click" materialDesign:ButtonAssist.CornerRadius="8" Content="✎" ToolTip="ویرایش" Width="35" Padding="0" Background="#222C3C" BorderBrush="#FF354256" BorderThickness="1.5" Foreground="White" Margin="0,0,5,0"/>
                <Button x:Name="DeleteBtn" Click="DeleteBtn_Click" materialDesign:ButtonAssist.CornerRadius="8" Content="🗑" ToolTip="حذف" Width="35" Padding="0" Background="#3C2222" BorderBrush="#563535" BorderThickness="1.5" Foreground="White"/>
                <Button x:Name="RestoreBtn" Click="RestoreBtn_Click" Visibility="Collapsed" materialDesign:ButtonAssist.CornerRadius="8" Content="↩" ToolTip="بازگردانی" Width="35" Padding="0" Background="#14532D" BorderBrush="#166534" BorderThickness="1.5" Foreground="White" Margin="5,0,0,0"/>
                <Button x:Name="HardDeleteBtn" Click="HardDeleteBtn_Click" Visibility="Collapsed" materialDesign:ButtonAssist.CornerRadius="8" Content="✕" ToolTip="حذف دائمی" Width="35" Padding="0" Background="#7F1D1D" BorderBrush="#991B1B" BorderThickness="1.5" Foreground="White" Margin="5,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>