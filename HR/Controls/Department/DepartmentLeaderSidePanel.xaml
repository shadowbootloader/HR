<UserControl x:Class="HR.Controls.Department.DepartmentLeaderSidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="RoundProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <!-- اجباری: Track -->
                            <Border x:Name="PART_Track"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            ClipToBounds="True"/>

                            <!-- اجباری: Indicator -->
                            <Border x:Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            CornerRadius="4"
                            Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Border Background="#0F172A" CornerRadius="14" Padding="10,4"
        BorderBrush="#FF005689" BorderThickness="1" Margin="0,0,0,5">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountSupervisorCircleOutline"
                 Width="30" Height="30"
                 Foreground="#22D3EE" />
                    <TextBlock Text="مدیریت دپارتمان" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,12"/>

                </StackPanel>
                <Line Margin="0,0,0,8"
                        Stretch="Fill"
                        X1="0" Y1="0"
                        X2="1" Y2="0"
                        StrokeThickness="1" Stroke="#FF005689"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"/>
                <!-- مدیر -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <!-- حلقه دور عکس -->
                    <Grid Width="64" Height="64" Margin="0,0,12,0">
                        <Ellipse Stroke="#22D3EE" StrokeThickness="2" Fill="Transparent"/>
                        <Ellipse Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="ManagerBrush" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- اگر عکس نبود -->
                        <materialDesign:PackIcon Kind="Account"
                                         Width="28" Height="28"
                                         Foreground="#64748B"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ManagerNameText" Text="سارا احمدی"
                           Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="مدیر دپارتمان" Foreground="#22D3EE" FontSize="14" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- جانشین + تنخواه‌دار کنار هم -->
                <Border BorderThickness="1" BorderBrush="#FF005689" CornerRadius="5" Padding="10,0" >
                    <UniformGrid Rows="2">

                        <!-- جانشین -->
                        <StackPanel Margin="0,5,6,5">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="48" Height="48" Margin="0,0,8,0">
                                    <Ellipse Stroke="#A78BFA" StrokeThickness="2" Fill="Transparent"/>
                                    <Ellipse Width="42" Height="42"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="DeputyBrush" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <materialDesign:PackIcon Kind="Account" Width="20" Height="20"
                                 Foreground="#64748B"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DeputyNameText" Text="مهدی کاظمی"
                   Foreground="#E2E8F0" FontSize="16"/>
                                    <TextBlock Text="جانشین مدیر" Foreground="#94A3B8" FontSize="14"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- تنخواه‌دار -->
                        <StackPanel Margin="0,5,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="48" Height="48" Margin="0,0,8,0">
                                    <Ellipse Stroke="#34D399" StrokeThickness="2" Fill="Transparent"/>
                                    <Ellipse Width="42" Height="42"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="PettyCashBrush" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <materialDesign:PackIcon Kind="Account" Width="20" Height="20"
                                 Foreground="#64748B"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="PettyCashNameText" Text="رضا کریمی"
                   Foreground="#E2E8F0" FontSize="16"/>
                                    <TextBlock Text="تنخواه‌دار" Foreground="#94A3B8" FontSize="14"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                    </UniformGrid>
                </Border>
                
            </StackPanel>
        </Border>
        <!-- شاخص‌های رهبری -->
        <!-- ========== شاخص‌های رهبری ========== -->
        <Border Background="#0F172A"
        BorderBrush="#FF005689"
        BorderThickness="1"
        CornerRadius="14"
        Padding="10,8"
        Margin="0,0,0,5">

            <StackPanel>
                <!-- عنوان -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <materialDesign:PackIcon Kind="AccountGroupOutline"
                                     Width="30" Height="30"
                                     Foreground="#22D3EE"
                                     VerticalAlignment="Center"/>
                    <TextBlock Text="شاخص‌های رهبری"
                       Foreground="White"
                       FontSize="16" FontWeight="SemiBold"
                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Line Margin="0,0,0,8"
                        Stretch="Fill"
                        X1="0" Y1="0"
                        X2="1" Y2="0"
                        StrokeThickness="1" Stroke="#FF005689"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"/>
                <!-- ۱: عملکرد و رهبری -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="عملکرد و رهبری دپارتمان"
                       Foreground="#E2E8F0" FontSize="15" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="2" Text="برنامه‌ریزی استراتژیک"
                       Foreground="#64748B" FontSize="13" Margin="0,0,0,0"/>

                    <ProgressBar Grid.Row="1"  Height="8" Minimum="0" Maximum="100" Style="{StaticResource RoundProgressBar}"
                         Value="{Binding LeadershipScore, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         BorderThickness="0" Background="#1E293B">
                        <ProgressBar.Foreground>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#22D3EE" Offset="0"/>
                                <GradientStop Color="#3B82F6" Offset="1"/>
                            </LinearGradientBrush>
                        </ProgressBar.Foreground>
                    </ProgressBar>
                    <Line Margin="0,3,0,0" Grid.Row="3" Grid.ColumnSpan="2"
                                Stretch="Fill"
                                X1="0" Y1="0"
                                X2="1" Y2="0"
                                StrokeThickness="1" Stroke="#FF005689"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"/>

                    <StackPanel Grid.Column="1" Grid.RowSpan="3"
                        Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding LeadershipScore, ElementName=Root, StringFormat={}{0:0}%}"
                           Foreground="#E2E8F0" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Width="43" Height="43" CornerRadius="25"
                        BorderBrush="#FF005689" BorderThickness="1.5" Background="Transparent">
                            <materialDesign:PackIcon Kind="BullseyeArrow" Width="30" Height="30"
                                             Foreground="#22D3EE"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ۲: رضایت کارکنان -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="رضایت کارکنان" Foreground="#E2E8F0" FontSize="15" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="2" Text="تعامل و ارتباطات"
                       Foreground="#64748B" FontSize="13" Margin="0,1,0,2"/>

                    <ProgressBar Grid.Row="1" Height="8" Minimum="0" Maximum="100" Style="{StaticResource RoundProgressBar}"
                         Value="{Binding SatisfactionScore, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         BorderThickness="0" Background="#1E293B">
                        <ProgressBar.Foreground>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#22D3EE" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </ProgressBar.Foreground>
                    </ProgressBar>
                    <Line Margin="0,3,0,0" Grid.Row="3" Grid.ColumnSpan="2"
            Stretch="Fill"
            X1="0" Y1="0"
            X2="1" Y2="0"
            StrokeThickness="1" Stroke="#FF005689"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"/>
                    <StackPanel Grid.Column="1" Grid.RowSpan="3"
                        Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding SatisfactionScore, ElementName=Root, StringFormat={}{0:0}%}"
                           Foreground="#E2E8F0" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Width="43" Height="43" CornerRadius="25"
                        BorderBrush="#FF005689" BorderThickness="1.5" Background="Transparent">
                            <materialDesign:PackIcon Kind="AccountGroupOutline" Width="30" Height="30"
                                             Foreground="#22D3EE"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ۳: رشد و توسعه -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="رشد و توسعه" Foreground="#E2E8F0" FontSize="15" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="2" Text="توسعه سرمایه انسانی"
                       Foreground="#64748B" FontSize="13" Margin="0,1,0,2"/>

                    <ProgressBar Grid.Row="1" Height="8" Minimum="0" Maximum="100" Style="{StaticResource RoundProgressBar}"
                         Value="{Binding GrowthScore, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         BorderThickness="0" Background="#1E293B">
                        <ProgressBar.Foreground>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#22D3EE" Offset="0"/>
                                <GradientStop Color="#6366F1" Offset="1"/>
                            </LinearGradientBrush>
                        </ProgressBar.Foreground>
                    </ProgressBar>
                    
                    <StackPanel Grid.Column="1" Grid.RowSpan="3"
                        Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding GrowthScore, ElementName=Root, StringFormat={}{0:0}%}"
                           Foreground="#E2E8F0" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Width="43" Height="43" CornerRadius="25"
                        BorderBrush="#FF005689" BorderThickness="1.5" Background="Transparent">
                            <materialDesign:PackIcon Kind="Finance" Width="30" Height="30"
                                             Foreground="#22D3EE"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        <!-- ========== فعالیت‌ها و رویدادهای اخیر ========== -->
        <Border Background="#0F172A"
        BorderBrush="#FF005689"
        BorderThickness="1"
        CornerRadius="14"
        Padding="14">

            <DockPanel>
                <!-- هدر -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <materialDesign:PackIcon Kind="CalendarClock"
                                         Width="30" Height="30"
                                         Foreground="#22D3EE"
                                         VerticalAlignment="Center"/>
                        <TextBlock Text="فعالیت‌ها و رویدادهای اخیر"
                           Foreground="White"
                           FontSize="16" FontWeight="SemiBold"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right"
                       Text="مشاهده همه"
                       Foreground="#22D3EE"
                       FontSize="12" HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Cursor="Hand"/>
                </DockPanel>
                <Line Margin="0,0,0,5" DockPanel.Dock="Top"
        Stretch="Fill"
        X1="0" Y1="0"
        X2="1" Y2="0"
        StrokeThickness="1" Stroke="#FF005689"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"/>

                <!-- لیست -->
                <ItemsControl x:Name="ActivityItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- آیکون دایره‌ای -->
                                <Border Width="36" Height="36"
                                CornerRadius="18"
                                BorderBrush="#1E3A5F"
                                BorderThickness="1.5"
                                Background="Transparent"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                     Width="18" Height="18"
                                                     Foreground="#38BDF8"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                </Border>

                                <!-- عنوان + توضیح -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                       Foreground="White"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}"
                                       Foreground="#64748B"
                                       FontSize="11"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- تاریخ و ساعت -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Date}"
                                       Foreground="#94A3B8"
                                       FontSize="11"
                                       HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding Time}"
                                       Foreground="#64748B"
                                       FontSize="11"
                                       HorizontalAlignment="Left"
                                       Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>