<UserControl x:Class="HR.Controls.Department.DeptAchievementsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:conv="clr-namespace:HR.Services">
    <UserControl.Resources>
        <conv:IsLastItemToVisibilityConverter x:Key="IsLastItemToVisibility"/>

    </UserControl.Resources>
    <Border Background="#0F172A" CornerRadius="14" Padding="8"
            BorderBrush="#FF005689" BorderThickness="1" Margin="0,0,0,5">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5" FlowDirection="RightToLeft">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="TrophyOutline" Width="30" Height="30"
                                             Foreground="#FF08FEFF" VerticalAlignment="Center"/>
                    <TextBlock Text="دستاوردهای دپارتمان" Foreground="White"
                               FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="مشاهده همه ›" HorizontalAlignment="Right"
                           Foreground="#22D3EE" FontSize="12" VerticalAlignment="Center" Cursor="Hand"/>

            </DockPanel>
            <Line Margin="0,0,0,5" DockPanel.Dock="Top"
Stretch="Fill"
X1="0" Y1="0"
X2="1" Y2="0"
StrokeThickness="1" Stroke="#FF005689"
HorizontalAlignment="Stretch"
VerticalAlignment="Top">

            </Line>
            <ItemsControl x:Name="Items">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="#0F172A"  Margin="0,0,0,8" >
                            <Grid.RowDefinitions>
                                <RowDefinition>
                                    
                                </RowDefinition>
                                <RowDefinition>
                                    
                                </RowDefinition>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <materialDesign:PackIcon DockPanel.Dock="Right"
                                                         Kind="{Binding IconKind}"
                                                         Width="20" Height="20"
                                                         Foreground="{Binding AccentBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="10,0,0,0"/>
                                <StackPanel DockPanel.Dock="Right">
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding SubTitle}" Foreground="#FF73859E" FontSize="12" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Date}" DockPanel.Dock="Left" Foreground="#64748B" FontSize="14" Margin="0,2,0,0"/>
                                

                            </DockPanel>
                            <Line Margin="0,0,0,5" Grid.Row="1" 
        Stretch="Fill"
        X1="0" Y1="0"
        X2="1" Y2="0"
        StrokeThickness="1" Stroke="#FF005689"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Bottom">
                                <Line.Visibility>
                                    <MultiBinding Converter="{StaticResource IsLastItemToVisibility}">
                                        <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                        <Binding/>
                                    </MultiBinding>
                                </Line.Visibility>
                            </Line>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>