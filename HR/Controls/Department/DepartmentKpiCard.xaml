<UserControl x:Class="HR.Controls.Department.DepartmentKpiCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root"
             MinWidth="150" MinHeight="100">

    <Border Background="#0F172A"
            BorderBrush="#FF005689"
            BorderThickness="1"
            CornerRadius="14"
            Padding="10,12"
            Margin="2,0">

        <StackPanel>
            <DockPanel Margin="0,0,0,10" LastChildFill="True" FlowDirection="RightToLeft">

                <!-- فقط بوردر رنگی + نئون -->
                <Border x:Name="IconBorder"
                        DockPanel.Dock="Right"
                        Width="45" Height="45"
                        CornerRadius="10"
                        Background="Transparent"
                        BorderBrush="{Binding Accent, ElementName=Root}"
                        BorderThickness="1.5">
                    <materialDesign:PackIcon x:Name="IconControl"
                                             Kind="{Binding IconKind, ElementName=Root}"
                                             Width="28" Height="28"
                                             Foreground="{Binding Accent, ElementName=Root}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="{Binding Title, ElementName=Root}"
                           Foreground="#94A3B8"
                           FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </DockPanel>

            <TextBlock Text="{Binding ValueText, ElementName=Root}"
                       FlowDirection="RightToLeft"
                       Foreground="White" HorizontalAlignment="Center"
                       FontSize="24" FontWeight="Bold"
                       Margin="0,0,0,4"/>

            <TextBlock Text="{Binding SubText, ElementName=Root}"
                       Foreground="{Binding Accent, ElementName=Root}"
                       FontSize="16"
                       FlowDirection="RightToLeft"/>
        </StackPanel>
    </Border>
</UserControl>