                                BorderBrush="#FBBF24" BorderThickness="1.2" Background="Transparent"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ClockOutline" Width="16" Height="16"
                                                     Foreground="#FBBF24"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </DockPanel>
                </Border>

                <Border Background="#111827" CornerRadius="12" Padding="12" Margin="6,0,0,0"
                        BorderBrush="#FF005689" BorderThickness="1">
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="منقضی شده" Foreground="#94A3B8" FontSize="11"/>
                            <TextBlock Text="{Binding ExpiredCount, ElementName=Root}"
                                       Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16"
                                BorderBrush="#F87171" BorderThickness="1.2" Background="Transparent"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AlertOutline" Width="16" Height="16"
                                                     Foreground="#F87171"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
