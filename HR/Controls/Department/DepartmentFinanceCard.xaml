<UserControl x:Class="HR.Controls.Department.DepartmentFinanceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             x:Name="Root">

    <Border Background="#0F172A"
            BorderBrush="#FF005689"
            BorderThickness="1"
            CornerRadius="14"
            Padding="10">

        <DockPanel>
            <!-- هدر -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5" FlowDirection="RightToLeft">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="WalletOutline"
                         Width="30" Height="30"
                         Foreground="#22D3EE"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
                    <TextBlock Text="خلاصه مالی و بودجه"
                               Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="5,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" Text="مشاهده جزئیات"
                           Foreground="#22D3EE" FontSize="14" DockPanel.Dock="Right"
                           VerticalAlignment="Center" Cursor="Hand"/>
            </DockPanel>
            <Line Margin="0,0,0,8"
        Stretch="Fill" DockPanel.Dock="Top"
        X1="0" Y1="0"
        X2="1" Y2="0"
        StrokeThickness="1" Stroke="#FF005689"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Bottom"/>
            <Grid FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- دونات درصد مصرف -->
                <Grid Width="120" Height="120">
                    <lvc:PieChart Series="{Binding Series, ElementName=Root}"
                                  InitialRotation="-90"
                                  FlowDirection="LeftToRight"
                                  MaxAngle="360"
                                  LegendPosition="Hidden"
                                  TooltipPosition="Hidden"
                                  AnimationsSpeed="0:0:0.35"
                                  Background="Transparent"/>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock Text="{Binding UsedPercent, ElementName=Root, StringFormat={}{0:0}%}"
                                   Foreground="White" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="مصرف بودجه"
                                   Foreground="#64748B" FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- سه ردیف مبلغ -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">

                    <!-- بودجه کل -->
                    <Border Background="Transparent" CornerRadius="10" Padding="6,5" Margin="0,0,0,8"
                            BorderBrush="#FF005689" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" Panel.ZIndex="0" DockPanel.Dock="Top">
                                <materialDesign:PackIcon Panel.ZIndex="1"  Kind="WalletOutline" Width="28" Height="28"
                                                Foreground="#22D3EE"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock VerticalAlignment="Center" Text="بودجه کل" Foreground="#94A3B8" FontSize="14" Margin="5,0,0,0"/>
                                
                                
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding BudgetText, ElementName=Root}"
               Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text=" ریال" Foreground="#64748B" FontSize="12"
               VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                            </StackPanel>

                        </DockPanel>
                    </Border>

                    <!-- مبلغ مصرف‌شده -->
                    <Border Background="Transparent" CornerRadius="10" Padding="6,5" Margin="0,0,0,8"
                            BorderBrush="#FF005689" BorderThickness="1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" Background="Transparent" DockPanel.Dock="Top">
                                <materialDesign:PackIcon Kind="DatabaseOutline" Width="28" Height="28"
                                        Foreground="#A78BFA"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Text="مبلغ مصرف شده" VerticalAlignment="Center" Background="Transparent" Foreground="#94A3B8" FontSize="14"/>
                                
                                
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,4,0,0">
                                <TextBlock Background="Transparent" Text="{Binding SpentText, ElementName=Root}"
                                        Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Background="Transparent" Text=" ریال" Foreground="#64748B" FontSize="12"
                                        VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- مانده بودجه -->
                    <Border Background="Transparent" CornerRadius="10" Padding="6,5"
                            BorderBrush="#FF005689" BorderThickness="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cash" Width="28" Height="28"
                                        Foreground="#34D399"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Text="مانده بودجه" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="14"/>
                                
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Top"  Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding RemainingText, ElementName=Root}"
                                        Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text=" ریال" Foreground="#64748B" FontSize="12"
                                        VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>