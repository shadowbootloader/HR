<UserControl x:Class="HR.Controls.Department.DepartmentRisksCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:HR.Services"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <conv:IsLastItemToVisibilityConverter x:Key="IsLastItemToVisibility"/>
        <Style x:Key="LightSeaGreenNeonIcon"
                TargetType="{x:Type materialDesign:PackIcon}">

            <Setter Property="Foreground"
        Value="Lime"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
            Color="Lime"
            BlurRadius="18"
            ShadowDepth="0"
            Opacity="0.9"/>
                </Setter.Value>
            </Setter>

        </Style>
        <Style x:Key="LightSeaGreenNeonText"
TargetType="{x:Type TextBlock}">

            <Setter Property="Foreground"
     Value="Lime"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
         Color="Lime"
         BlurRadius="18"
         ShadowDepth="0"
         Opacity="0.9"/>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="RedNeonIcon"
   TargetType="{x:Type materialDesign:PackIcon}">

            <Setter Property="Foreground"
        Value="Red"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
            Color="Yellow"
            BlurRadius="18"
            ShadowDepth="0"
            Opacity="0.9"/>
                </Setter.Value>
            </Setter>

        </Style>
        <Style x:Key="RedNeonText"
                TargetType="{x:Type TextBlock}">

            <Setter Property="Foreground"
                    Value="Red"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
         Color="Yellow"
         BlurRadius="18"
         ShadowDepth="0"
         Opacity="0.9"/>
                </Setter.Value>
            </Setter>

        </Style>
        <Style x:Key="YellowNeonIcon"
TargetType="{x:Type materialDesign:PackIcon}">

            <Setter Property="Foreground"
     Value="Orange"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
         Color="Yellow"
         BlurRadius="18"
         ShadowDepth="0"
         Opacity="0.9"/>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="YellowNeonText"
TargetType="{x:Type TextBlock}">

            <Setter Property="Foreground"
     Value="Orange"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
         Color="Yellow"
         BlurRadius="18"
         ShadowDepth="0"
         Opacity="0.9"/>
                </Setter.Value>
            </Setter>

        </Style>
        <Style x:Key="BlueNeonText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#22D3EE"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#22D3EE"
                              BlurRadius="16"
                              ShadowDepth="0"
                              Opacity="0.85"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="#0F172A"
            BorderBrush="#FF005689"
            BorderThickness="1"
            CornerRadius="14"
            Padding="8" Margin="0,0,0,5">

        <DockPanel>
            <!-- هدر -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5" FlowDirection="RightToLeft">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertOutline"
                                             Width="30" Height="30"
                                             Foreground="Red"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="ریسک‌ها و چالش‌های دپارتمان"
                               Foreground="White"
                               FontSize="16" FontWeight="SemiBold"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="مشاهده همه"
                           Foreground="#22D3EE"
                           FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           Cursor="Hand"/>
            </DockPanel>
            <Line Margin="0,0,0,5" DockPanel.Dock="Top"
        Stretch="Fill"
        X1="0" Y1="0"
        X2="1" Y2="0"
        StrokeThickness="1" Stroke="#FF005689"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Bottom">
                
            </Line>
            <!-- هدر ستون‌ها -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,5" FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="عنوان ریسک / چالش" Foreground="White" HorizontalAlignment="Center" FontSize="14"/>
                <TextBlock Grid.Column="1" Text="شدت" Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="مسئول" Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
            </Grid>
            <Line Margin="0,0,0,5" DockPanel.Dock="Top"
Stretch="Fill"
X1="0" Y1="0"
X2="1" Y2="0"
StrokeThickness="1" Stroke="#FF005689"
HorizontalAlignment="Stretch"
VerticalAlignment="Bottom"/>
            <!-- ردیف‌ها -->
            <ItemsControl x:Name="Items" FlowDirection="RightToLeft">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <!-- عنوان -->
                            <TextBlock Text="{Binding Title}" 
                                       Foreground="#E2E8F0"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>

                            <!-- شدت -->
                            <StackPanel Grid.Column="1" Loaded="StackPanel_Loaded"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Circle" Style="{StaticResource LightSeaGreenNeonIcon}" Width="10"  Height="10" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                <TextBlock Text="{Binding Severity}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- مسئول -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Owner}" HorizontalAlignment="Center"
                                           Foreground="#E2E8F0"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding OwnerRole}"
                                           Foreground="#64748B" HorizontalAlignment="Center"
                                           FontSize="12"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Line Margin="0,0,0,5" Grid.Row="1" Grid.ColumnSpan="3"
                                    Stretch="Fill"
                                    X1="0" Y1="0"
                                    X2="1" Y2="0"
                                    StrokeThickness="1" Stroke="#FF005689"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Bottom">
                                <Line.Visibility>
                                    <MultiBinding Converter="{StaticResource IsLastItemToVisibility}">
                                        <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                        <Binding/>
                                    </MultiBinding>
                                </Line.Visibility>
                            </Line>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>