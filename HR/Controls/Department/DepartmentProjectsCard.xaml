<UserControl x:Class="HR.Controls.Department.DepartmentProjectsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:HR.Services">

    <UserControl.Resources>
        <conv:IsLastItemToVisibilityConverter x:Key="IsLastItemToVisibility"/>
        <Style x:Key="LightSeaGreenNeonIcon"
                TargetType="{x:Type materialDesign:PackIcon}">

            <Setter Property="Foreground"
        Value="Lime"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
            Color="Lime"
            BlurRadius="18"
            ShadowDepth="0"
            Opacity="0.9"/>
                </Setter.Value>
            </Setter>

        </Style>
        <Style x:Key="LightSeaGreenNeonText"
TargetType="{x:Type TextBlock}">

            <Setter Property="Foreground"
     Value="Lime"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
         Color="Lime"
         BlurRadius="18"
         ShadowDepth="0"
         Opacity="0.9"/>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="RedNeonIcon"
   TargetType="{x:Type materialDesign:PackIcon}">

            <Setter Property="Foreground"
        Value="Red"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
            Color="Yellow"
            BlurRadius="18"
            ShadowDepth="0"
            Opacity="0.9"/>
                </Setter.Value>
            </Setter>

        </Style>
        <Style x:Key="RedNeonText"
                TargetType="{x:Type TextBlock}">

            <Setter Property="Foreground"
                    Value="Red"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
         Color="Yellow"
         BlurRadius="18"
         ShadowDepth="0"
         Opacity="0.9"/>
                </Setter.Value>
            </Setter>

        </Style>
        <Style x:Key="PurpleNeonIcon"
TargetType="{x:Type materialDesign:PackIcon}">

            <Setter Property="Foreground"
     Value="#FFA78BFA"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
         Color="#FFA78BFA"
         BlurRadius="18"
         ShadowDepth="0"
         Opacity="0.9"/>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="PurpleNeonText"
TargetType="{x:Type TextBlock}">

            <Setter Property="Foreground"
     Value="#FFA78BFA"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
         Color="#FFA78BFA"
         BlurRadius="18"
         ShadowDepth="0"
         Opacity="0.9"/>
                </Setter.Value>
            </Setter>

        </Style>
        <Style x:Key="BlueNeonIcon" TargetType="{x:Type materialDesign:PackIcon}">
            <Setter Property="Foreground" Value="#22D3EE"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#22D3EE"
                              BlurRadius="16"
                              ShadowDepth="0"
                              Opacity="0.85"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlueNeonText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#22D3EE"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#22D3EE"
                              BlurRadius="16"
                              ShadowDepth="0"
                              Opacity="0.85"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="4"
                                    Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#0F172A"
            BorderBrush="#FF005689"
            BorderThickness="1"
            CornerRadius="14"
            Padding="8,5">

        <DockPanel>
            <!-- هدر -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5" FlowDirection="RightToLeft">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="ProjectorScreenOutline"
                         Width="30" Height="30"
                         Foreground="#22D3EE"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
                    <TextBlock Text="وضعیت پروژه‌های دپارتمان"  Margin="10,0,0,0"
                               Foreground="White" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="مشاهده همه ›"
                           Foreground="#22D3EE" FontSize="12" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Cursor="Hand"/>
            </DockPanel>
            <Line Margin="0,0,0,5" DockPanel.Dock="Top"
                    Stretch="Fill"
                    X1="0" Y1="0"
                    X2="1" Y2="0"
                    StrokeThickness="1" Stroke="#FF005689"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"/>
            <!-- هدر ستون‌ها -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10" FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="نام پروژه" Foreground="#FF878E9A" FontSize="14" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="وضعیت" Foreground="#FF878E9A" FontSize="14" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="پیشرفت" Foreground="#FF878E9A" FontSize="14" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="تاریخ اتمام" Foreground="#FF878E9A" FontSize="14" HorizontalAlignment="Right" Margin="0,0,10,0"
                          />
            </Grid>

            <Rectangle DockPanel.Dock="Top" Height="1" Fill="#1E293B" Margin="0,0,0,8"/>

            <!-- ردیف‌ها -->
            <ItemsControl x:Name="Items" FlowDirection="RightToLeft">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MinWidth="130" />
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <!-- نام -->
                            <TextBlock Text="{Binding Name}" Foreground="#E2E8F0"
                                       FontSize="13" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- وضعیت -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Loaded="StackPanel_Loaded" Margin="0,0,0,0"
                                        VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Circle"
                                        Width="10" Height="10"
                                        Style="{StaticResource LightSeaGreenNeonIcon}"
                                        VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Status}"
                                           
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- پیشرفت -->
                            <Grid Grid.Column="2" VerticalAlignment="Center" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Style="{StaticResource RoundProgressBar}"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding Progress}" Grid.Column="1"
                                             FlowDirection="RightToLeft"
                                             Foreground="{Binding ProgressBrush}"/>
                                
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Progress, StringFormat={}{0}%}"
                                           Foreground="{Binding ProgressBrush}"
                                           FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- تاریخ -->
                            <TextBlock Grid.Column="3" Text="{Binding DueDate}"
                                       Foreground="#94A3B8" FontSize="14" Margin="0,0,10,0"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>

                            <!-- خط جداکننده (آخرین مخفی) -->
                            <Rectangle Grid.Row="1" Grid.ColumnSpan="4"
                                       Height="1" Fill="#1E293B" Margin="0,10,0,6">
                                <Rectangle.Visibility>
                                    <MultiBinding Converter="{StaticResource IsLastItemToVisibility}">
                                        <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                        <Binding/>
                                    </MultiBinding>
                                </Rectangle.Visibility>
                            </Rectangle>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>