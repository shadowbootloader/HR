<UserControl x:Class="HR.Controls.AchievementsFeedbackCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft"
             FontFamily="pack://application:,,,/Fonts/#B Nazanin"
             >

    <Border Background="#0F172A"
            CornerRadius="16"
            Padding="10"
            BorderBrush="#2A3548"
            BorderThickness="1">

        <StackPanel>
            <DockPanel  Margin="7,0,7,10">
                <materialDesign:PackIcon Kind="StarFourPoints" DockPanel.Dock="Left"   Foreground="#4FC3F7" VerticalAlignment="Center" Margin="0,3,8,0"/>
                <TextBlock DockPanel.Dock="Left" Text="دستاوردها"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="مشاهده بیشتر  ›"
Foreground="#4FC3F7"
FontFamily="pack://application:,,,/Fonts/#B Nazanin"
FontSize="14"
Margin="0,5,18,0"
Cursor="Hand"
HorizontalAlignment="Right" />
            </DockPanel>

            <StackPanel x:Name="ItemsPanel"/>
        </StackPanel>
    </Border>
</UserControl>