<UserControl x:Class="HR.Controls.SummaryCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <Border Background="#0F172A"
            CornerRadius="14"
            Padding="18"
            BorderBrush="#FF005689"
            BorderThickness="1">
        <StackPanel>
            <DockPanel LastChildFill="True" Margin="0,0,0,0">

                <!-- محل آیکون / انیمیشن -->
                <Border DockPanel.Dock="Left" Width="70" Height="70"
                        CornerRadius="10"
                        Background="{Binding IconBackground, ElementName=Root}"
                        Margin="0,0,10,0"
                        ClipToBounds="True">

                    <!-- این خط مهم است -->
                    <ContentPresenter Margin="10" Content="{Binding IconContent, ElementName=Root}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>

                <TextBlock DockPanel.Dock="Right" Text="{Binding Title, ElementName=Root}"
                           FontSize="20"
                           Foreground="White"
                           FontWeight="Bold" Margin="10,0,10,0"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="{Binding Value, ElementName=Root}"
                       FontSize="35"
                       FontWeight="Bold"
                       VerticalAlignment="Top"
                       Foreground="White" HorizontalAlignment="Center" Margin="10,0,0,0"/>

            <TextBlock Text="{Binding SubText, ElementName=Root}"
                       FontSize="18"
                       Foreground="{Binding SubTextColor, ElementName=Root}"
                       Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</UserControl>